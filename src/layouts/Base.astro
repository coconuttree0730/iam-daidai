---
// 全站布局壳（2026-09-12 升级：SEO 头）。
// 所有页面经此获得：canonical（绝对地址、统一尾斜杠）、OG 标签（website/article
// 两态，article 态附发布/更新时间）、RSS 自动发现声明。
// 说明：未提供 image 时不输出 og:image 的旧注释已失效（2026-09-12 晚：
// og-image 静态端点已建成，文章详情页会自动传入）。
import '../styles/global.css';
import ScrollDock from '../components/ScrollDock.astro';

interface Props {
  title: string;
  description?: string;
  /** OG 页面类型：文章页传 article 并附时间元数据，其余走缺省 website */
  type?: 'website' | 'article';
  /** og:image（相对站点根的路径即可），未提供则不输出 */
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** 挡索引：404 等不应被收录的页面传 true */
  noindex?: boolean;
  /** 右下悬浮栈（音乐 / 到顶 / 到底，见 ScrollDock.astro）。
      缺省开 = 内页都用它。**首页传 false**（2026-09-13 用户裁定
      「留右侧回顶绳、去掉右下角」）：首页的回顶交互由 TopRope 的拉绳
      单独承担，右下角不再挂栈。
      短页/锁滚页不需要特殊处理：靠可见性阈值淡入，不滚就永不出现。
      横向位置不自带 20px，而是对齐 --chrome-axis（见上方脚本注释）。 */
  dock?: boolean;
}

const {
  title,
  description = '同一素材 · 同一交互 · 两种交付格式',
  type = 'website',
  image,
  publishedTime,
  modifiedTime,
  noindex = false,
  dock = true,
} = Astro.props;

// canonical：Astro 静态构建下 pathname 为生成路由（directory format 带尾斜杠），
// 保险起见统一补齐；中文路径由 URL 构造器按规范百分号编码。
const rawPath = Astro.url.pathname;
const normPath = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const canonical = new URL(normPath, Astro.site).href;
const rssHref = new URL('rss.xml', Astro.site).href;

const iso = (d?: Date) => d?.toISOString();
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <!-- 主题初始化：必须在首帧前同步执行（防 FOUC）。
        主题段与 src/lib/theme.js 的 resolveTheme 等价（内联脚本无法 import），
        改决策规则时两处同步。2026-09-12 用户裁定：默认昼，无合法记忆值一律
        浅色，系统深色偏好不参与决策；点过「夜」的记忆值仍生效。

        公告的预涂段已于 2026-09-13 第二轮改版时退役：旧形态点 × 后要整条
        隐藏 30 天，故必须预涂 data-announce-off 防「先闪现再消失」；新形态的
        按钮常驻顶栏，未读只用按钮上的红点表达，红点默认隐藏、由
        Announce.astro 按已读水位点亮，本文件不需要为公告做任何预涂，
        也不再持有 'announce-dismissed' 这个 key。 -->
    <script is:inline>
      (function () {
        var t = 'light';
        try {
          var s = localStorage.getItem('theme');
          t = s === 'dark' || s === 'light' ? s : 'light';
        } catch (e) {}
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Daidai 档案馆"
      href={rssHref}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Daidai 档案馆" />
    <meta property="og:locale" content="zh_CN" />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={iso(publishedTime)} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={iso(modifiedTime)} />
    )}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <!-- 昼夜切换章不再由壳层渲染（2026-09-13 第二轮，用户裁定 Q10(b)）：
         首页 = HeroStage 的固定顶栏 .top-bar 里；内页 = PageHead 的 .head__end
         里。标记与样式见 src/components/ThemeToggle.astro。壳层只保留下面这份
         「全站唯一的行为脚本」——模块脚本默认 defer，DOM 解析完才执行，所以
         能查到稍后由组件渲染出的那个按钮（组件复用也不会重复绑定）。 -->
    <script>
      import { THEME_KEY, currentTheme } from '../lib/theme.js';
      const btn = document.querySelector('.theme-toggle');
      const root = document.documentElement;
      const sync = () =>
        btn?.setAttribute('aria-pressed', String(currentTheme(root) === 'dark'));
      sync();

      /* ── 右侧固定 Chrome 的对齐轴（2026-09-13 第二轮建）─────────────────
         昼夜章的**圆心**是右侧所有浮动控件（回顶绳 .rope、悬浮栈 .dock）的
         唯一基准轴：把「视口右缘 → 章心」与「视口上缘 → 章底边」写进 :root，
         消费方只写 calc(null - 自身容器宽/2)。一个量测点，全站共用。
         ⚠️ 必须实测而不是写死 40px：内页页头左右内缩是
         clamp(20px, 4vw, 48px)，章心随视口宽漂移（1440px 时右缘
         48 + 半径 20 = 68px），写死会在宽屏上与章错开近 30px。
         ⚠️ 用 clientWidth 而不是 innerWidth：fixed 的右缘算的是 initial
         containing block（不含纵向滚动条），用 innerWidth 会平白多出
         滚动条那十几个像素。 */
      const syncAxis = () => {
        if (!btn) return;
        const r = btn.getBoundingClientRect();
        root.style.setProperty(
          '--chrome-axis',
          `${(root.clientWidth - r.left - r.width / 2).toFixed(2)}px`
        );
        root.style.setProperty('--chrome-bottom', `${r.bottom.toFixed(2)}px`);
      };
      syncAxis();
      window.addEventListener('resize', syncAxis);
      /* 字体 swap 会改右簇的排版宽度（站名 / chip 换字形），稳下来再量一次 */
      document.fonts?.ready.then(syncAxis);

      btn?.addEventListener('click', () => {
        const next = currentTheme(root) === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem(THEME_KEY, next);
        } catch {}
        sync();
      });
    </script>
    <slot />
    {dock && <ScrollDock />}
  </body>
</html>
