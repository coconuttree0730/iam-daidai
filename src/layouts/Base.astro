---
// 全站布局壳（2026-09-12 升级：SEO 头）。
// 所有页面经此获得：canonical（绝对地址、统一尾斜杠）、OG 标签（website/article
// 两态，article 态附发布/更新时间）、RSS 自动发现声明。
// 说明：未提供 image 时不输出 og:image 的旧注释已失效（2026-09-12 晚：
// og-image 静态端点已建成，文章详情页会自动传入）。
import '../styles/global.css';
import ScrollDock from '../components/ScrollDock.astro';
import { LOCALES, localeMeta, switchLocalePath, DEFAULT_LOCALE, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  title: string;
  description?: string;
  /** OG 页面类型：文章页传 article 并附时间元数据，其余走缺省 website */
  type?: 'website' | 'article';
  /** og:image（相对站点根的路径即可），未提供则不输出 */
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** 挡索引：404 等不应被收录的页面传 true */
  noindex?: boolean;
  /** 右下悬浮栈（音乐 / 到顶 / 到底，见 ScrollDock.astro）。
      缺省开 = 内页都用它。**首页传 false**（2026-09-13 用户裁定
      「留右侧回顶绳、去掉右下角」）：首页的回顶交互由 TopRope 的拉绳
      单独承担，右下角不再挂栈。
      短页/锁滚页不需要特殊处理：靠可见性阈值淡入，不滚就永不出现。
      横向位置不自带 20px，而是对齐 --chrome-axis（见上方脚本注释）。 */
  dock?: boolean;
  /** 页面语言。中文页（src/pages/ 根）**不传**，走缺省 'zh'——这样现有
      中文页面的调用点一行都不用改。英文页（src/pages/en/）传 locale="en"。
      影响三处：<html lang>、og:locale、hreflang alternate 集合。 */
  locale?: Locale;
}

const {
  title,
  description = '同一素材 · 同一交互 · 两种交付格式',
  type = 'website',
  image,
  publishedTime,
  modifiedTime,
  noindex = false,
  dock = true,
  locale = DEFAULT_LOCALE,
} = Astro.props;

const meta = localeMeta(locale);
const t = useTranslations(locale);

// canonical：Astro 静态构建下 pathname 为生成路由（directory format 带尾斜杠），
// 保险起见统一补齐；中文路径由 URL 构造器按规范百分号编码。
const rawPath = Astro.url.pathname;
const normPath = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const canonical = new URL(normPath, Astro.site).href;
const rssHref = new URL('rss.xml', Astro.site).href;

/* ── hreflang alternate 集合（2026-09-14 i18n）──────────────────────────
 * 为当前页的每种语言各输出一条 <link rel="alternate" hreflang>，加上
 * x-default 指向默认语言。Google 要求**双向声明**（中文页要指英文页、
 * 英文页也要指回中文页），两侧互为 alternate 才算完整声明——因为本站
 * 两种语言一一对应（不做 fallback 回退），所以这里能无条件生成全集。
 *
 * ⚠️ 将来若出现「某页只有中文、没有英文对页」的情况，这里会声明一个
 *    不存在的 URL → 必须改为按实际存在的对页过滤（配合 i18n.fallback
 *    的 rewrite 策略）。当前保持全集声明是正确的，因为英文树与中文树
 *    页面一一对应。
 *
 * 尾斜杠：与 canonical 同源（normPath），保证 alternate 与 canonical
 * 指向同一个规范化地址。 */
const alternates = LOCALES.map((loc) => ({
  hreflang: localeMeta(loc).htmlLang,
  href: new URL(switchLocalePath(normPath, loc), Astro.site).href,
}));
const xDefault = alternates.find((a) => a.hreflang === localeMeta(DEFAULT_LOCALE).htmlLang);

const iso = (d?: Date) => d?.toISOString();
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <!-- 主题初始化：必须在首帧前同步执行（防 FOUC）。
        主题段与 src/lib/theme.js 的 resolveTheme 等价（内联脚本无法 import），
        改决策规则时两处同步。2026-09-12 用户裁定：默认昼，无合法记忆值一律
        浅色，系统深色偏好不参与决策；点过「夜」的记忆值仍生效。

        公告的预涂段已于 2026-09-13 第二轮改版时退役：旧形态点 × 后要整条
        隐藏 30 天，故必须预涂 data-announce-off 防「先闪现再消失」；新形态的
        按钮常驻顶栏，未读只用按钮上的红点表达，红点默认隐藏、由
        Announce.astro 按已读水位点亮，本文件不需要为公告做任何预涂，
        也不再持有 'announce-dismissed' 这个 key。 -->
    <script is:inline>
      (function () {
        var t = 'light';
        try {
          var s = localStorage.getItem('theme');
          t = s === 'dark' || s === 'light' ? s : 'light';
        } catch (e) {}
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Daidai 档案馆"
      href={rssHref}
    />
    <!-- hreflang 双向声明（2026-09-14 i18n）：每门语言一条 + x-default。
         x-default 指向默认语言（中文），符合 Google 对「未匹配用户语言时的
         兜底版本」的定义。 -->
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:locale" content={meta.ogLocale} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={iso(publishedTime)} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={iso(modifiedTime)} />
    )}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <!-- icon 标签图片更换-->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  </head>
  <body>
    <!-- 键盘跳转链接（2026-09-14 无障碍补课，即 Cactus 的 SkipLink 同职能）：
         视觉隐藏，Tab 聚焦时从视口上方落下，点击跳过页头直达 <main id="main">。
         文案过 t() 走 i18n 字典；颜色全部消费 --c-*，暗色模式自动翻转——
         不含 data-theme 祖先选择器，因此可以留在本组件的 scoped 样式里。
         各页面的 <main> 已统一带 id="main"（HeroStage 舞台与全部内页，共 20 处）。 -->
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <!-- 昼夜切换章不再由壳层渲染（2026-09-13 第二轮，用户裁定 Q10(b)）：
         首页 = HeroStage 的固定顶栏 .top-bar 里；内页 = PageHead 的 .head__end
         里。标记与样式见 src/components/ThemeToggle.astro。壳层只保留下面这份
         「全站唯一的行为脚本」——模块脚本默认 defer，DOM 解析完才执行，所以
         能查到稍后由组件渲染出的那个按钮（组件复用也不会重复绑定）。 -->
    <script>
      import { THEME_KEY, currentTheme } from '../lib/theme.js';
      const btn = document.querySelector('.theme-toggle');
      const root = document.documentElement;
      const sync = () =>
        btn?.setAttribute('aria-pressed', String(currentTheme(root) === 'dark'));
      sync();

      /* ── 右侧固定 Chrome 的对齐轴（2026-09-13 第二轮建）─────────────────
         昼夜章的**圆心**是右侧所有浮动控件（回顶绳 .rope、悬浮栈 .dock）的
         唯一基准轴：把「视口右缘 → 章心」与「视口上缘 → 章底边」写进 :root，
         消费方只写 calc(null - 自身容器宽/2)。一个量测点，全站共用。
         ⚠️ 必须实测而不是写死 40px：内页页头左右内缩是
         clamp(20px, 4vw, 48px)，章心随视口宽漂移（1440px 时右缘
         48 + 半径 20 = 68px），写死会在宽屏上与章错开近 30px。
         ⚠️ 用 clientWidth 而不是 innerWidth：fixed 的右缘算的是 initial
         containing block（不含纵向滚动条），用 innerWidth 会平白多出
         滚动条那十几个像素。 */
      const syncAxis = () => {
        if (!btn) return;
        const r = btn.getBoundingClientRect();
        root.style.setProperty(
          '--chrome-axis',
          `${(root.clientWidth - r.left - r.width / 2).toFixed(2)}px`
        );
        root.style.setProperty('--chrome-bottom', `${r.bottom.toFixed(2)}px`);
      };
      syncAxis();
      window.addEventListener('resize', syncAxis);
      /* 字体 swap 会改右簇的排版宽度（站名 / chip 换字形），稳下来再量一次 */
      document.fonts?.ready.then(syncAxis);

      btn?.addEventListener('click', () => {
        const next = currentTheme(root) === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem(THEME_KEY, next);
        } catch {}
        sync();
      });
    </script>
    <slot />
    {dock && <ScrollDock locale={locale} />}
  </body>
</html>

<style>
  /* 键盘跳转链接（仅键盘用户可见）：平时停在视口上方，:focus-visible 落下。
     层级 900 > 全站已知最高 860（global.css 的 .dock/.rope 一族），盖住一切
     浮动控件。纸片底 + 红章描边 + 6px 圆角，与页头 chip / PostActions 按钮
     同一视觉语言；颜色全走 --c-*，暗色模式自动换肤。 */
  .skip-link {
    position: fixed;
    top: -64px;
    left: 16px;
    z-index: 900;
    padding: 9px 14px;
    background: var(--c-paper);
    border: 1.5px solid var(--c-red);
    border-radius: 6px;
    color: var(--c-ink);
    font-size: 13px;
    letter-spacing: 0.04em;
    line-height: 1;
    text-decoration: none;
    transition: top 0.15s ease;
  }
  .skip-link:focus-visible {
    top: 12px;
  }
  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>
