---
// ── 基本信息档案抽屉（卡 01 → #basic，2026-09-13）────────────────────────
//
// 载体是原生 <dialog>：showModal() 自带顶层置放、焦点圈定、Esc（cancel
// 事件），我们只补三件事——
//   1. 点卡 01 拦截默认锚点行为（页面上没有可滚的落点，href="#basic" 只当
//      语义标识与深链入口用：带 #basic 打开页面也会直接开抽屉）；
//   2. 展开动画的 transform-origin 指向卡 01 实测矩形（showModal 之后才有
//      几何可量，同步写 --file-ox/oy，动画从下一帧样式计算开始，不闪烁）；
//   3. 输入锁：开抽屉时给 :root 打 data-file-open，scroll-scrub.js /
//      demo-driver.js 见标记 early-return——否则滚轮会在背板后继续驱动
//      人物 scrub、触摸会被 .stage 的手势契约误收。
//
// DOM 位置：本组件由 HeroStage 渲染在 <main class="stage"> 之后（兄弟节点）。
// 不能塞进 .stage 里面——touch-action 按命中链取交集，.stage 的 none 会把
// 手机档 sheet 的滚动整段吞掉；站到 .stage 外面就天然豁免。
//
// 关闭：Esc / 点背板（::backdrop 的 click 事件 target 落在 dialog 元素上）/
// 「合卷 ×」钮，统一走 160ms 退场动画再 dialog.close()；close 后删掉
// data-file-open 并把焦点还给打开者（通常就是卡 01）。
//
// 数据全部来自 profile.json 的 basic 节（构建时静态 import，运行时零 fetch）；
// 占位文案的清单见该节 _todo 字段，改文案只改 JSON。
//
// ⚠️ 第 2 期双语化（2026-09-14）：basic 节的文案字段（name/status/identity/
//    now/skills/label/zodiac/mbti 及两个 *Desc）已改为 {zh,en}，本组件按
//    locale 取边；结构性字段（fileNo / href / icon / mono / action）保持原样。
import profile from '../data/profile.json';
import { TECH_ICONS } from '../data/tech-icons';
import { brandFor } from '../lib/tech-icon-color';
import { pickLocalized, useTranslations, interpolate, DEFAULT_LOCALE } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import '../styles/basic-drawer.css';

interface Props {
  /** 页面语言。抽屉挂在首页（HeroStage 透传），中英文共用同一组件。 */
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(locale);
const L = <T,>(v: T): T => pickLocalized(v, locale);

const basic = profile.basic;
const skills = (basic.skills ?? []).map((s) => L(s));
const links = basic.links ?? [];
const name = L(basic.name);
const status = L(basic.status);
const identity = L(basic.identity);
const now = L(basic.now);
const zodiac = L(basic.zodiac);
const zodiacDesc = L(basic.zodiacDesc);
const mbti = L(basic.mbti);
const mbtiDesc = L(basic.mbtiDesc);

/* ── 板块开关（2026-09-15）──────────────────────────────────────────────
 * 全部显隐由 profile.json 的 basic.blocks 控制：false 的板块整块不渲染，
 * 数据仍留在 JSON 里，改回 true 即恢复。这里只写默认值对象再展开覆盖，
 * 不逐项 `?? true`——新增板块时只改这一处与 JSON，组件其余部分无感。 */
const blocks = {
  skills: true,
  target: true,
  stack: true,
  practice: false,
  timeline: false,
  education: false,
  level: false,
  ...(basic.blocks ?? {}),
};
const stackStyle = basic.stackStyle ?? 'brand';

/* ── 职业定位 ── */
const target = {
  role: L(basic.target.role),
  summary: L(basic.target.summary),
  facts: basic.target.facts.map((f) => ({ value: f.value, label: L(f.label) })),
};

/* ── 技术栈：补图标与品牌色 ─────────────────────────────────────────────
 * 颜色在构建期算好写进内联 CSS 变量（--brand / --brand-dark / --brand-bg*），
 * 运行时零计算；没有官方图标的项（slug: null）走 mono 字母徽标降级。 */
const LEVEL_DOTS: Record<string, number> = { core: 3, used: 2, familiar: 1 };
const LEVEL_LABEL: Record<string, string> = {
  core: t('basic.levelCore'),
  used: t('basic.levelUsed'),
  familiar: t('basic.levelFamiliar'),
};

const stackGroups = (basic.stack ?? []).map((group) => ({
  id: group.id,
  label: L(group.label),
  items: group.items.map((item) => {
    const icon = item.slug ? TECH_ICONS[item.slug] : undefined;
    const level = item.level ?? 'used';
    /* 技术栈名两种形态混用（与 links[].label 同一约定）：纯拉丁专名
       （Java / Spring Boot）直接给字符串；带中文修饰的（UI 设计 /
       RAG 检索增强 / MCP 协议）给 {zh,en}，统一过 L() 取边。 */
    const name = typeof item.name === 'string' ? item.name : L(item.name);
    return {
      slug: item.slug,
      name,
      mono: item.mono ?? name.slice(0, 2).toUpperCase(),
      icon,
      color: icon ? brandFor(icon.hex) : null,
      dots: LEVEL_DOTS[level] ?? 2,
      levelWord: LEVEL_LABEL[level] ?? LEVEL_LABEL.used,
    };
  }),
}));

/* sprite 只输出真正用到的图标（去重）——整表 56 个全塞进来会白白胖一圈 */
const usedSlugs = [
  ...new Set(
    stackGroups
      .flatMap((g) => g.items.map((i) => i.slug))
      .filter((s): s is string => Boolean(s && TECH_ICONS[s]))
  ),
];

/* ── 工程实践 / 经历 / 教育（head 与 body 分离，分隔符交给 CSS）── */
const practice = (basic.practice ?? []).map((p) => ({ head: L(p.head), body: L(p.body) }));
const timeline = (basic.timeline ?? []).map((r) => ({
  period: L(r.period),
  role: L(r.role),
  note: L(r.note),
}));
const education = (basic.education ?? []).map((e) => ({ name: L(e.name), note: L(e.note) }));
---

<dialog class="file-dialog" id="basic" data-icons={stackStyle} aria-labelledby="basic-file-title">
  <h2 class="sr-only" id="basic-file-title">{t('basic.dialogTitle')}</h2>

  <header class="file-head">
    <span class="file-head-label">{t('basic.fileHeadLabel')}</span>
    <span class="file-head-no">{basic.fileNo}</span>
    <button type="button" class="file-close" data-file-close>
      <span class="file-close-x" aria-hidden="true">×</span>
      <span>{t('basic.close')}</span>
    </button>
  </header>

  <div class="file-body">
    <figure class="file-photo obj" style="--tilt: -0.8deg">
      <img
        src="/motion/0166.png"
        alt="Daidai 的档案照（正面立绘帧）"
        width="340"
        height="420"
        loading="lazy"
      />
      <span class="tape tape-a" aria-hidden="true"></span>
      <span class="tape tape-b" aria-hidden="true"></span>
      <span class="file-photo-stamp" aria-hidden="true">{t('basic.photoStamp')}<br />2026</span>
      <figcaption>{t('basic.photoCaption')}</figcaption>
    </figure>

    <div class="file-objects">
      <article class="obj file-id" style="--tilt: 0.6deg">
        <p class="file-id-name">{name}</p>
        <div class="file-id-social">
          {
            links.map((link) => {
              /* 只有 http(s) 外链开新标签；mailto: / 站内（含 #contact）/rss.xml
                 当前页处理。data-action="contact" 的项由下方脚本接管：
                 不跳页，改为把首页推到收尾态露出内联表单（2026-09-13）。 */
              const external = link.href.startsWith('http');
              const linkLabel = L(link.label);
              return (
                <a
                  class:list={["file-social", { "file-social--mono": link.mono }]}
                  href={link.href}
                  data-action={link.action}
                  title={linkLabel}
                  aria-label={linkLabel}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <img src={link.icon} alt="" width="22" height="22" loading="lazy" />
                </a>
              );
            })
          }
        </div>
      </article>

      {
        blocks.target && (
          <article class="obj file-target" style="--tilt: 0.5deg">
            <p class="obj-label">{t('basic.labelTarget')}</p>
            <p class="target-line">{target.role}</p>
            <p class="target-sub">{target.summary}</p>
            <ul class="target-facts">
              {target.facts.map((fact) => (
                <li>
                  <b>{fact.value}</b>
                  <span>{fact.label}</span>
                </li>
              ))}
            </ul>
          </article>
        )
      }

      {
        blocks.skills && (
          <article class="obj file-skills" style="--tilt: 0.5deg">
            <p class="obj-label">{t('basic.labelSkills')}</p>
            <ul class="file-skills-list">
              {skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </article>
        )
      }

      {
        blocks.stack && (
          <article class="obj file-stack" style="--tilt: -0.4deg">
            <p class="obj-label">{t('basic.labelStack')}</p>
            <div class="stack-groups">
              {stackGroups.map((group) => (
                <div class="stack-group">
                  <p class="stack-group-label">{group.label}</p>
                  <ul class="stack-list">
                    {group.items.map((item) => (
                      <li
                        class="tech"
                        style={
                          item.color
                            ? `--brand:${item.color.brand};--brand-dark:${item.color.brandDark};--brand-bg:${item.color.bg};--brand-bg-dark:${item.color.bgDark}`
                            : undefined
                        }
                      >
                        <span class="tech-badge">
                          {item.icon && item.slug ? (
                            <svg class="ti" aria-hidden="true">
                              <use href={`#si-${item.slug}`} />
                            </svg>
                          ) : (
                            <span class="ti ti--mono" aria-hidden="true">{item.mono}</span>
                          )}
                        </span>
                        <span class="tech-name">{item.name}</span>
                        {blocks.level && (
                          <span class="tech-level">
                            <span class="tech-dots" aria-hidden="true">
                              {[0, 1, 2].map((i) => <i class={i < item.dots ? 'on' : ''} />)}
                            </span>
                            <span class="tech-level-word">{item.levelWord}</span>
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </article>
        )
      }

      {
        blocks.practice && (
          <article class="obj file-practice" style="--tilt: 0.7deg">
            <p class="obj-label">{t('basic.labelPractice')}</p>
            <ul class="practice-list">
              {practice.map((item) => (
                <li>
                  <b>{item.head}</b>
                  <span>{item.body}</span>
                </li>
              ))}
            </ul>
          </article>
        )
      }

      {
        blocks.timeline && (
          <article class="obj file-timeline" style="--tilt: -0.6deg">
            <p class="obj-label">{t('basic.labelTimeline')}</p>
            <ol class="tl">
              {timeline.map((row) => (
                <li>
                  <span class="tl-year">{row.period}</span>
                  <span>
                    <span class="tl-role">{row.role}</span>
                    <span class="tl-note">{row.note}</span>
                  </span>
                </li>
              ))}
            </ol>
          </article>
        )
      }

      {
        blocks.education && (
          <article class="obj file-edu" style="--tilt: 0.5deg">
            <p class="obj-label">{t('basic.labelEducation')}</p>
            <ul class="edu-list">
              {education.map((row) => (
                <li>
                  <span>{row.name}</span>
                  <span>{row.note}</span>
                </li>
              ))}
            </ul>
          </article>
        )
      }

      <article class="obj file-note" style="--tilt: 0.9deg">
        <p class="obj-label">{t('basic.labelIdentity')}</p>
        <p class="file-note-text">{identity}</p>
        <span class="tape" aria-hidden="true"></span>
      </article>

      <article class="obj file-now" style="--tilt: -0.7deg">
        <p class="obj-label">{t('basic.labelNow')}</p>
        <p class="file-now-text">{now}</p>
        <span class="file-now-stamp" aria-hidden="true">NOW<br />2026</span>
      </article>
    </div>
  </div>

  <span class="file-badge" aria-hidden="true">{status}</span>
  <button
    type="button"
    class="file-sticker"
    id="basic-sticker"
    aria-expanded="false"
    aria-controls="basic-persona"
  >
    <span>
      <strong>{mbti}</strong>
      <small>{zodiac}</small>
    </span>
  </button>

  <div class="file-persona" id="basic-persona" hidden>
    <p class="obj-label">{t('basic.labelPersona')}</p>
    <dl class="file-persona-list">
      <div>
        <dt>{zodiac}</dt>
        <dd>{zodiacDesc}</dd>
      </div>
      <div>
        <dt>{mbti}</dt>
        <dd>{mbtiDesc}</dd>
      </div>
    </dl>
  </div>

  <footer class="file-foot">
    <span>{interpolate(t('basic.foot'), { no: basic.fileNo })}</span>
    <span class="file-foot-bar" aria-hidden="true"></span>
  </footer>
</dialog>

{
  /* 技术栈图标 sprite（只含实际用到的），放在 dialog 之外：
     未打开的 <dialog> 是 display:none，<use> 引用其子树内的 symbol 在部分
     浏览器上不可靠；挂到组件根级 + width/height:0 是最稳的做法。 */
  blocks.stack && (
    <svg class="tech-sprite" aria-hidden="true" focusable="false">
      <defs>
        {usedSlugs.map((slug) => (
          <symbol id={`si-${slug}`} viewBox="0 0 24 24">
            <path fill="currentColor" d={TECH_ICONS[slug].path} />
          </symbol>
        ))}
      </defs>
    </svg>
  )
}

<script>
    const dialog = document.getElementById('basic');
  const root = document.documentElement;

  if (dialog instanceof HTMLDialogElement) {
    const closeBtn = dialog.querySelector('[data-file-close]');
    const sticker = dialog.querySelector('#basic-sticker');
    const persona = dialog.querySelector('#basic-persona');
    let opener = null;
    /* 邮箱链路还焦开关（2026-09-14 晚）：点「邮箱」收抽屉时，收尾态已把
       版式推到 --sc→1，卡 01 随飞散态飞出屏外。close 时若照常 opener.focus()，
       浏览器的 reveal 滚动会为"露出"这枚不可见卡片滚动文档——在存在文档
       溢出的机型上就是用户报告的「页面偏移」；且把焦点放进一枚透明度 0.15
       的屏外卡片本身就不成立。此链路跳过还焦（焦点落回 body）。 */
    let skipOpenerFocus = false;

    /* 贴纸 → 性格侧写便签：点贴纸开合，点便签外/关抽屉收起 */
    const setPersona = (open) => {
      if (!(persona instanceof HTMLElement)) return;
      persona.hidden = !open;
      sticker?.setAttribute('aria-expanded', String(open));
    };

    sticker?.addEventListener('click', () => {
      if (persona instanceof HTMLElement) setPersona(persona.hidden);
    });

    const openFrom = (el) => {
      if (dialog.open) return;
      opener = el instanceof HTMLElement ? el : null;
      /* 输入锁先行：showModal 之前打标记，防止同一帧内的输入漏进 scrub */
      root.setAttribute('data-file-open', 'on');
      dialog.showModal();

      /* 展开起点 = 卡 01 中心（关着的时候没有几何，所以只能在 showModal
         之后量；同一同步任务里写变量，动画从下一帧样式计算开始，不闪烁） */
      const card = document.querySelector('a.card[href="#basic"]');
      if (card instanceof HTMLElement) {
        const cr = card.getBoundingClientRect();
        const dr = dialog.getBoundingClientRect();
        dialog.style.setProperty(
          '--file-ox',
          `${(cr.left + cr.width / 2 - dr.left).toFixed(1)}px`
        );
        dialog.style.setProperty(
          '--file-oy',
          `${(cr.top + cr.height / 2 - dr.top).toFixed(1)}px`
        );
      }
    };

    /* 退场动画 + 真正 close：170ms > CSS 的 160ms，动画播完才撤出顶层 */
    const closeAnimated = () => {
      if (!dialog.open || dialog.classList.contains('file-closing')) return;
      dialog.classList.add('file-closing');
      window.setTimeout(() => {
        dialog.classList.remove('file-closing');
        dialog.close();
      }, 170);
    };

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const card = event.target.closest('a[href="#basic"]');
      if (card) {
        if (!event.defaultPrevented) {
          event.preventDefault();
          openFrom(card);
        }
        return;
      }
      /* 点背板：::backdrop 不接收事件，click 会以 dialog 自身为 target 落下；
         点在卷宗内容上时 target 是内容元素，不会误关 */
      if (dialog.open && event.target === dialog) closeAnimated();
      /* 点在贴纸和便签之外：顺手收起性格便签（若开着） */
      if (
        persona instanceof HTMLElement &&
        !persona.hidden &&
        !event.target.closest('#basic-persona, #basic-sticker')
      ) {
        setPersona(false);
      }
    });

    closeBtn?.addEventListener('click', closeAnimated);

    /* ── 邮箱图标 → 首页收尾态（2026-09-13 用户裁定）────────────────────
     * 不跳独立页（/contact/ 已撤销）：点「邮箱」图标时先收抽屉露出首页，再派发
     * 'scrub:outro' 让 scroll-scrub.js 把版式一次推到收尾（--sc→1），首页底部
     * 那张联系表单随之升起。真实邮箱仍只存在于 Worker secret，网页零明文——
     * 这才是本条链路的根本目的。
     *
     * 与滚动路径共用同一状态机（派发事件由 scroll-scrub.js 消费），因此不产生
     * 第二份进度；页面没有 scrub 舞台时事件自然落空，此处无须判空。 */
    dialog.querySelectorAll('[data-action="contact"]').forEach((el) => {
      el.addEventListener('click', (event) => {
        event.preventDefault();
        skipOpenerFocus = true; /* 本链路不还焦：卡 01 已飞散出屏，见上注 */
        closeAnimated();
        document.dispatchEvent(new CustomEvent('scrub:outro'));
      });
    });

    /* Esc 走原生 cancel：拦下默认的瞬时 close，改走带动画的路径 */
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeAnimated();
    });

    dialog.addEventListener('close', () => {
      delete root.dataset.fileOpen;
      setPersona(false);
      if (!skipOpenerFocus) opener?.focus();
      skipOpenerFocus = false;
      opener = null;
    });

    /* 深链：#basic 直达抽屉（关闭后地址栏不动，刷新仍在——够用且零侵入） */
    if (location.hash === '#basic') {
      openFrom(document.querySelector('a.card[href="#basic"]'));
    }
  }
</script>
