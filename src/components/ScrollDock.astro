---
/*
  ⚠️ 第 2 期（2026-09-14）：文案随 locale 走。本组件由 Base.astro 渲染，
     Base 已持有 locale，直接透传即可。
*/
import { useTranslations, DEFAULT_LOCALE } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(locale);
---

<div class="dock">
  <button
    class="dock__btn dock__toc"
    type="button"
    data-toc-open
    hidden
    aria-expanded="false"
    aria-controls="toc-sheet"
    title={t('dock.toc')}
    aria-label={t('dock.toc')}
  >
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.9"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  </button>

  <div class="dock__group">
    <button
      class="dock__btn dock__music"
      type="button"
      data-music
      aria-pressed="false"
      title={t('dock.musicSoon')}
      aria-label={t('dock.music')}
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 17.6V5.4l10-1.8v11.4"></path>
        <circle cx="6.6" cy="17.6" r="2.6"></circle>
        <circle cx="16.6" cy="15" r="2.6"></circle>
      </svg>
    </button>

    <button
      class="dock__btn"
      type="button"
      data-top
      title={t('dock.top')}
      aria-label={t('dock.top')}
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 15l7-7 7 7"></path>
      </svg>
    </button>

    <button
      class="dock__btn"
      type="button"
      data-bottom
      title={t('dock.bottom')}
      aria-label={t('dock.bottom')}
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 9l7 7 7-7"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  /* ── 悬浮栈行为 ────────────────────────────────────────────────────────
     两种宿主，判据是「本页有没有 scrub 舞台」（data-scrub-view）：

     ① 普通内页（文章页等）：滚动在 window 上（无内层滚动容器，已核实），
        「到顶/到底」直接 window.scrollTo；可见性 = scrollY > 240。
     ② 首页：**页面本身不滚动**，纵向输入被 scroll-scrub.js 吃成 193 帧
        时间轴，位移全部消费 :root 的 --sc（0–1）。所以
          · 可见性跟 --sc 走（≥0.70 进 / ≤0.62 出，带滞回）；
          · 「到顶」= 派发 'scrub:top'、「到底」= 派发 'scrub:outro'
            —— 与 #basic 抽屉的邮箱入口同一套事件握手，复用同一份状态机
            （单一进度是 scroll-scrub 的硬契约，别在这里另算一份）。
        事件由 scroll-scrub.js 消费；页面没有 scrub 舞台时事件自然落空，
        所以那条分支同时写了 window.scrollTo 兜底。

     页内有 <dialog> 时它自带惰性背板，无需额外遮罩。
     scroll 监听 passive + rAF 合帧；scrub 页改由 MutationObserver 盯 --sc
     （它是每帧写在 :root 内联样式上的，观察 style 比 rAF 轮询省）。 */
  const docEl = document.documentElement;
  const scrubView = document.querySelector('[data-scrub-view]');
  const btnTop = document.querySelector('[data-top]');
  const btnBottom = document.querySelector('[data-bottom]');
  const btnMusic = document.querySelector('[data-music]');

  /* 「目录」钮的放行**不由本组件负责**：它 markup 上带 hidden，
     只有 ArticleToc.astro 确认「本页真有大纲」后才 removeAttribute('hidden')。
     单一写入者，避免两个脚本各写一半（本组件挂在全站每页，不假设页面是文章页）。 */

  const scrollToEnd = (bottom) => {
    const max = Math.max(0, docEl.scrollHeight - window.innerHeight);
    window.scrollTo({ top: bottom ? max : 0, behavior: 'smooth' });
  };
  const goTop = () => {
    if (scrubView) document.dispatchEvent(new CustomEvent('scrub:top'));
    else scrollToEnd(false);
  };
  const goBottom = () => {
    if (scrubView) document.dispatchEvent(new CustomEvent('scrub:outro'));
    else scrollToEnd(true);
  };
  if (btnTop instanceof HTMLButtonElement) {
    btnTop.addEventListener('click', goTop);
  }
  if (btnBottom instanceof HTMLButtonElement) {
    btnBottom.addEventListener('click', goBottom);
  }

  /* 音乐：仅切换按压态与图标配色。TODO —— 接入真实播放器时
     在这里改 audio.play()/pause()，并把 aria-pressed 与播放态绑定。 */
  if (btnMusic instanceof HTMLButtonElement) {
    btnMusic.addEventListener('click', () => {
      const on = btnMusic.getAttribute('aria-pressed') !== 'true';
      btnMusic.setAttribute('aria-pressed', String(on));
    });
  }

  /* 首页：栈要抬到黑条（.infobar）上方。黑条在两种主题下都是深色，
     白圆钮直接压上去显脏；而黑条高度由 hero.css 的 --bar-h 控制、且有
     媒体档覆盖（桌面 max(42px,6.6%) / 窄档 max(38px,7.5%)），**照抄表达式
     会漂移**，所以直接量它自己的盒高 —— 唯一随档位自动正确的口径。 */
  if (scrubView) {
    const dock = document.querySelector('.dock');
    const bar = document.querySelector('.infobar');
    if (dock instanceof HTMLElement && bar instanceof HTMLElement) {
      const lift = () => {
        const h = Math.round(bar.getBoundingClientRect().height);
        dock.style.bottom = `calc(${h}px + 18px + env(safe-area-inset-bottom, 0px))`;
      };
      lift();
      window.addEventListener('resize', lift);
    }
  }

  let raf = 0;
  const read = () => {
    raf = 0;
    if (scrubView) {
      /* scrub 页：可见性与禁用态都跟 --sc 走 */
      const raw = getComputedStyle(docEl).getPropertyValue('--sc');
      const parsed = Number.parseFloat(raw);
      const sc = Number.isFinite(parsed) ? Math.min(1, Math.max(0, parsed)) : 0;
      if (sc >= 0.7) docEl.setAttribute('data-scrolled', 'on');
      else if (sc <= 0.62) docEl.removeAttribute('data-scrolled');
      if (btnTop instanceof HTMLButtonElement) btnTop.disabled = sc <= 0.02;
      if (btnBottom instanceof HTMLButtonElement) btnBottom.disabled = sc >= 0.98;
      return;
    }
    const y = window.scrollY || 0;
    const max = Math.max(0, docEl.scrollHeight - window.innerHeight);
    /* 顶部附近不打扰版面；短页（无可滚距离）永远不淡入 */
    if (y > 240 && max > 240) docEl.setAttribute('data-scrolled', 'on');
    else docEl.removeAttribute('data-scrolled');
    if (btnTop instanceof HTMLButtonElement) btnTop.disabled = y <= 4;
    if (btnBottom instanceof HTMLButtonElement) {
      btnBottom.disabled = max <= 4 || y >= max - 4;
    }
  };
  const schedule = () => {
    if (!raf) raf = requestAnimationFrame(read);
  };

  if (scrubView) {
    /* --sc 写在 :root 内联 style 上：观察 style 即事件驱动、与 scrub 同拍 */
    new MutationObserver(schedule).observe(docEl, {
      attributes: true,
      attributeFilter: ['style'],
    });
  } else {
    window.addEventListener('scroll', schedule, { passive: true });
  }
  window.addEventListener('resize', schedule);
  read();
</script>
