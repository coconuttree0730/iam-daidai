---
// 分页导航（2026-09-12）：列表页底部「← 上一页 / 第 X / Y 页 / 下一页 →」。
// 仅在多页时渲染（单页列表不出现）。prev/next 由 Astro paginate() 提供：
// page.url.prev 在第 2 页时是 /blog（无尾斜杠），统一补齐为 /blog/ 风格。
//
// ⚠️ 2026-09-14 第 2 期：文案与语言由调用方传入（locale），不再硬编码中文。
//    分页 URL 由 Astro 的 paginate() 生成，已带语言前缀，本组件不推导。
import { useTranslations, DEFAULT_LOCALE } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  page: {
    url: { prev?: string | undefined; next?: string | undefined };
    currentPage: number;
    lastPage: number;
  };
  locale?: Locale;
}

const { page, locale = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(locale);
const normalize = (u?: string) => (u && !u.endsWith('/') ? `${u}/` : u);
const prevHref = normalize(page.url.prev);
const nextHref = normalize(page.url.next);
const multi = page.lastPage > 1;
---

{
  multi && (
    <nav class="pager" aria-label={t('pager.nav')}>
      {prevHref ? (
        <a class="nav" href={prevHref} rel="prev">
          {t('pager.prev')}
        </a>
      ) : (
        <span class="nav nav--off" aria-disabled="true">
          {t('pager.prev')}
        </span>
      )}
      <span class="ind">
        {page.currentPage} / {page.lastPage}
      </span>
      {nextHref ? (
        <a class="nav" href={nextHref} rel="next">
          {t('pager.next')}
        </a>
      ) : (
        <span class="nav nav--off" aria-disabled="true">
          {t('pager.next')}
        </span>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 2px 30px;
    border-top: 1px solid rgba(19, 18, 17, 0.16);
  }
  .nav {
    font-size: 13.5px;
    font-weight: 700;
    color: #131211;
    text-decoration: none;
    border-bottom: 1px solid rgba(19, 18, 17, 0.4);
    padding-bottom: 2px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .nav:hover {
    color: #cf0a1a;
    border-color: #cf0a1a;
  }
  .nav--off {
    color: rgba(19, 18, 17, 0.28);
    border-bottom-color: transparent;
    pointer-events: none;
  }
  .ind {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #6f6f6f;
    font-variant-numeric: tabular-nums;
  }
</style>
