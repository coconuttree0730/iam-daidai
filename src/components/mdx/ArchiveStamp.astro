---
// 档案印章批注（MDX 演示组件，2026-09-12）。
// 供文章正文内嵌使用：<ArchiveStamp text="..." />——一块盖了红章的批注条，
// 颜色全走 --c-* 色板（暗色模式下章底提亮、纸底换深，随主题翻转）。
interface Props {
  /** 批注正文 */
  text: string;
  /** 章面文字，默认「批注」 */
  stamp?: string;
}
const { text, stamp = '批注' } = Astro.props;
---

<aside class="stamp-note">
  <span class="stamp-note__seal" aria-hidden="true">{stamp}</span>
  <p class="stamp-note__body">{text}</p>
</aside>

<style>
  .stamp-note {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 1.6em 0;
    padding: 14px 18px;
    border: 1px dashed var(--c-line);
    border-left: 3px solid var(--c-red);
    background: var(--c-card-warm);
    border-radius: 6px;
  }
  .stamp-note__seal {
    flex: none;
    padding: 4px 10px;
    border: 2px solid var(--c-red);
    border-radius: 6px;
    color: var(--c-red);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.2em;
    rotate: -6deg;
  }
  .stamp-note__body {
    margin: 0;
    font-size: 0.92em;
    line-height: 1.8;
    color: var(--c-note-ink);
  }
</style>
