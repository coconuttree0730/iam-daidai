---
/*
  英文分类索引页（2026-09-14 英文档补齐）：/en/categories/
  ────────────────────────────────────────────────────────────────────────
  中文对应物 = src/pages/categories/index.astro（版式同构：sheet + archive-chrome
  + tags-index.css 三件共享表，与中文页逐像素同款）。

  与 /en/tags/ 同一套落点页策略：
  · 行链接指向 /en/categories/<name>/ 落点页（noindex）——英文树内的分类
    导航留在树内，不再跨语言跳中文页；zh 页仍是 canonical
    （索引/sitemap/hreflang 不变）。2026-09-14 用户反馈后统一。
  · 分类名 / desc 渲染的仍是中文（「英文正文暂不做」裁定的直接后果），
    页面挂 .fallback-note 明确告知，不静默。
*/
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { getSortedPosts } from '../../../data/posts';
import { CATEGORIES, categoryOrder, findCategory } from '../../../data/categories';
import { useTranslations, interpolate } from '../../../i18n/utils';
import '../../../styles/sheet.css';
import '../../../styles/archive-chrome.css';
import '../../../styles/tags-index.css';

const t = useTranslations('en');
const posts = await getSortedPosts();

/* 按 category 计数（只统计已发布文章；draft 在生产构建已被 getSortedPosts 过滤） */
const counts = new Map<string, number>();
for (const p of posts) {
  const c = p.data.category;
  if (!c) continue;
  counts.set(c, (counts.get(c) ?? 0) + 1);
}

/* 清单里登记的分类（含 0 篇）+ 未登记但实际出现的分类，合并且按清单序排 */
const registered = CATEGORIES.map((c) => ({
  name: c.name,
  en: c.en,
  desc: c.desc,
  count: counts.get(c.name) ?? 0,
}));
const unregistered = [...counts.keys()]
  .filter((name) => !findCategory(name))
  .sort((a, b) => a.localeCompare(b))
  .map((name) => ({
    name,
    en: '',
    desc: t('cats.uncategorized'),
    count: counts.get(name) ?? 0,
  }));

const rows = [...registered, ...unregistered].sort(
  (a, b) => categoryOrder(a.name) - categoryOrder(b.name) ||
    a.name.localeCompare(b.name),
);

const totalCategorized = [...counts.values()].reduce((a, b) => a + b, 0);
---

<Base
  title={`${t('section.cats.title')} · ${t('site.title')}`}
  description={t('section.cats.desc')}
  locale="en"
>
  <main class="sheet" id="main">
    <PageHead
      no="NO.03"
      chips={[
        { label: t('cats.index'), variant: 'red' },
        { label: t('cats.chipAllTags'), href: '/en/tags/' },
      ]}
      back={{ label: t('head.backBlog'), href: '/en/blog/' }}
      locale="en"
    />

    {/* 页头镜像（2026-09-15 daidai 裁定）：文字左、插画右——与 /en/tags/ 相反。
        与中文分类页同构；用 DOM 换序而非 row-reverse，共享的 tags-index.css 零改动。 */}
    <section class="hero">
      <div class="hero__text">
        {/* 描边大字 "CATEGORIES" 已删（2026-09-15 daidai 裁定）：本页 h1 是
            "Categories"，与描边层同词重复。中文页保留 CATEGORIES +「全部分类」。
            `.hero .en` 规则仍在共享的 tags-index.css 里（中文页在用），勿删。
            ⛔ 不要"为了中英一致"把它加回来。 */}
        <h1>{t('section.cats.title')}</h1>
      </div>
      <img
        class="hero__art"
        src="/motion/categories-archive-chibi.webp"
        alt=""
        width="723"
        height="680"
        loading="eager"
        decoding="async"
      />
    </section>

    <p class="fallback-note">{t('cats.fallbackNote')}</p>

    {
      rows.length === 0 ? (
        <section class="stamp" aria-label={t('cats.none')}>
          <strong>{t('cats.none')}</strong>
          <small>{t('cats.noneNote')}</small>
        </section>
      ) : (
        <section class="list-section" aria-label={t('cats.listAria')}>
          <ul class="list" role="list">
            {rows.map((c, i) => (
              <li>
                {/* 行链接指向 /en/ 落点页（noindex）——见文件头注释 */}
                <a class="row" href={`/en/categories/${c.name}/`}>
                  <span class="lead">
                    <span class="no" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="count">{interpolate(t('cats.count'), { n: c.count })}</span>
                  </span>
                  <span class="body">
                    <span class="name">{c.name}</span>
                    {c.desc && <span class="desc">{c.desc}</span>}
                  </span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="lede">
            {interpolate(t('cats.lede'), { a: totalCategorized, b: posts.length })}
          </p>
        </section>
      )
    }

    <!-- 收尾导航（手机档专用）：页头 .back 在 ≤640px 隐藏时的补偿入口，
         通往 /en/blog/，与页头 .back 同目的地、两档严格互斥。 -->
    <a class="postback" href="/en/blog/">{t('head.backBlog')}</a>

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<style>
  /* 版式复用 src/styles/tags-index.css（与中文分类页同一份共享表）。
     这里只写本页特有规则：.desc / .lede（分类说明与统计行）、
     .fallback-note（内容语言说明）、.postback（手机档收尾导航）。 */
  .body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .desc {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--c-muted);
  }
  .lede {
    margin: 18px 2px 0;
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.7;
    color: var(--c-muted);
  }

  .fallback-note {
    margin: 18px clamp(20px, 4vw, 48px) 0;
    padding: 9px 14px;
    border-left: 3px solid var(--c-red);
    background: rgba(var(--c-ink-rgb), 0.04);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--c-muted);
  }

  /* 手机档收尾导航：.sheet 是 flex column，必须 align-self:flex-start +
     width:fit-content，否则交叉轴 stretch 会把下划线拉成整行宽
     （与中文分类页 / tags-index.css 注释里同一个坑）。 */
  .postback {
    display: none;
    align-self: flex-start;
    width: fit-content;
    align-items: center;
    gap: 6px;
    margin: 6px clamp(20px, 4vw, 48px) 22px;
    padding-bottom: 2px;
    font-size: 13px;
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--c-ink-rgb), 0.4);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .postback:hover {
    color: var(--c-red);
    border-color: var(--c-red);
  }
  @media (max-width: 640px) {
    .postback {
      display: flex;
    }
  }
</style>
