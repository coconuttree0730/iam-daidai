---
// 英文标签索引 = /en/tags/（2026-09-14 i18n 第 1 期）
//
// ⚠️ 标签名本身就是内容（来自文章 frontmatter 的 tags 字段，如「随笔」「建站」），
//    英文站显示的仍是中文标签。这是「英文正文暂不做」裁定的直接后果——
//    标签依附于文章，文章不翻译，标签自然无从翻译。
//
//    页面因此挂一条说明（.fallback-note）。行链接指向 /en/tags/<name>/ 落点页
//    （noindex）——英文树内的标签导航留在树内，不再跨语言跳中文页；
//    zh 页仍是 canonical（索引/sitemap/hreflang 不变）。2026-09-14 用户反馈后统一。
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { getSortedPosts } from '../../../data/posts';
import { useTranslations } from '../../../i18n/utils';
import '../../../styles/sheet.css';
import '../../../styles/archive-chrome.css';
// 版式消费共享表 tags-index.css（其文件头契约：中英文共用、全站唯一一份）。
// 本页此前自带的整套 scoped 副本（.hero/.row/.stamp 等，数值与共享表分歧）
// 已删——两份并存会形成混合级联，且那份副本是抽取前的旧草稿，从未校版。
// 详见本文件底部 scoped 块的说明。审计 A2（2026-09-14）。
import '../../../styles/tags-index.css';

const posts = await getSortedPosts();
const t = useTranslations('en');

const counts = new Map<string, number>();
for (const p of posts) {
  for (const tag of p.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
---

<Base
  title={`${t('section.tags.title')} · ${t('site.title')}`}
  description={t('section.tags.desc')}
  locale="en"
>
  <main class="sheet" id="main">
    <PageHead
      no="NO.03"
      chips={[
        // 自指「Index」chip 随中文版同批删除；「RSS」亦移除（2026-09-14，
        // Base <head> autodiscovery 已覆盖订阅发现）。
        { label: 'Categories', href: '/en/categories/' },
      ]}
      back={{ label: t('head.backBlog'), href: '/en/blog/' }}
      locale="en"
    />

    <section class="hero">
      <img class="hero__art" src="/motion/tags-cabinet-chibi.webp" alt="" width="723" height="680" loading="eager" decoding="async" />
      <div class="hero__text">
        {/* 描边大字 "TAGS" 已删（2026-09-15 daidai 裁定）：本页 h1 是 "Tags"，
            与描边层同词重复。中文页保留 TAGS + 「标签索引」——那里互补不重复。
            `.hero .en` 规则仍在共享的 tags-index.css 里（中文页在用），勿删。
            ⛔ 不要"为了中英一致"把它加回来。 */}
        <h1>{t('section.tags.title')}</h1>
      </div>
    </section>

    <p class="fallback-note">
      Tags are currently in Chinese, following the language of the posts.
    </p>

    {
      tags.length === 0 ? (
        <section class="stamp" aria-label={t('empty.noTags')}>
          <strong>{t('empty.noTags')}</strong>
          <small>{t('empty.noTagsNote')}</small>
        </section>
      ) : (
        <section class="list-section" aria-label="Tag list">
          <ul class="list" role="list">
            {tags.map(([name, count], i) => (
              <li>
                {/* 指向 /en/tags/<name>/ 落点页（noindex）——见文件头注释 */}
                <a class="row" href={`/en/tags/${name}/`}>
                  <span class="lead">
                    <span class="no" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="count">{count} {count === 1 ? 'post' : 'posts'}</span>
                  </span>
                  <span class="body">
                    <span class="name">#{name}</span>
                  </span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- 收尾导航（手机档专用）：与中文 /tags/ 同一机制，页头 .back 在 ≤640px
         隐藏时补回通往 /en/blog/ 的站内路径，两档严格互斥。 -->
    <a class="postback" href="/en/blog/">{t('head.backBlog')}</a>

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<style>
  /* 版式已统一消费 tags-index.css（中英文共用，见文件头契约）。
     本页只保留 EN 特有规则——fallback 说明条（zh 页无此元素）：

     审计 A2 追记（2026-09-14）：本页原有整套 scoped 版式副本（.hero/.row/
     .stamp 等），数值与 tags-index.css 分歧（插画 120–260 vs 150–368、
     flex 行 vs grid 行）——那是共享表抽取前的旧草稿。补上 import 后若保留
     两份，scoped 的高特异性会压过共享表、非冲突属性又混入共享表行为，
     形成不可预测的混合级联。故删副本、只留本页特有规则。 */
  .fallback-note {
    margin: 18px clamp(20px, 4vw, 48px) 0;
    padding: 9px 14px;
    border-left: 3px solid var(--c-red);
    background: rgba(var(--c-ink-rgb), 0.04);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--c-muted);
  }
</style>
