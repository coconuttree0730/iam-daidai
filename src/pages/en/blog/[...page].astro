---
// 英文博客列表 = /en/blog/（2026-09-14 i18n 第 1 期）
//
// ⚠️ 内容回退策略（第 1 期，用户裁定「暂不做英文正文」）：
//    文章列表与详情页沿用**中文正文**。这不是遗漏，是刻意的阶段划分——
//    英文正文的翻译是独立的一期工作（content collections 加 lang 字段、
//    .md/.en.md 成对）。当前阶段先把「路由 + UI 外壳」跑通。
//
//    为了不让访问者困惑，页面上会挂一条常驻说明（见 .fallback-note），
//    明确告知「文章内容以中文为准」。这比静默显示中文正文诚实。
//
// ⚠️ Pagefind 检索框（2026-09-15 用户要求挂载，推翻第 1 期「暂不挂」裁定）：
//    挂载方案与中文版同构（src/lib/blog-search.js + blog-search.css），文案走
//    英文键。已知现状：正文仍是中文回退，索引里搜出来的是中文文章——这与
//    .fallback-note 的「内容以中文为准」说明语义自洽，不算检索坏了。
//    等英文正文就位那期再评估 Pagefind 按语言分索引。
//
// ⚠️ 与中文版的关系：本页的中文对应物是 src/pages/blog/[...page].astro。
//    两者的**差异仅在文案**（chips 标签、返回链、h1）+ 本页独有的
//    .fallback-note。版式骨架（.sheet/.sr-only/.hero-band/.foot）已抽到
//    src/styles/ 下的共享表，两页共用，不会漂移。
import '@pagefind/default-ui/css/ui.css'; // Pagefind 组件样式（2026-09-14：漏引 = 输入框裸原生样式，与中文版对齐）
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Paginator from '../../../components/Paginator.astro';
import PostCard from '../../../components/PostCard.astro';
import { getSortedPosts, groupPostsByYear, splitFeaturedPosts } from '../../../data/posts';
import { useTranslations } from '../../../i18n/utils';
import '../../../styles/sheet.css';
import '../../../styles/archive-chrome.css';
import '../../../styles/blog-list.css';
import '../../../styles/blog-search.css';

export async function getStaticPaths({ paginate }) {
  const posts = await getSortedPosts();
  return paginate(posts, { params: {}, pageSize: 12 });
}

const { page } = Astro.props;
const t = useTranslations('en');

/* 置顶精选（2026-09-14 与中文版对齐）：featured 只在第 1 页抽出、单组成组、
   不参与年份分组——否则散落到各自年份里失去置顶意义。第 2 页起不抽
   （置顶的意义本就是"首屏可见"，且第 2 页起抽会得到空组）。 */
const isFirstPage = page.currentPage === 1;
const { featured, rest } = splitFeaturedPosts(page.data);
const featuredItems = isFirstPage ? featured : [];
const listItems = isFirstPage ? rest : page.data;

/* 检索框文案（SSR 序列化给 data-pf-i18n）：script 引用不到 frontmatter 的
   t()，只能写进 data 属性让运行时读回。键与中文版 [...page].astro 对齐。 */
const pfI18n = JSON.stringify({
  placeholder: t('blog.searchPlaceholder'),
  clear: t('blog.clear'),
  loadMore: t('blog.loadMore'),
  search: t('blog.search'),
  filter: t('blog.filter'),
  zero: t('blog.noResult'),
  count: t('blog.count'),
  clearSearch: t('blog.clearAria'),
  searching: t('blog.searching'),
  searchErr: t('blog.searchErr'),
});

const yearGroups = groupPostsByYear(listItems).map(([year, posts]) => ({
  year,
  items: posts,
}));
---
<Base
  title={`${t('section.blog.title')} · ${t('site.title')}`}
  description={t('section.blog.desc')}
  locale="en"
>
  <main class="sheet" id="main">
    <PageHead
      no="NO.03"
      chips={[
        { label: 'Categories', href: '/en/categories/' },
        { label: 'Tags', href: '/en/tags/' },
        // RSS chip removed (2026-09-14 user ruling): autodiscovery in Base <head> covers it.
      ]}
      back={{ label: t('head.backHome'), href: '/en/' }}
      locale="en"
    />

    <!-- 页头横幅三件套，与中文版同一批素材（素材不分语言，不要复制文件） -->
    <section class="hero">
      <h1 class="sr-only">{t('section.blog.title')}</h1>
      <div class="hero-band">
        <img class="hero-band__bg" src="/motion/blog-banner.webp" alt="" width="2048" height="1024" loading="eager" decoding="async" />
        <img class="hero-band__shadow" src="/motion/blog-shadow.webp" alt="" width="760" height="76" loading="eager" decoding="async" />
        <img class="hero-band__char" src="/motion/blog-character-chibi.webp" alt="" width="1279" height="1950" loading="eager" decoding="async" />
      </div>
    </section>

    <!-- 站内全文检索（2026-09-15 挂载）：与中文版同一挂载脚本（lib/blog-search.js），
         文案走 data-pf-i18n 英文键。索引里是中文文章，见文件头说明。 -->
    <section class="searchbar" aria-label={t('blog.search')}>
      <div class="search-mount" id="search-mount" data-pf-i18n={pfI18n}></div>
      <p class="search-status" data-search-status hidden></p>
    </section>

    <!-- 内容回退说明（第 1 期专有）：英文正文尚未提供，列表条目是中文。
         等英文正文就位后删除本节。 -->
    <p class="fallback-note">Post content is currently available in Chinese only.</p>

    {
      page.data.length === 0 ? (
        <section class="stamp" aria-label={t('empty.archiving')}>
          <strong>{t('empty.archiving')}</strong>
          <small>{t('empty.archivingNote')}</small>
        </section>
      ) : (
        <section class="list-section" data-list aria-label="Post list">
          {/* 置顶精选组：与中文版同构（只在第 1 页、有 featured 时渲染） */}
          {featuredItems.length > 0 && (
            <section class="year-group year-group--featured">
              <h2 class="year year--featured">
                <span class="year__star" aria-hidden="true">★</span>
                FEATURED
              </h2>
              <ul class="list list--archive" role="list">
                {featuredItems.map((post) => (
                  <li>
                    <PostCard
                      post={post}
                      base="/en/blog/"
                      categoryBase="/en/categories/"
                      tagBase="/en/tags/"
                    />
                  </li>
                ))}
              </ul>
            </section>
          )}

          {yearGroups.map(({ year, items }) => (
            <section class="year-group">
              <h2 class="year">{year}</h2>
              <ul class="list list--archive" role="list">
                {items.map((post) => (
                  <li>
                    {/* 分类/标签 chip 指 /en/ 落点页（noindex）：英文树内导航
                        留在树内，不再跨语言跳中文页（2026-09-14 用户反馈后统一）。
                        base 必须传，否则点击会落到中文详情页。 */}
                    <PostCard
                      post={post}
                      base="/en/blog/"
                      categoryBase="/en/categories/"
                      tagBase="/en/tags/"
                    />
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <Paginator page={page} locale="en" />
        </section>
      )
    }

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<script>
  {/* 站内全文检索挂载：与中文版共用 lib/blog-search.js，这里只传英文兜底
      文案与状态行文案（data-pf-i18n 正常时兜底不会被用到）。 */}
  import { mountBlogSearch, reportSearchFailure } from '../../../lib/blog-search.js';

  const mountEl = document.getElementById('search-mount');
  const statusEl = document.querySelector('[data-search-status]');

  mountBlogSearch({
    mountEl,
    statusEl,
    fallback: {
      placeholder: 'Search posts…',
      clear: 'Clear',
      loadMore: 'Load more',
      search: 'Search this site',
      filter: 'Filter',
      zero: 'No results for “[SEARCH_TERM]”',
      count: '[COUNT] results · “[SEARCH_TERM]”',
      searching: 'Searching…',
      searchErr: 'Search failed, please retry',
      clearSearch: 'Clear search',
    },
    devNotice: 'dev mode: no index · full-text search works in the build output / live site',
    failNotice: (msg) => `Failed to load search UI: ${msg}`,
  }).catch((err) => {
    console.error('[blog-search] Failed to mount search UI:', err);
    reportSearchFailure(statusEl, (msg) => `Failed to load search UI: ${msg}`, err);
  });
</script>

<style>
  /* 版式全部来自共享表 blog-list.css（含横幅落点、年份分组、精选组样式），
     与中文版同一份——此前本页手抄过一份副本，会随共享表演进而漂移
     （2026-09-14 换回共享导入，与 /en/tags/ 漏导 tags-index.css 是同一类病）。
     仅本页特有的回退说明条写在这里。 */
  .fallback-note {
    margin: 18px clamp(20px, 4vw, 48px) 0;
    padding: 9px 14px;
    border-left: 3px solid var(--c-red);
    background: rgba(var(--c-ink-rgb), 0.04);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--c-muted);
  }
</style>
