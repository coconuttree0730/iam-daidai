---
// 博客文章详情页（2026-09-12 建）：/blog/<post.id>/
// getStaticPaths 遍历全部已发布文章（draft 在 getAllPosts 内被生产构建过滤），
// 正文用 astro:content 的 render() 渲染 Markdown；prose 样式手写、纸感配色。
// 档案风骨架（编号头 / 条码页脚）与 blog.astro 同款——两处 scoped 样式有意保持一致，
// 若日后调整档案骨架，两个文件要同步改。
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import { getSortedPosts, getFormattedDate } from '../../data/posts';

export async function getStaticPaths() {
  // 相邻文章：newer = 更新一篇（列表更靠前），older = 更旧一篇。
  const posts = await getSortedPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
/* headings 由 render() 一并给出（depth 2/3 进大纲），id 与正文 h* 完全同源，
   所以 ArticleToc 的锚点不需要运行时再扫一遍 DOM。 */
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const minutes = remarkPluginFrontmatter?.minutes;
const iso = post.data.publishDate.toISOString();
---
<Base
  title={`${post.data.title} · Daidai档案馆`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.publishDate}
  modifiedTime={post.data.updatedDate}
  image={`/og-image/${post.id}.png`}
>
  <main class="sheet">
    <PageHead
      no="NO.03"
      chips={[{ label: '归档', variant: 'red' }]}
      back={{ label: '← 返回博客', href: '/blog/' }}
    />

    <article class="post">
      {/* 正文区网格（2026-09-13 第二批）：≤1100px 单列；≥1101px 第 2 列让给
          sticky 大纲栏。列宽/列距在这里定（720 + 48 + 216 = 984，1101px 视口
          减去左右内距 96px 仍有余量）；栏自己的 grid-column/grid-row 写在
          ArticleToc.astro —— 页面只负责给格子，组件负责怎么摆。 */}
      <div class="post-grid">
        <header class="post-head">
          <p class="en" aria-hidden="true">NOTES</p>
          <h1>{post.data.title}</h1>
          <div class="meta">
            <time datetime={iso}>{getFormattedDate(post.data.publishDate)}</time>
            {minutes && <span class="sep" aria-hidden="true">·</span>}
            {minutes && <span class="read">约 {minutes} 分钟</span>}
            {post.data.updatedDate && (
              <>
                <span class="sep" aria-hidden="true">·</span>
                <time datetime={post.data.updatedDate.toISOString()}>
                  更新于 {getFormattedDate(post.data.updatedDate)}
                </time>
              </>
            )}
            {post.data.tags.map((t) => (
              <a class="chip" href={`/tags/${t}/`}>#{t}</a>
            ))}
          </div>
        </header>

        <ArticleToc headings={headings} />

        <div class="prose" data-pagefind-body>
          <Content />
        </div>

        {
          (newer || older) && (
            <nav class="postnav" aria-label="相邻文章">
              {newer ? (
                <a class="navcard" href={`/blog/${newer.id}/`}>
                  <small>← 上一篇（更新）</small>
                  <strong>{newer.data.title}</strong>
                </a>
              ) : (
                <span class="navcard navcard--ghost" aria-hidden="true" />
              )}
              {older ? (
                <a class="navcard navcard--right" href={`/blog/${older.id}/`}>
                  <small>下一篇（更旧） →</small>
                  <strong>{older.data.title}</strong>
                </a>
              ) : (
                <span class="navcard navcard--ghost" aria-hidden="true" />
              )}
            </nav>
          )
        }

        <!-- 收尾导航（2026-09-13 第三轮，用户裁定）：只在 ≤640px 显示。
             手机档页头隐藏了 .back（移动端有系统返回手势，页内文字链冗余），
             详情页因此失去唯一的「回列表」站内路径 —— 这一条补回来，位置比
             顶栏更合理：读者读到文末才需要"回列表"，顶栏那条是在还没读的
             时候就催人走。桌面档不显示：页头 .head 是 sticky 的，返回链全程
             可见，正文再放一条就是重复入口。两者严格互斥。
             ⚠️ 「上一篇 / 下一篇」由上面的 .postnav 提供，这里只补缺失的那一环。 -->
        <a class="postback" href="/blog/">← 返回博客</a>
      </div>
    </article>

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>

    <!-- 评论区：Utterances（GitHub Issues 托管）。弱化为档案附录一栏。
         repo / issue-term 走 data-*，由页尾 is:inline 脚本读走——
         is:inline 不被 Astro 插值，故不可在此写 {post.id} 进 script 标签。
         （注释里刻意不写尖括号形式的标签名：那会让「按标签配对」的解析器
         把一个不存在的 script 块一路吞到下一个 </script>，干扰产物校验。）
         外层的 .comments-grid 只为「跟正文同一列」——≥1101px 时正文列被右栏
         挤到视口中心之左，附录若继续按 820px 居中就会明显错位。 -->
    <div class="comments-grid">
      <section class="comments" aria-label="评论区">
        <header class="comments-head">
          <span class="tag tag--red">读者来信</span>
          <span class="comments-note">由 GitHub Issues 托管 · 登录 GitHub 后方可评论</span>
        </header>
        <div
          id="utterances"
          class="comments-host"
          data-repo="coconuttree0730/iam-daidai"
          data-issue-term={post.id}
        ></div>
      </section>
    </div>
  </main>
</Base>

<!-- 文章页不挂自定义增强脚本：
     · 大纲（右栏 / 移动 sheet / 高亮 / 进度条）由 ArticleToc.astro 在构建时渲染；
     · 代码块复制按钮由 astro-expressive-code 内置提供（见 astro.config.mjs），
       此处不再重复实现，避免与内置图标按钮叠加成双入口。 -->

<!-- Utterances 加载器：is:inline 原样输出，避免 Astro 打包外部脚本。
     ① repo / issue-term 读自 #utterances 的 data-*（Astro 模板可插值属性）；
     ② theme 初始值按当前 data-theme 取，随后用 MutationObserver 跟随站点暗色开关
        向 utteranc.es 的 iframe postMessage set-theme（B 档：跟站点而非跟系统）。 -->
<script is:inline>
  (function () {
    var host = document.getElementById('utterances');
    if (!host) return;
    var repo = host.dataset.repo;
    var term = host.dataset.issueTerm;

    function themeFor() {
      return document.documentElement.getAttribute('data-theme') === 'dark'
        ? 'github-dark'
        : 'github-light';
    }

    var s = document.createElement('script');
    s.src = 'https://utteranc.es/client.js';
    s.async = true;
    s.crossOrigin = 'anonymous';
    s.setAttribute('repo', repo);
    s.setAttribute('issue-term', term);
    s.setAttribute('theme', themeFor());
    s.setAttribute('label', 'blog-comment');
    host.appendChild(s);

    // 跟随站点暗色开关：向 utteranc.es 的 iframe 派发 set-theme
    function syncTheme() {
      var frame = document.querySelector('iframe.utterances-frame');
      if (!frame || !frame.contentWindow) return;
      frame.contentWindow.postMessage(
        { type: 'set-theme', theme: themeFor() },
        'https://utteranc.es'
      );
    }

    var mo = new MutationObserver(syncTheme);
    mo.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    // iframe 异步注入，load 后再补一次初始同步（兜底切换发生在注入前的竞态）
    window.addEventListener('load', function () {
      setTimeout(syncTheme, 600);
    });
  })();
</script>

<style>
  .sheet {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--c-paper);
    color: var(--c-ink);
    font-family: "Noto Sans CJK SC", "Source Han Sans SC", "PingFang SC",
      "Microsoft YaHei", sans-serif;
  }

  .post {
    flex: 1;
  }
  /* 正文区网格（2026-09-13 第二批）。
     列宽/列距是页面的职责；栏自己的 grid 定位归 ArticleToc.astro。
     横向内距从各子件上收到容器，所以 720px 列宽就是「净文本宽」——
     旧版是 max-width:720 含 20px 内距（实际 680）。
     grid-template-rows 必须显式写：栏用 grid-row:1/-1 跨满三行，而负数行号
     是从**显式网格**末端数的，没显式行的话 -1 会解析成第 1 条线。 */
  .post-grid,
  .comments-grid {
    display: grid;
    grid-template-columns: minmax(0, 720px);
    grid-template-rows: auto auto auto;
    justify-content: center;
    padding: 0 clamp(20px, 4vw, 48px);
  }
  @media (min-width: 1101px) {
    .post-grid,
    .comments-grid {
      /* 720 + 48 + 216 = 984；1101px 视口减左右内距 96px 还剩 1005，够 */
      grid-template-columns: minmax(0, 720px) 216px;
      column-gap: 48px;
    }
  }
  .post-head {
    grid-column: 1;
    grid-row: 1;
    padding: 40px 0 6px;
  }
  .post-head .en {
    margin: 0 0 4px;
    font-family: "Anton", Impact, sans-serif;
    font-size: clamp(20px, 3vw, 34px);
    line-height: 1;
    letter-spacing: 0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--c-ghost);
    user-select: none;
  }
  .post-head h1 {
    margin: 0;
    font-weight: 900;
    font-size: clamp(26px, 5vw, 48px);
    line-height: 1.2;
    letter-spacing: 0.01em;
  }
  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .meta time {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }
  .chip {
    display: inline-block;
    padding: 1px 8px;
    border: 1px solid rgba(var(--c-red-rgb), 0.45);
    border-radius: 4px;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--c-red);
  }
  a.chip {
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  a.chip:hover {
    border-color: var(--c-red);
    background: rgba(var(--c-red-rgb), 0.08);
  }
  .sep {
    color: rgba(var(--c-ink-rgb), 0.35);
  }
  .read {
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--c-muted);
  }

  /* ── 目录（TOC）已迁出本文件（2026-09-13 第二批）──────────────────
     原先的文首内联目录（.toc + 脚本扫 h2/h3 注入）整体废弃：
     桌面改右侧 sticky 栏、移动改底部 sheet，两者都由
     src/components/ArticleToc.astro 承载（列表在构建时渲染，不再注入 DOM，
     所以那边也不需要 :global）。 */

  /* ── 相邻文章导航（上一篇/下一篇）── */
  .postnav {
    grid-column: 1;
    grid-row: 3;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    padding: 0 0 46px;
  }
  .navcard {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid rgba(var(--c-ink-rgb), 0.25);
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    min-height: 64px;
    transition: border-color 0.15s ease;
  }
  .navcard small {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--c-muted);
  }
  .navcard strong {
    font-size: 14px;
    font-weight: 800;
    line-height: 1.4;
  }
  .navcard:hover {
    border-color: var(--c-red);
  }
  .navcard:hover small {
    color: var(--c-red);
  }
  .navcard--right {
    text-align: right;
    align-items: flex-end;
  }
  /* 占位空卡：单侧缺相邻文章时保持左右对齐 */
  .navcard--ghost {
    visibility: hidden;
  }

  /* ── 收尾导航（手机档专用，2026-09-13 第三轮）────────────────────
     与 .prose/.postnav 同列的第 4 行。基类 display:none 让桌面档完全不受
     影响：display:none 的网格项不生成盒子，既不占行也不影响上面那三行的
     模板（grid-template-rows: auto auto auto，第 4 行是隐式行）。
     用 flex + width:fit-content + justify-self:start，让下划线只到文字宽度
     （与页头 .back 同形），而不是拉伸成整列宽。 */
  .postback {
    grid-column: 1;
    grid-row: 4;
    display: none;
    justify-self: start;
    width: fit-content;
    align-items: center;
    gap: 6px;
    margin: 0 0 44px;
    padding-bottom: 2px;
    font-size: 13px;
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--c-ink-rgb), 0.4);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .postback:hover {
    color: var(--c-red);
    border-color: var(--c-red);
  }
  @media (max-width: 640px) {
    .postback {
      display: flex;
    }
    /* postnav 的 46px 底距让给 postback：不让「相邻文章 → 回列表」之间空出
       46px 再把收尾区撑散，18px 只作两者的呼吸位。 */
    .postnav {
      padding-bottom: 18px;
    }
  }

  /* ── 正文 prose（手写，纸感配色）── */
  .prose {
    grid-column: 1;
    grid-row: 2;
    padding: 14px 0 48px;
    font-size: 15px;
    line-height: 1.9;
  }
  .prose :global(h2) {
    font-size: 20px;
    font-weight: 900;
    margin: 34px 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(var(--c-ink-rgb), 0.16);
    /* 大纲锚点跳转的呼吸位（页头 sticky 后高约 64px，留 96px 不被遮住） */
    scroll-margin-top: 96px;
  }
  .prose :global(h3) {
    font-size: 16.5px;
    font-weight: 800;
    margin: 26px 0 10px;
    scroll-margin-top: 96px;
  }
  .prose :global(p) {
    margin: 0 0 14px;
  }
  .prose :global(a) {
    color: var(--c-red);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .prose :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .prose :global(strong) {
    font-weight: 800;
  }
  .prose :global(blockquote) {
    margin: 18px 0;
    padding: 4px 18px;
    border-left: 3px solid var(--c-red);
    color: var(--c-muted);
  }
  .prose :global(blockquote p) {
    margin: 8px 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 14px;
    padding-left: 24px;
  }
  .prose :global(li) {
    margin-bottom: 6px;
  }
  .prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.86em;
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(var(--c-ink-rgb), 0.06);
    border: 1px dotted rgba(var(--c-ink-rgb), 0.35);
  }
  .prose :global(pre) {
    margin: 18px 0;
    padding: 16px 18px;
    border-radius: 10px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.7;
  }
  .prose :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
  }
  .prose :global(img) {
    max-width: 100%;
    border-radius: 8px;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px dashed rgba(var(--c-ink-rgb), 0.3);
    margin: 30px 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    margin: 18px 0;
  }
  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px dashed rgba(var(--c-ink-rgb), 0.3);
    padding: 8px 10px;
    text-align: left;
  }
  .prose :global(th) {
    font-weight: 800;
    border-bottom: 1px solid rgba(var(--c-ink-rgb), 0.4);
  }

  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 clamp(20px, 4vw, 48px) 26px;
  }
  .foot .dash {
    width: 34px;
    height: 5px;
    background: var(--c-red);
  }
  .foot .barcode {
    height: 14px;
    width: 64px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--c-ink) 0 1px,
      transparent 1px 2.4px,
      var(--c-ink) 2.4px 4.4px,
      transparent 4.4px 5.4px,
      var(--c-ink) 5.4px 6.4px,
      transparent 6.4px 8.4px
    );
  }

  /* ── 评论区（Utterances，弱化为档案附录一栏）── */
  .comments {
    grid-column: 1;
    padding: 4px 0 44px;
  }
  .comments-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .comments-note {
    margin-left: auto;
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--c-muted);
  }
  /* 虚线边框 + 浅底，把 GitHub 原生灰块收进档案纸面语境，避免风格跳脱 */
  .comments-host {
    border: 1px dashed rgba(var(--c-ink-rgb), 0.3);
    border-radius: 8px;
    padding: 16px;
    background: rgba(var(--c-paper-rgb), 0.35);
    min-height: 140px;
  }
</style>
