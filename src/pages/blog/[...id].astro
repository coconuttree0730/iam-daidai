---
// 博客文章详情页（2026-09-12 建）：/blog/<post.id>/
// getStaticPaths 遍历全部已发布文章（draft 在 getAllPosts 内被生产构建过滤），
// 正文用 astro:content 的 render() 渲染 Markdown；prose 样式手写、纸感配色。
// 档案风骨架（编号头 / 条码页脚）与 blog.astro 同款——两处 scoped 样式有意保持一致，
// 若日后调整档案骨架，两个文件要同步改。
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getSortedPosts, getFormattedDate } from '../../data/posts';

export async function getStaticPaths() {
  // 相邻文章：newer = 更新一篇（列表更靠前），older = 更旧一篇。
  const posts = await getSortedPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const minutes = remarkPluginFrontmatter?.minutes;
const iso = post.data.publishDate.toISOString();
---
<Base
  title={`${post.data.title} · Daidai档案馆`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.publishDate}
  modifiedTime={post.data.updatedDate}
>
  <main class="sheet">
    <header class="head">
      <span class="tag">NO.03</span>
      <span class="tag tag--red">归档</span>
      <a class="back" href="/blog/">← 返回博客</a>
    </header>

    <article class="post">
      <header class="post-head">
        <p class="en" aria-hidden="true">NOTES</p>
        <h1>{post.data.title}</h1>
        <div class="meta">
          <time datetime={iso}>{getFormattedDate(post.data.publishDate)}</time>
          {minutes && <span class="sep" aria-hidden="true">·</span>}
          {minutes && <span class="read">约 {minutes} 分钟</span>}
          {post.data.tags.map((t) => (
            <a class="chip" href={`/tags/${t}/`}>#{t}</a>
          ))}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>

    {
      (newer || older) && (
        <nav class="postnav" aria-label="相邻文章">
          {newer ? (
            <a class="navcard" href={`/blog/${newer.id}/`}>
              <small>← 上一篇（更新）</small>
              <strong>{newer.data.title}</strong>
            </a>
          ) : (
            <span class="navcard navcard--ghost" aria-hidden="true" />
          )}
          {older ? (
            <a class="navcard navcard--right" href={`/blog/${older.id}/`}>
              <small>下一篇（更旧） →</small>
              <strong>{older.data.title}</strong>
            </a>
          ) : (
            <span class="navcard navcard--ghost" aria-hidden="true" />
          )}
        </nav>
      )
    }

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<style>
  .sheet {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #eeedeb;
    color: #131211;
    font-family: "Noto Sans CJK SC", "Source Han Sans SC", "PingFang SC",
      "Microsoft YaHei", sans-serif;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 22px clamp(20px, 4vw, 48px);
    border-bottom: 1px solid rgba(19, 18, 17, 0.16);
  }
  .tag {
    font-family: "Archivo Black", "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border: 1px solid #131211;
    border-radius: 4px;
  }
  .tag--red {
    border-color: #cf0a1a;
    color: #cf0a1a;
  }
  .back {
    margin-left: auto;
    font-size: 13px;
    color: #131211;
    text-decoration: none;
    border-bottom: 1px solid rgba(19, 18, 17, 0.4);
    padding-bottom: 2px;
  }
  .back:hover { color: #cf0a1a; border-color: #cf0a1a; }

  .post {
    flex: 1;
  }
  .post-head {
    padding: 40px clamp(20px, 4vw, 48px) 6px;
    max-width: 820px;
    margin: 0 auto;
    width: 100%;
  }
  .post-head .en {
    margin: 0 0 4px;
    font-family: "Anton", Impact, sans-serif;
    font-size: clamp(20px, 3vw, 34px);
    line-height: 1;
    letter-spacing: 0.04em;
    color: transparent;
    -webkit-text-stroke: 1px #c3c1be;
    user-select: none;
  }
  .post-head h1 {
    margin: 0;
    font-weight: 900;
    font-size: clamp(26px, 5vw, 48px);
    line-height: 1.2;
    letter-spacing: 0.01em;
  }
  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .meta time {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: #6f6f6f;
    font-variant-numeric: tabular-nums;
  }
  .chip {
    display: inline-block;
    padding: 1px 8px;
    border: 1px solid rgba(207, 10, 26, 0.45);
    border-radius: 4px;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: #cf0a1a;
  }
  a.chip {
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  a.chip:hover {
    border-color: #cf0a1a;
    background: rgba(207, 10, 26, 0.08);
  }
  .sep {
    color: rgba(19, 18, 17, 0.35);
  }
  .read {
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: #6f6f6f;
  }

  /* ── 相邻文章导航（上一篇/下一篇）── */
  .postnav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    max-width: 820px;
    margin: 0 auto;
    width: 100%;
    padding: 0 20px 46px;
  }
  .navcard {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid rgba(19, 18, 17, 0.25);
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    min-height: 64px;
    transition: border-color 0.15s ease;
  }
  .navcard small {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #6f6f6f;
  }
  .navcard strong {
    font-size: 14px;
    font-weight: 800;
    line-height: 1.4;
  }
  .navcard:hover {
    border-color: #cf0a1a;
  }
  .navcard:hover small {
    color: #cf0a1a;
  }
  .navcard--right {
    text-align: right;
    align-items: flex-end;
  }
  /* 占位空卡：单侧缺相邻文章时保持左右对齐 */
  .navcard--ghost {
    visibility: hidden;
  }

  /* ── 正文 prose（手写，纸感配色）── */
  .prose {
    max-width: 720px;
    margin: 0 auto;
    padding: 14px 20px 48px;
    font-size: 15px;
    line-height: 1.9;
  }
  .prose :global(h2) {
    font-size: 20px;
    font-weight: 900;
    margin: 34px 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(19, 18, 17, 0.16);
  }
  .prose :global(h3) {
    font-size: 16.5px;
    font-weight: 800;
    margin: 26px 0 10px;
  }
  .prose :global(p) {
    margin: 0 0 14px;
  }
  .prose :global(a) {
    color: #cf0a1a;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .prose :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .prose :global(strong) {
    font-weight: 800;
  }
  .prose :global(blockquote) {
    margin: 18px 0;
    padding: 4px 18px;
    border-left: 3px solid #cf0a1a;
    color: #6f6f6f;
  }
  .prose :global(blockquote p) {
    margin: 8px 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 14px;
    padding-left: 24px;
  }
  .prose :global(li) {
    margin-bottom: 6px;
  }
  .prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.86em;
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(19, 18, 17, 0.06);
    border: 1px dotted rgba(19, 18, 17, 0.35);
  }
  .prose :global(pre) {
    margin: 18px 0;
    padding: 16px 18px;
    border-radius: 10px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.7;
  }
  .prose :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
  }
  .prose :global(img) {
    max-width: 100%;
    border-radius: 8px;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px dashed rgba(19, 18, 17, 0.3);
    margin: 30px 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    margin: 18px 0;
  }
  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px dashed rgba(19, 18, 17, 0.3);
    padding: 8px 10px;
    text-align: left;
  }
  .prose :global(th) {
    font-weight: 800;
    border-bottom: 1px solid rgba(19, 18, 17, 0.4);
  }

  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 clamp(20px, 4vw, 48px) 26px;
  }
  .foot .dash {
    width: 34px;
    height: 5px;
    background: #cf0a1a;
  }
  .foot .barcode {
    height: 14px;
    width: 64px;
    background-image: repeating-linear-gradient(
      90deg,
      #131211 0 1px,
      transparent 1px 2.4px,
      #131211 2.4px 4.4px,
      transparent 4.4px 5.4px,
      #131211 5.4px 6.4px,
      transparent 6.4px 8.4px
    );
  }
</style>
