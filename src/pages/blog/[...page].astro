---
// 博客列表页（分页版，2026-09-12 升级）：/blog/ 第 1 页，/blog/2、/blog/3… 后续页。
// 由原 blog.astro 重命名迁移而来（路由升级为 paginate，12 篇/页，与 Cactus 一致）。
// 档案风骨架沿用：NO.03 编号头 + NOTES 描边大字 + 页脚条码；head 增加标签/RSS 入口。
import Base from '../../layouts/Base.astro';
import Paginator from '../../components/Paginator.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts, groupPostsByYear } from '../../data/posts';
/* default-ui 的组件样式是独立 CSS（JS 里不含样式，漏引 = 输入框裸原生样式，
   2026-09-12 dev 截图暴露的正是这个，线上同样会裸）。类名前缀 pagefind-ui，
   不会污染站内样式；.search-mount 上的 --pagefind-ui-* 变量负责主题换肤。 */
import '@pagefind/default-ui/css/ui.css';

export async function getStaticPaths({ paginate }) {
	const posts = await getSortedPosts();
	return paginate(posts, { params: {}, pageSize: 12 });
}

const { page } = Astro.props;

// 按年分组（编号序列不再需要，2026-09-12 用户裁定：文档标签保留时间，去掉 NO.xx）
const yearGroups = groupPostsByYear(page.data).map(([year, posts]) => ({
	year,
	items: posts,
}));
---
<Base title="Daidai档案馆" description="博客板块 · 文章归档">
  <main class="sheet">
    <header class="head">
      <span class="tag">NO.03</span>
      <span class="tag tag--red">密级 公开</span>
      <a class="tag tag--link" href="/tags/">标签</a>
      <a class="tag tag--link" href="/rss.xml">RSS</a>
      <a class="back" href="/">← 返回档案馆</a>
    </header>

    {/* 页头横幅：横幅底 + 人物层两件套（素材由 .tmp/prep_blog_header.py 生成，
        横幅已抹除内嵌人物、纸色重映射为站纸 var(--c-paper)；h1 转视觉隐藏保语义） */}
    <section class="hero">
      <h1 class="sr-only">博客</h1>
      <div class="hero-band">
        <img
          class="hero-band__bg"
          src="/motion/blog-banner.webp"
          alt=""
          width="2048"
          height="1024"
          loading="eager"
          decoding="async"
        />
        <img
          class="hero-band__char"
          src="/motion/blog-character.webp"
          alt=""
          width="623"
          height="915"
          loading="eager"
          decoding="async"
        />
      </div>
    </section>

    <section class="searchbar" aria-label="全文检索">
      <div class="search-mount" id="search-mount"></div>
      <p class="search-status" data-search-status hidden></p>
    </section>

    {
      page.data.length === 0 ? (
        <section class="stamp" aria-label="档案整理中">
          <strong>档案整理中</strong>
          <small>ARCHIVING · 该板块即将开放</small>
        </section>
      ) : (
        <section class="list-section" data-list aria-label="文章列表">
          {yearGroups.map(({ year, items }) => (
            <section class="year-group">
              <h2 class="year">{year}</h2>
              <ul class="list list--archive" role="list">
                {items.map((post) => (
                  <li>
                    <PostCard post={post} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <Paginator page={page} />
        </section>
      )
    }

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<script>
  /* ── 站内全文检索（Pagefind）──
     方案二（2026-09-12 用户裁定）：@pagefind/default-ui 构建时打包成独立
     chunk，运行时由 UI 内部按需加载 /pagefind/ 索引产物（bundlePath）。
     输入框右侧的圆圈 × 为自定义按钮，替代 default-ui 的文本「清空」按钮。 */
  const mountEl = document.getElementById('search-mount');
  const statusEl = document.querySelector('[data-search-status]');
  const show = (el) => el && el.removeAttribute('hidden');

  async function mountSearch() {
    const { PagefindUI } = await import('@pagefind/default-ui');
    new PagefindUI({
      element: mountEl,
      bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
      /* resetStyles 默认 true 会向 <head> 注入全局重置，可能波及站内样式，关掉 */
      resetStyles: false,
      showSubResults: true,
      excerptLength: 20,
      translations: {
        placeholder: '检索文章全文…',
        clear_search: '清空',
        load_more: '加载更多',
        search_label: '站内全文检索',
        filters_label: '过滤',
        zero_results: '没有与「[QUERY]」匹配的结果',
        one_result: '[COUNT] 个结果 ·「[QUERY]」',
        many_results: '[COUNT] 个结果 ·「[QUERY]」',
        searching: '检索中…',
        error_searching: '检索出错，请重试',
      },
    });

    // default-ui 渲染的是文本「清空」按钮；替换为上一版的圆圈 ×
    const input = mountEl.querySelector('.pagefind-ui__search-input');
    const nativeClear = mountEl.querySelector('.pagefind-ui__search-clear');
    if (!input) return;

    const clearBtn = document.createElement('button');
    clearBtn.type = 'button';
    clearBtn.className = 'search-clear';
    clearBtn.setAttribute('aria-label', '清空检索');
    clearBtn.innerHTML =
      '<svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">' +
      '<path d="M1 1l10 10M11 1L1 11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>' +
      '</svg>';
    mountEl.appendChild(clearBtn);

    const sync = () => {
      clearBtn.hidden = !input.value;
    };
    input.addEventListener('input', sync);
    clearBtn.addEventListener('click', () => {
      /* 优先走 default-ui 自己的清除逻辑；若不存在则手动清空并触发 input */
      if (nativeClear) nativeClear.click();
      else {
        input.value = '';
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
      input.focus();
      sync();
    });
    sync();
  }

  /* dev 也挂载：cactus 原版在 dev 直接 return 不装 UI，但 dev 看不到真实
     版式等于盲区。改为 dev 照常挂载输入框、状态行解释「无索引」；输入后
     UI 内部报「检索出错」是 dev 预期行为（/pagefind/ 产物只在构建链生成）。 */
  if (import.meta.env.DEV) {
    show(statusEl);
    statusEl.textContent = 'dev 模式无索引 · 全文检索在构建产物 / 线上可用';
  }
  if (mountEl) {
    mountSearch().catch((err) => {
      /* 生产环境把真实错误外显（含 chunk 加载失败），不静默吞掉 */
      console.error('[blog-search] 检索 UI 挂载失败：', err);
      show(statusEl);
      statusEl.textContent = `检索 UI 加载失败：${err?.message ?? err}`;
    });
  }
</script>

<style>
  .sheet {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--c-paper);
    color: var(--c-ink);
    font-family: "Noto Sans CJK SC", "Source Han Sans SC", "PingFang SC",
      "Microsoft YaHei", sans-serif;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 22px clamp(20px, 4vw, 48px);
    border-bottom: 1px solid rgba(var(--c-ink-rgb), 0.16);
  }
  .tag {
    font-family: "Archivo Black", "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border: 1px solid var(--c-ink);
    border-radius: 4px;
  }
  .tag--red {
    border-color: var(--c-red);
    color: var(--c-red);
  }
  .tag--link {
    color: var(--c-muted);
    border-color: rgba(var(--c-ink-rgb), 0.3);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .tag--link:hover {
    color: var(--c-red);
    border-color: var(--c-red);
  }
  .back {
    margin-left: auto;
    font-size: 13px;
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--c-ink-rgb), 0.4);
    padding-bottom: 2px;
  }
  .back:hover { color: var(--c-red); border-color: var(--c-red); }

  /* ── 页头横幅（2026-09-12 两件套分层）──
     横幅底（文字 + 基线 + 地面阴影）与人物层是两张独立图，按精配准落点
     以百分比定位。容器锁死 aspect-ratio 2/1（与素材同比例），任何视口
     宽度下两层都逐像素对齐，不随缩放漂移。 */
  .hero {
    padding: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .hero-band {
    position: relative;
    width: 100%;
    /* 桌面收窄（2026-09-12 用户反馈：全宽 2:1 太高，把下方文字挤出首屏）。
       860px 下高 430px；横幅纸色与页面同色，收窄后无可见接缝。
       移动端视口 < 860px 不受影响。 */
    max-width: 860px;
    margin-inline: auto;
    aspect-ratio: 2 / 1;
  }
  .hero-band__bg,
  .hero-band__char {
    position: absolute;
    display: block;
  }
  .hero-band__bg {
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* 落点 = 抠图内容在横幅 2048x1024 中的配准矩形（见 .tmp/prep_blog_header.py）；
     +5px 右移（2026-09-12 用户裁定）：原位发丝微挡 NOTES 的 S，绝对像素值各端一致 */
  .hero-band__char {
    left: calc(56.2012% + 5px);
    top: 4.4922%;
    width: 31.0059%;
    height: 91.1133%;
  }

  /* ── 文章列表区 ── */
  .list-section {
    flex: 1;
    padding: 26px clamp(20px, 4vw, 48px) 6px;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list--archive {
    border-bottom: 1px solid rgba(var(--c-ink-rgb), 0.16);
  }

	/* ── 全文检索（方案二：default-ui 挂载点，官方 CSS 变量对齐档案馆风）── */
	.searchbar {
		padding: 20px clamp(20px, 4vw, 48px) 0;
	}
	.search-mount {
		position: relative;
		--pagefind-ui-scale: 0.95;
		--pagefind-ui-primary: var(--c-red);
		--pagefind-ui-text: var(--c-ink);
		--pagefind-ui-background: transparent;
		--pagefind-ui-border: rgba(var(--c-ink-rgb), 0.4);
		--pagefind-ui-tag: var(--c-muted);
		--pagefind-ui-border-width: 1.5px;
		--pagefind-ui-border-radius: 6px;
		--pagefind-ui-font: inherit;
		min-height: 46px;
	}
	.search-status {
		margin: 10px 2px 0;
		font-size: 12px;
		letter-spacing: 0.06em;
		color: var(--c-muted);
	}
	/* 自定义圆圈 × 清除按钮：替代 default-ui 的文本「清空」按钮 */
	.search-clear {
		position: absolute;
		top: 50%;
		right: 13px;
		transform: translateY(-50%);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 26px;
		height: 26px;
		padding: 0;
		border: 1.5px solid rgba(var(--c-ink-rgb), 0.3);
		border-radius: 50%;
		background: transparent;
		color: var(--c-muted);
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease, transform 0.25s ease;
		z-index: 1;
	}
	.search-clear:hover {
		color: var(--c-red);
		border-color: var(--c-red);
		transform: translateY(-50%) rotate(90deg);
	}
	.search-clear:focus-visible {
		outline: none;
		color: var(--c-red);
		border-color: var(--c-red);
	}
	/* 用 hidden 切换设了 display 的元素必须配强规则（作者样式压过 UA 的 [hidden]） */
	.search-clear[hidden] {
		display: none !important;
	}
	/* 隐藏 default-ui 自带的文本「清空」按钮，统一使用自定义圆圈 × */
	.search-mount .pagefind-ui__search-clear {
		display: none !important;
	}

  /* ── 年份分隔条（票04）：Anton 描边数字，与 hero 同一视觉语言 ──
     收尾线只在末组保留，避免多组时组间出现重复横线（code-review 修正） */
  .year-group .list--archive {
    border-bottom: none;
  }
  .year-group:last-child .list--archive {
    border-bottom: 1px solid rgba(var(--c-ink-rgb), 0.16);
  }
  .year-group + .year-group {
    margin-top: 14px;
  }
  .year {
    margin: 20px 0 0;
    font-family: 'Anton', Impact, sans-serif;
    font-size: 24px;
    line-height: 1;
    letter-spacing: 0.06em;
    color: transparent;
    -webkit-text-stroke: 1px var(--c-ghost);
    user-select: none;
  }
  .year-group:first-child .year {
    margin-top: 0;
  }

  .stamp {
    align-self: center;
    margin-bottom: 40px;
    padding: 14px 26px;
    border: 2px solid var(--c-red);
    border-radius: 6px;
    color: var(--c-red);
    text-align: center;
    transform: rotate(-2.5deg);
  }
  .stamp strong {
    display: block;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.22em;
  }
  .stamp small {
    display: block;
    margin-top: 6px;
    font-size: 11px;
    letter-spacing: 0.14em;
  }

  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 clamp(20px, 4vw, 48px) 26px;
  }
  .foot .dash {
    width: 34px;
    height: 5px;
    background: var(--c-red);
  }
  .foot .barcode {
    height: 14px;
    width: 64px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--c-ink) 0 1px,
      transparent 1px 2.4px,
      var(--c-ink) 2.4px 4.4px,
      transparent 4.4px 5.4px,
      var(--c-ink) 5.4px 6.4px,
      transparent 6.4px 8.4px
    );
  }
</style>

