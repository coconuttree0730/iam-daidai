---
// 博客列表页（分页版，2026-09-12 升级）：/blog/ 第 1 页，/blog/2、/blog/3… 后续页。
// 由原 blog.astro 重命名迁移而来（路由升级为 paginate，12 篇/页，与 Cactus 一致）。
// 档案风骨架沿用：NO.03 编号头 + NOTES 描边大字 + 页脚条码；head 增加标签/RSS 入口。
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/utils';
import PageHead from '../../components/PageHead.astro';
import Paginator from '../../components/Paginator.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts, groupPostsByYear, splitFeaturedPosts } from '../../data/posts';
/* default-ui 的组件样式是独立 CSS（JS 里不含样式，漏引 = 输入框裸原生样式，
   2026-09-12 dev 截图暴露的正是这个，线上同样会裸）。类名前缀 pagefind-ui，
   不会污染站内样式；.search-mount 上的 --pagefind-ui-* 变量负责主题换肤。 */
import '@pagefind/default-ui/css/ui.css';
import '../../styles/sheet.css';
import '../../styles/archive-chrome.css';
import '../../styles/blog-list.css';

export async function getStaticPaths({ paginate }) {
	const posts = await getSortedPosts();
	return paginate(posts, { params: {}, pageSize: 12 });
}

const { page } = Astro.props;

/* 置顶精选（2026-09-14 建）：featured 的文章单独成组排在最前，**不参与年份分组**
   ——否则会散落到各自年份里失去置顶意义。
   ⚠️ 分页边界：featured 只在**第 1 页**抽出。第 2 页起若继续抽 featured 会得到
   空组（第一篇就已被拿走了）；而且置顶的意义本就是"首屏可见"。
   故用 page.currentPage === 1 门控，其余页只走年份分组。 */
const isFirstPage = page.currentPage === 1;
const { featured, rest } = splitFeaturedPosts(page.data);
const featuredItems = isFirstPage ? featured : [];
const listItems = isFirstPage ? rest : page.data;

// 按年分组（编号序列不再需要，2026-09-12 用户裁定：文档标签保留时间，去掉 NO.xx）
const yearGroups = groupPostsByYear(listItems).map(([year, posts]) => ({
	year,
	items: posts,
}));
const t = useTranslations('zh');

---
<Base title="Daidai档案馆" description="博客板块 · 文章归档">
  <main class="sheet" id="main">
    <PageHead
      no="NO.03"
      chips={[
        { label: '分类', href: '/categories/' },
        { label: '标签', href: '/tags/' },
        { label: 'RSS', href: '/rss.xml' },
      ]}
      back={{ label: t('head.backHome'), href: '/' }}
    />

    {/* 页头横幅三件套（2026-09-12 晚升级）：横幅底 + 独立地面阴影 + Q版人物层。
        横幅底：纸色重映射为站纸 var(--c-paper)、内嵌人物与地面阴影已剥离（.tmp/prep_blog_header.py）；
        阴影层：从横幅反解的 RGBA（.tmp/split 逻辑并入 prep 脚本 3c 步），可独立位移；
        人物层：Q版贴纸风插画（源 temp/图片优化-character.png，alpha 裁边后 1279x1950）。
        h1 转视觉隐藏保语义 */}
    <section class="hero">
      <h1 class="sr-only">博客</h1>
      <div class="hero-band">
        <img
          class="hero-band__bg"
          src="/motion/blog-banner.webp"
          alt=""
          width="2048"
          height="1024"
          loading="eager"
          decoding="async"
        />
        <img
          class="hero-band__shadow"
          src="/motion/blog-shadow.webp"
          alt=""
          width="760"
          height="76"
          loading="eager"
          decoding="async"
        />
        <img
          class="hero-band__char"
          src="/motion/blog-character-chibi.webp"
          alt=""
          width="1279"
          height="1950"
          loading="eager"
          decoding="async"
        />
      </div>
    </section>

    <section class="searchbar" aria-label={t('blog.search')}>
      <div
        class="search-mount"
        id="search-mount"
        data-pf-i18n={JSON.stringify({
          placeholder: t('blog.searchPlaceholder'),
          clear: t('blog.clear'),
          loadMore: t('blog.loadMore'),
          search: t('blog.search'),
          filter: t('blog.filter'),
          zero: t('blog.noResult'),
          count: t('blog.count'),
          clearSearch: t('blog.clearAria'),
          searching: t('blog.searching'),
          searchErr: t('blog.searchErr'),
        })}
      ></div>
      <p class="search-status" data-search-status hidden></p>
    </section>

    {
      page.data.length === 0 ? (
        <section class="stamp" aria-label={t('empty.archiving')}>
          <strong>{t('empty.archiving')}</strong>
          <small>{t('empty.archivingNote')}</small>
        </section>
      ) : (
        <section class="list-section" data-list aria-label={t('blog.listAria')}>
          {/* 置顶精选组（2026-09-14）：只在第 1 页、且确实有 featured 文章时渲染。
              标题用「精选 / FEATURED」而不是年份——它是编辑推荐，不表达时间。 */}
          {featuredItems.length > 0 && (
            <section class="year-group year-group--featured">
              <h2 class="year year--featured">
                <span class="year__star" aria-hidden="true">★</span>
                精选 / FEATURED
              </h2>
              <ul class="list list--archive" role="list">
                {featuredItems.map((post) => (
                  <li>
                    <PostCard post={post} />
                  </li>
                ))}
              </ul>
            </section>
          )}

          {yearGroups.map(({ year, items }) => (
            <section class="year-group">
              <h2 class="year">{year}</h2>
              <ul class="list list--archive" role="list">
                {items.map((post) => (
                  <li>
                    <PostCard post={post} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <Paginator page={page} locale="zh" />
        </section>
      )
    }

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<script>
  /* ── 站内全文检索（Pagefind）──
     方案二（2026-09-12 用户裁定）：@pagefind/default-ui 构建时打包成独立
     chunk，运行时由 UI 内部按需加载 /pagefind/ 索引产物（bundlePath）。
     输入框右侧的圆圈 × 为自定义按钮，替代 default-ui 的文本「清空」按钮。 */
  const mountEl = document.getElementById('search-mount');
  const statusEl = document.querySelector('[data-search-status]');
  const show = (el) => el && el.removeAttribute('hidden');

  /* 检索框文案（第 2 期双语化）：SSR 写进 data-pf-i18n 的 JSON。
     script 引用不到 frontmatter 的 t()，只能序列化后读回来；
     解析失败时下面每一项都留着中文兜底，页面不会出现裸键名。 */
  let PF = {};
  try {
    PF = JSON.parse(mountEl?.dataset.pfI18n || '{}');
  } catch {
    PF = {};
  }
  const pf = (k, fallback) => PF[k] ?? fallback;

  async function mountSearch() {
    const { PagefindUI } = await import('@pagefind/default-ui');
    new PagefindUI({
      element: mountEl,
      bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
      /* resetStyles 默认 true 会向 <head> 注入全局重置，可能波及站内样式，关掉 */
      resetStyles: false,
      showSubResults: true,
      excerptLength: 20,
      /* 文案来自 data-pf-i18n（SSR 写进的 JSON）。script 里不能引用 frontmatter
         的 t()，只能序列化后读回来。解析失败时逐项都有兜底。 */
      translations: {
        placeholder: pf('placeholder', '检索文章全文…'),
        clear_search: pf('clear', '清空'),
        load_more: pf('loadMore', '加载更多'),
        search_label: pf('search', '站内全文检索'),
        filters_label: pf('filter', '过滤'),
        /* 占位符必须是 default-ui 的令牌：它只做
           `.replace(/\[SEARCH_TERM\]/)` 与 `.replace(/\[COUNT\]/)`，
           旧文案写的 [QUERY] 原样印在页面上（2026-09-13 用户截图暴露）。 */
        zero_results: pf('zero', '没有与「[SEARCH_TERM]」匹配的结果'),
        one_result: pf('count', '[COUNT] 个结果 ·「[SEARCH_TERM]」'),
        many_results: pf('count', '[COUNT] 个结果 ·「[SEARCH_TERM]」'),
        searching: pf('searching', '检索中…'),
        error_searching: pf('searchErr', '检索出错，请重试'),
      },
    });

    // default-ui 渲染的是文本「清空」按钮；替换为上一版的圆圈 ×
    const input = mountEl.querySelector('.pagefind-ui__search-input');
    const nativeClear = mountEl.querySelector('.pagefind-ui__search-clear');
    if (!input) return;

    /* 圆圈 × 挂进 default-ui 的 <form> 而不是 .search-mount：form 是
       position:relative 且顶边 == 输入框顶边，绝对定位才能钉在输入框行内；
       .search-mount 把结果抽屉也包在内（结果区在 form 里），随结果长高会把
       绝对定位的按钮一路带下去——2026-09-13 用户截图里的「下方方块 ×」
       就是这个按钮既没拿到样式、又落在了结果区之下。 */
    const anchor = mountEl.querySelector('.pagefind-ui__form') ?? mountEl;

    const clearBtn = document.createElement('button');
    clearBtn.type = 'button';
    clearBtn.className = 'search-clear';
    clearBtn.title = pf('clearSearch', '清空检索');
    clearBtn.setAttribute('aria-label', pf('clearSearch', '清空检索'));
    clearBtn.innerHTML =
      '<svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">' +
      '<path d="M1 1l10 10M11 1L1 11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>' +
      '</svg>';
    anchor.appendChild(clearBtn);

    const sync = () => {
      clearBtn.hidden = !input.value;
    };
    input.addEventListener('input', sync);
    clearBtn.addEventListener('click', () => {
      /* 优先走 default-ui 自己的清除逻辑（清 val + 收起结果抽屉，节点常驻
         DOM 只是被 suppressed 透明化，故引用长期有效）；失败则手动清空 +
         派发 input 让 UI 走同一条响应链。 */
      if (nativeClear?.isConnected) nativeClear.click();
      if (input.value) {
        input.value = '';
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
      input.focus();
      sync();
    });
    sync();
  }

  /* dev 也挂载：cactus 原版在 dev 直接 return 不装 UI，但 dev 看不到真实
     版式等于盲区。改为 dev 照常挂载输入框、状态行解释「无索引」；输入后
     UI 内部报「检索出错」是 dev 预期行为（/pagefind/ 产物只在构建链生成）。 */
  if (import.meta.env.DEV) {
    show(statusEl);
    statusEl.textContent = 'dev 模式无索引 · 全文检索在构建产物 / 线上可用';
  }
  if (mountEl) {
    mountSearch().catch((err) => {
      /* 生产环境把真实错误外显（含 chunk 加载失败），不静默吞掉 */
      console.error('[blog-search] 检索 UI 挂载失败：', err);
      show(statusEl);
      statusEl.textContent = `检索 UI 加载失败：${err?.message ?? err}`;
    });
  }
</script>

<style>
  /* 版式已抽到 src/styles/blog-list.css（i18n 时为英文版共享）。
     本页如需页面专有样式，写在这里。 */
</style>

