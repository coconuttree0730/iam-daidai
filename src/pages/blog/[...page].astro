---
// 博客列表页（分页版，2026-09-12 升级）：/blog/ 第 1 页，/blog/2、/blog/3… 后续页。
// 由原 blog.astro 重命名迁移而来（路由升级为 paginate，12 篇/页，与 Cactus 一致）。
// 档案风骨架沿用：NO.03 编号头 + NOTES 描边大字 + 页脚条码；head 增加标签/RSS 入口。
import Base from '../../layouts/Base.astro';
import Paginator from '../../components/Paginator.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts, groupPostsByYear } from '../../data/posts';

export async function getStaticPaths({ paginate }) {
	const posts = await getSortedPosts();
	return paginate(posts, { params: {}, pageSize: 12 });
}

const { page } = Astro.props;

// 按年分组 + 跨页连续编号（2026-09-12 票04）：NO.XX 按全量排序位次
// （第 n 页自 page.start 续起），年份分隔只是页内视觉结构，不改编号序列。
let noSeq = page.start;
const yearGroups = groupPostsByYear(page.data).map(([year, posts]) => ({
	year,
	items: posts.map((post) => ({ post, no: String(noSeq++).padStart(2, '0') })),
}));
---
<Base title="Daidai档案馆" description="博客板块 · 文章归档">
  <main class="sheet">
    <header class="head">
      <span class="tag">NO.03</span>
      <span class="tag tag--red">密级 公开</span>
      <a class="tag tag--link" href="/tags/">标签</a>
      <a class="tag tag--link" href="/rss.xml">RSS</a>
      <a class="back" href="/">← 返回档案馆</a>
    </header>

    <section class:list={['hero', { 'hero--compact': page.data.length > 0 }]}>
      <p class="en" aria-hidden="true">NOTES</p>
      <h1>博客</h1>
    </section>

    <section class="searchbar" aria-label="全文检索">
      <div class="search-wrap">
        <input
          class="search-input"
          type="search"
          placeholder="检索文章全文…"
          aria-label="检索文章全文"
          spellcheck="false"
          autocomplete="off"
        />
        <button class="search-clear" type="button" aria-label="清空检索" hidden>
          <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
            <path
              d="M1 1l10 10M11 1L1 11"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <p class="search-status" data-search-status hidden></p>
    </section>
    <section class="search-results" data-search-results hidden></section>

    {
      page.data.length === 0 ? (
        <section class="stamp" aria-label="档案整理中">
          <strong>档案整理中</strong>
          <small>ARCHIVING · 该板块即将开放</small>
        </section>
      ) : (
        <section class="list-section" data-list aria-label="文章列表">
          {yearGroups.map(({ year, items }) => (
            <section class="year-group">
              <h2 class="year">{year}</h2>
              <ul class="list list--archive" role="list">
                {items.map(({ post, no }) => (
                  <li>
                    <PostCard post={post} no={no} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <Paginator page={page} />
        </section>
      )
    }

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<script>
  /* ── 站内全文检索（Pagefind，2026-09-12 票：博客功能补完）──
     索引由构建链 `pagefind --site dist` 生成，data-pagefind-body 已把索引
     限定在文章正文。UI 手写：输入 ≥1 字符进入搜索态（隐藏分组列表、
     渲染结果行），清空恢复；pagefind.js 首次输入时才懒加载。 */
  const input = document.querySelector('.search-input');
  const statusEl = document.querySelector('[data-search-status]');
  const resultsEl = document.querySelector('[data-search-results]');
  const listEl = document.querySelector('[data-list]');
  const clearBtn = document.querySelector('.search-clear');
  let pagefind = null;
  let timer = 0;

  const show = (el) => el && el.removeAttribute('hidden');
  const hide = (el) => el && el.setAttribute('hidden', '');

  async function ensurePagefind() {
    if (!pagefind) {
      /* specifier 必须保持「非字面量」（变量拼接）：dev 的 vite:import-analysis
         对字面量 specifier 的动态 import 会无条件静态 resolve，@vite-ignore 在该
         路径不生效（它只抑制非字面量 import 的 warning）→ dev 撞
         "Failed to resolve import"。非字面量则落入「无法分析 → 原样放行」分支；
         build 侧 rollup 见 @vite-ignore 同样放行，运行时命中 dist/pagefind/。 */
      const PF_ENTRY = '/pagefind/' + 'pagefind.js';
      pagefind = await import(/* @vite-ignore */ PF_ENTRY);
      await pagefind.options({ excerptLength: 20 });
    }
    return pagefind;
  }

  function renderResults(items) {
    resultsEl.innerHTML = '';
    const ul = document.createElement('ul');
    ul.className = 'slist';
    for (const r of items) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'srow';
      a.href = r.url;
      const t = document.createElement('span');
      t.className = 'stitle';
      t.textContent = r.meta?.title ?? r.url;
      const x = document.createElement('span');
      x.className = 'sexcerpt';
      /* excerpt 含 <mark> 高亮，源自本站构建产物，可信 */
      x.innerHTML = r.excerpt;
      a.append(t, x);
      li.appendChild(a);
      ul.appendChild(li);
    }
    resultsEl.appendChild(ul);
  }

  async function run() {
    const q = input.value.trim();
    if (!q) {
      hide(statusEl);
      hide(resultsEl);
      show(listEl);
      return;
    }
    try {
      const pf = await ensurePagefind();
      const res = await pf.search(q);
      const items = await Promise.all(
        res.results.slice(0, 20).map((r) => r.data()),
      );
      show(statusEl);
      show(resultsEl);
      hide(listEl);
      if (items.length === 0) {
        statusEl.textContent = `无结果 ·「${q}」`;
        resultsEl.innerHTML = '';
        return;
      }
      statusEl.textContent = `${res.results.length} 个结果 ·「${q}」`;
      renderResults(items);
    } catch {
      show(statusEl);
      statusEl.textContent = '全文检索在构建产物 / 线上可用 · dev 模式无索引';
      hide(resultsEl);
      show(listEl);
    }
  }

  /* 清除按钮：随输入显隐；点击清空并立即恢复列表态（不走 220ms 防抖） */
  const syncClear = () => {
    if (clearBtn) clearBtn.hidden = !input.value;
  };
  /* webkit type=search 的 Escape 清空触发 search 事件，不一定触发 input */
  input?.addEventListener('search', syncClear);
  input?.addEventListener('input', () => {
    syncClear();
    clearTimeout(timer);
    timer = setTimeout(run, 220);
  });
  clearBtn?.addEventListener('click', () => {
    input.value = '';
    syncClear();
    clearTimeout(timer);
    input.focus();
    run();
  });
</script>

<style>
  .sheet {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #eeedeb;
    color: #131211;
    font-family: "Noto Sans CJK SC", "Source Han Sans SC", "PingFang SC",
      "Microsoft YaHei", sans-serif;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 22px clamp(20px, 4vw, 48px);
    border-bottom: 1px solid rgba(19, 18, 17, 0.16);
  }
  .tag {
    font-family: "Archivo Black", "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border: 1px solid #131211;
    border-radius: 4px;
  }
  .tag--red {
    border-color: #cf0a1a;
    color: #cf0a1a;
  }
  .tag--link {
    color: #6f6f6f;
    border-color: rgba(19, 18, 17, 0.3);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .tag--link:hover {
    color: #cf0a1a;
    border-color: #cf0a1a;
  }
  .back {
    margin-left: auto;
    font-size: 13px;
    color: #131211;
    text-decoration: none;
    border-bottom: 1px solid rgba(19, 18, 17, 0.4);
    padding-bottom: 2px;
  }
  .back:hover { color: #cf0a1a; border-color: #cf0a1a; }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 48px 20px;
    text-align: center;
  }
  /* 有文章时收窄 hero 占比，让列表成为主体 */
  .hero--compact {
    flex: 0 0 auto;
    padding: 42px 20px 12px;
  }
  .hero .en {
    margin: 0;
    font-family: "Anton", Impact, sans-serif;
    font-size: clamp(28px, 6vw, 72px);
    line-height: 1;
    letter-spacing: 0.04em;
    color: transparent;
    -webkit-text-stroke: 1.2px #c3c1be;
    user-select: none;
  }
  .hero h1 {
    margin: 0;
    font-weight: 900;
    font-size: clamp(34px, 7vw, 84px);
    line-height: 1;
    letter-spacing: 0.02em;
  }

  /* ── 文章列表区 ── */
  .list-section {
    flex: 1;
    padding: 26px clamp(20px, 4vw, 48px) 6px;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list--archive {
    border-bottom: 1px solid rgba(19, 18, 17, 0.16);
  }

  /* ── 全文检索（输入框在模板，结果行由脚本注入 → 结果行用 :global）── */
  .searchbar {
    padding: 20px clamp(20px, 4vw, 48px) 0;
  }
  .search-wrap {
    position: relative;
  }
  .search-input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 52px 12px 16px;
    border: 1.5px solid rgba(19, 18, 17, 0.4);
    border-radius: 6px;
    background: transparent;
    font: inherit;
    font-size: 15px;
    letter-spacing: 0.02em;
    color: inherit;
  }
  .search-input:focus {
    outline: none;
    border-color: #cf0a1a;
  }
  /* 原生清除按钮样式不可控（webkit 默认 ×，颜色不随主题），隐藏后用自定义按钮 */
  .search-input::-webkit-search-cancel-button,
  .search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }
  .search-clear {
    position: absolute;
    top: 50%;
    right: 13px;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 1.5px solid rgba(19, 18, 17, 0.3);
    border-radius: 50%;
    background: transparent;
    color: #6f6f6f;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.25s ease;
  }
  .search-clear:hover {
    color: #cf0a1a;
    border-color: #cf0a1a;
    transform: translateY(-50%) rotate(90deg);
  }
  .search-clear:focus-visible {
    outline: none;
    color: #cf0a1a;
    border-color: #cf0a1a;
  }
  /* 用 hidden 切换设了 display 的元素必须配强规则（作者样式压过 UA 的 [hidden]） */
  .search-clear[hidden] {
    display: none !important;
  }
  .search-status {
    margin: 10px 2px 0;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #6f6f6f;
  }
  .search-results {
    padding: 12px clamp(20px, 4vw, 48px) 6px;
  }
  .search-results :global(.slist) {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid rgba(19, 18, 17, 0.16);
  }
  .search-results :global(.srow) {
    display: block;
    padding: 14px 2px;
    border-top: 1px solid rgba(19, 18, 17, 0.16);
    color: inherit;
    text-decoration: none;
  }
  .search-results :global(.stitle) {
    display: block;
    font-weight: 900;
    font-size: 16px;
    line-height: 1.4;
  }
  .search-results :global(.srow:hover .stitle) {
    text-decoration: underline;
    text-decoration-color: #cf0a1a;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .search-results :global(.sexcerpt) {
    display: block;
    margin-top: 4px;
    font-size: 12.5px;
    line-height: 1.7;
    color: #6f6f6f;
  }
  .search-results :global(.sexcerpt mark) {
    background: rgba(207, 10, 26, 0.14);
    color: #cf0a1a;
    padding: 0 2px;
    border-radius: 2px;
  }

  /* ── 年份分隔条（票04）：Anton 描边数字，与 hero 同一视觉语言 ──
     收尾线只在末组保留，避免多组时组间出现重复横线（code-review 修正） */
  .year-group .list--archive {
    border-bottom: none;
  }
  .year-group:last-child .list--archive {
    border-bottom: 1px solid rgba(19, 18, 17, 0.16);
  }
  .year-group + .year-group {
    margin-top: 14px;
  }
  .year {
    margin: 20px 0 0;
    font-family: 'Anton', Impact, sans-serif;
    font-size: 24px;
    line-height: 1;
    letter-spacing: 0.06em;
    color: transparent;
    -webkit-text-stroke: 1px #c3c1be;
    user-select: none;
  }
  .year-group:first-child .year {
    margin-top: 0;
  }

  .stamp {
    align-self: center;
    margin-bottom: 40px;
    padding: 14px 26px;
    border: 2px solid #cf0a1a;
    border-radius: 6px;
    color: #cf0a1a;
    text-align: center;
    transform: rotate(-2.5deg);
  }
  .stamp strong {
    display: block;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.22em;
  }
  .stamp small {
    display: block;
    margin-top: 6px;
    font-size: 11px;
    letter-spacing: 0.14em;
  }

  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 clamp(20px, 4vw, 48px) 26px;
  }
  .foot .dash {
    width: 34px;
    height: 5px;
    background: #cf0a1a;
  }
  .foot .barcode {
    height: 14px;
    width: 64px;
    background-image: repeating-linear-gradient(
      90deg,
      #131211 0 1px,
      transparent 1px 2.4px,
      #131211 2.4px 4.4px,
      transparent 4.4px 5.4px,
      #131211 5.4px 6.4px,
      transparent 6.4px 8.4px
    );
  }
</style>

