---
// 博客列表页（分页版，2026-09-12 升级）：/blog/ 第 1 页，/blog/2、/blog/3… 后续页。
// 由原 blog.astro 重命名迁移而来（路由升级为 paginate，12 篇/页，与 Cactus 一致）。
// 档案风骨架沿用：NO.03 编号头 + NOTES 描边大字 + 页脚条码；head 增加标签/RSS 入口。
import Base from '../../layouts/Base.astro';
import Paginator from '../../components/Paginator.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts, groupPostsByYear } from '../../data/posts';
/* default-ui 的组件样式是独立 CSS（JS 里不含样式，漏引 = 输入框裸原生样式，
   2026-09-12 dev 截图暴露的正是这个，线上同样会裸）。类名前缀 pagefind-ui，
   不会污染站内样式；.search-mount 上的 --pagefind-ui-* 变量负责主题换肤。 */
import '@pagefind/default-ui/css/ui.css';

export async function getStaticPaths({ paginate }) {
	const posts = await getSortedPosts();
	return paginate(posts, { params: {}, pageSize: 12 });
}

const { page } = Astro.props;

// 按年分组 + 跨页连续编号（2026-09-12 票04）：NO.XX 按全量排序位次
// （第 n 页自 page.start 续起），年份分隔只是页内视觉结构，不改编号序列。
let noSeq = page.start;
const yearGroups = groupPostsByYear(page.data).map(([year, posts]) => ({
	year,
	items: posts.map((post) => ({ post, no: String(noSeq++).padStart(2, '0') })),
}));
---
<Base title="Daidai档案馆" description="博客板块 · 文章归档">
  <main class="sheet">
    <header class="head">
      <span class="tag">NO.03</span>
      <span class="tag tag--red">密级 公开</span>
      <a class="tag tag--link" href="/tags/">标签</a>
      <a class="tag tag--link" href="/rss.xml">RSS</a>
      <a class="back" href="/">← 返回档案馆</a>
    </header>

    <section class:list={['hero', { 'hero--compact': page.data.length > 0 }]}>
      <p class="en" aria-hidden="true">NOTES</p>
      <h1>博客</h1>
    </section>

    <section class="searchbar" aria-label="全文检索">
      <div class="search-mount" id="search-mount"></div>
      <p class="search-status" data-search-status hidden></p>
    </section>

    {
      page.data.length === 0 ? (
        <section class="stamp" aria-label="档案整理中">
          <strong>档案整理中</strong>
          <small>ARCHIVING · 该板块即将开放</small>
        </section>
      ) : (
        <section class="list-section" data-list aria-label="文章列表">
          {yearGroups.map(({ year, items }) => (
            <section class="year-group">
              <h2 class="year">{year}</h2>
              <ul class="list list--archive" role="list">
                {items.map(({ post, no }) => (
                  <li>
                    <PostCard post={post} no={no} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <Paginator page={page} />
        </section>
      )
    }

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<script>
  /* ── 站内全文检索（Pagefind）──
     方案二（2026-09-12 用户裁定）：@pagefind/default-ui 构建时打包成独立
     chunk，运行时由 UI 内部按需加载 /pagefind/ 索引产物（bundlePath）。
     相对手写 UI（原方案一）：UI 成熟度（键盘导航/过滤/可访问性）更高，
     后端加载链与其完全同构，无额外故障面；代价是 +37KB gzip chunk 与
     DOM 定制受限（只能改官方 CSS 变量）。
     dev 下无索引 → import.meta.env.DEV 门控直接不挂载（构建期折叠，
     生产包不含 dev 分支），提示由 .search-status 承载。 */
  const mountEl = document.getElementById('search-mount');
  const statusEl = document.querySelector('[data-search-status]');
  const show = (el) => el && el.removeAttribute('hidden');

  async function mountSearch() {
    const { PagefindUI } = await import('@pagefind/default-ui');
    new PagefindUI({
      element: mountEl,
      bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
      /* resetStyles 默认 true 会向 <head> 注入全局重置，可能波及站内样式，关掉 */
      resetStyles: false,
      showSubResults: true,
      excerptLength: 20,
      translations: {
        placeholder: '检索文章全文…',
        clear_search: '清空',
        load_more: '加载更多',
        search_label: '站内全文检索',
        filters_label: '过滤',
        zero_results: '没有与「[QUERY]」匹配的结果',
        one_result: '[COUNT] 个结果 ·「[QUERY]」',
        many_results: '[COUNT] 个结果 ·「[QUERY]」',
        searching: '检索中…',
        error_searching: '检索出错，请重试',
      },
    });
  }

  /* dev 也挂载（2026-09-12 用户反馈「输入框怎么没有了」）：cactus 原版在
     dev 直接 return 不装 UI，但 dev 看不到真实版式等于盲区。改为 dev 照常
     挂载输入框、状态行解释「无索引」；输入后 UI 内部报「检索出错」是
     dev 预期行为（/pagefind/ 产物只在构建链生成）。 */
  if (import.meta.env.DEV) {
    show(statusEl);
    statusEl.textContent = 'dev 模式无索引 · 全文检索在构建产物 / 线上可用';
  }
  if (mountEl) {
    mountSearch().catch((err) => {
      /* 生产环境把真实错误外显（含 chunk 加载失败），不静默吞掉 */
      console.error('[blog-search] 检索 UI 挂载失败：', err);
      show(statusEl);
      statusEl.textContent = `检索 UI 加载失败：${err?.message ?? err}`;
    });
  }
</script>

<style>
  .sheet {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #eeedeb;
    color: #131211;
    font-family: "Noto Sans CJK SC", "Source Han Sans SC", "PingFang SC",
      "Microsoft YaHei", sans-serif;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 22px clamp(20px, 4vw, 48px);
    border-bottom: 1px solid rgba(19, 18, 17, 0.16);
  }
  .tag {
    font-family: "Archivo Black", "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border: 1px solid #131211;
    border-radius: 4px;
  }
  .tag--red {
    border-color: #cf0a1a;
    color: #cf0a1a;
  }
  .tag--link {
    color: #6f6f6f;
    border-color: rgba(19, 18, 17, 0.3);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .tag--link:hover {
    color: #cf0a1a;
    border-color: #cf0a1a;
  }
  .back {
    margin-left: auto;
    font-size: 13px;
    color: #131211;
    text-decoration: none;
    border-bottom: 1px solid rgba(19, 18, 17, 0.4);
    padding-bottom: 2px;
  }
  .back:hover { color: #cf0a1a; border-color: #cf0a1a; }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 48px 20px;
    text-align: center;
  }
  /* 有文章时收窄 hero 占比，让列表成为主体 */
  .hero--compact {
    flex: 0 0 auto;
    padding: 42px 20px 12px;
  }
  .hero .en {
    margin: 0;
    font-family: "Anton", Impact, sans-serif;
    font-size: clamp(28px, 6vw, 72px);
    line-height: 1;
    letter-spacing: 0.04em;
    color: transparent;
    -webkit-text-stroke: 1.2px #c3c1be;
    user-select: none;
  }
  .hero h1 {
    margin: 0;
    font-weight: 900;
    font-size: clamp(34px, 7vw, 84px);
    line-height: 1;
    letter-spacing: 0.02em;
  }

  /* ── 文章列表区 ── */
  .list-section {
    flex: 1;
    padding: 26px clamp(20px, 4vw, 48px) 6px;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list--archive {
    border-bottom: 1px solid rgba(19, 18, 17, 0.16);
  }

  /* ── 全文检索（方案二：default-ui 挂载点，官方 CSS 变量对齐档案馆风）── */
  .searchbar {
    padding: 20px clamp(20px, 4vw, 48px) 0;
  }
  .search-mount {
    --pagefind-ui-scale: 0.95;
    --pagefind-ui-primary: #cf0a1a;
    --pagefind-ui-text: #131211;
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: rgba(19, 18, 17, 0.4);
    --pagefind-ui-tag: #6f6f6f;
    --pagefind-ui-border-width: 1.5px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: inherit;
    min-height: 46px;
  }
  .search-status {
    margin: 10px 2px 0;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #6f6f6f;
  }

  /* ── 年份分隔条（票04）：Anton 描边数字，与 hero 同一视觉语言 ──
     收尾线只在末组保留，避免多组时组间出现重复横线（code-review 修正） */
  .year-group .list--archive {
    border-bottom: none;
  }
  .year-group:last-child .list--archive {
    border-bottom: 1px solid rgba(19, 18, 17, 0.16);
  }
  .year-group + .year-group {
    margin-top: 14px;
  }
  .year {
    margin: 20px 0 0;
    font-family: 'Anton', Impact, sans-serif;
    font-size: 24px;
    line-height: 1;
    letter-spacing: 0.06em;
    color: transparent;
    -webkit-text-stroke: 1px #c3c1be;
    user-select: none;
  }
  .year-group:first-child .year {
    margin-top: 0;
  }

  .stamp {
    align-self: center;
    margin-bottom: 40px;
    padding: 14px 26px;
    border: 2px solid #cf0a1a;
    border-radius: 6px;
    color: #cf0a1a;
    text-align: center;
    transform: rotate(-2.5deg);
  }
  .stamp strong {
    display: block;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.22em;
  }
  .stamp small {
    display: block;
    margin-top: 6px;
    font-size: 11px;
    letter-spacing: 0.14em;
  }

  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 clamp(20px, 4vw, 48px) 26px;
  }
  .foot .dash {
    width: 34px;
    height: 5px;
    background: #cf0a1a;
  }
  .foot .barcode {
    height: 14px;
    width: 64px;
    background-image: repeating-linear-gradient(
      90deg,
      #131211 0 1px,
      transparent 1px 2.4px,
      #131211 2.4px 4.4px,
      transparent 4.4px 5.4px,
      #131211 5.4px 6.4px,
      transparent 6.4px 8.4px
    );
  }
</style>

