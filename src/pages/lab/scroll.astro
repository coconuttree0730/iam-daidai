---
// 游乐场 · 滚动帧随动（/lab/scroll/）——原理解剖页（2026-09-14 重设计）
//
// 目的从「看演示」升级为「拆原理」：手机框（iframe）钉在左列 sticky，
// 右列是一串 SVG 剖图（实时透视 / 总管线 / 映射曲线 / 图集解剖 / 双层缓存 /
// 帧缓动），全部消费 iframe postMessage 回传的同一份数据——在手机里滑动，
// 每张剖图同步动起来：游标走曲线、格位跳图集、LRU 窗口滑段、Δ 值起伏。
//
// 演示 iframe（public/lab/scroll-demo.html）与线上 motion.js 同一套契约：
// 两层缓存（ArrayBuffer 全段常驻 + ImageBitmap LRU ±1）+ smoothDamp 追帧，
// 因此剖图讲的就是跑的，不是两回事。
//
// 主题：全页消费 --c-* 变量随昼夜翻转；唯独手机屏内保持浅纸底
// （--c-band 裁定，与 /lab/ 卡片封面同一条规则——透明人物在深底会糊成剪影）。
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/utils';
import PageHead from '../../components/PageHead.astro';

const t = useTranslations('zh');

const pad2 = (n: number) => String(n).padStart(2, '0');
const segs = Array.from({ length: 20 }, (_, i) => i);
const cells = Array.from({ length: 10 }, (_, k) => k);
const pTicks = [0, 0.25, 0.5, 0.75, 1];
const fTicks = [0, 48, 96, 144, 192];
/* 胶片条几何（SVG 与 JS 共用同一组数）：x_i = 26 + i * (28 + 3.6) */
const SX0 = 26, SW = 28, SG = 3.6;
const sx = (i: number) => SX0 + i * (SW + SG);
/* 映射曲线绘图区：x 64→616 对应 p 0→1，y 252→48 对应 f 0→192 */
const PX0 = 64, PW = 552, PY0 = 252, PH = 204;
---
<Base title="滚动帧随动 · 游乐场">
  <PageHead no="LAB-01" back={{ label: t('head.backLab'), href: '/lab/' }} />

  <main class="lab" id="main">
    <header class="lab-head">
      <h1>SCROLL / 滚动帧随动</h1>
      <span class="sub">LAB-01 · 193 FRAMES · 24FPS · RVM MATTING · 20 SEG WEBP</span>
      <p class="lede">
        把<b>滚动量</b>当时间轴：行程归一化成进度 p，线性映射目标帧 f*，smoothDamp
        追帧后按「段 + 格」从分段图集裁切上屏。左边手机里滑动——右侧六张剖图
        消费同一份数据，<b>全部实时跟着动</b>。
      </p>
    </header>

    <div class="layout">
      <!-- 左列：sticky 手机框（iframe 滚动隔离） -->
      <div class="stage-col">
        <div class="stage-sticky">
          <div class="phone">
            <div class="phone__viewport">
              <div class="phone__notch" aria-hidden="true"></div>
              <iframe
                class="phone__iframe"
                src="/lab/scroll-demo.html"
                scrolling="yes"
                sandbox="allow-scripts allow-same-origin"
                title="滚动帧随动演示"
              ></iframe>
              <div class="phone__swipe-hint" aria-hidden="true">
                ↑ 在手机内滚动 ↓
              </div>
            </div>
            <div class="phone__bar" aria-hidden="true"></div>
          </div>
          <p class="stage-cap">↑↓ 在手机内滑动 —— 右侧剖图实时联动</p>
        </div>
      </div>

      <!-- 右列：原理剖图 -->
      <div class="anatomy">
        <!-- 00 · 实时透视 -->
        <figure class="anat">
          <figcaption>
            <b>00</b><span class="t">实时透视</span><span class="en">LIVE READOUT</span>
          </figcaption>
          <div class="probe">
            <div class="probe__frame" aria-hidden="true">
              <span class="probe__f" data-live="frame">0</span>
              <span class="probe__ftotal">/ 192</span>
            </div>
            <div class="probe__body">
              <div class="probe__bar" aria-hidden="true"><i data-live="pbar"></i></div>
              <dl class="probe__rows">
                <div>
                  <dt>进度 p</dt>
                  <dd><span data-live="p">0.000</span></dd>
                </div>
                <div>
                  <dt>目标帧 f*</dt>
                  <dd><span data-live="ftarget">0</span></dd>
                </div>
                <div>
                  <dt>落位 段·格</dt>
                  <dd>s<span data-live="seg">00</span>·k<span data-live="cell">0</span></dd>
                </div>
                <div>
                  <dt>缓动 Δ</dt>
                  <dd><span data-live="delta">0.0</span> 帧</dd>
                </div>
              </dl>
            </div>
          </div>
        </figure>

        <!-- 01 · 总管线 -->
        <figure class="anat">
          <figcaption>
            <b>01</b><span class="t">总管线 · 一条直线讲完</span><span class="en">PIPELINE</span>
          </figcaption>
          <svg viewBox="0 0 680 168" role="img" aria-label="滚动位移到画面绘制的五步管线">
            <g class="pn">
              <rect x="6" y="26" width="118" height="104" rx="8"></rect>
              <text class="pn__t" x="18" y="52">滚动位移</text>
              <text class="pn__f" x="18" y="72">scrollY (px)</text>
              <text class="pn__v" x="18" y="108" data-live="scrollpx">0</text>
            </g>
            <g class="pn">
              <rect x="148" y="26" width="118" height="104" rx="8"></rect>
              <text class="pn__t" x="160" y="52">归一化进度</text>
              <text class="pn__f" x="160" y="72">clamp(y ÷ L) → [0,1]</text>
              <text class="pn__v" x="160" y="108" data-live="p2">0.000</text>
            </g>
            <g class="pn">
              <rect x="290" y="26" width="118" height="104" rx="8"></rect>
              <text class="pn__t" x="302" y="52">目标帧</text>
              <text class="pn__f" x="302" y="72">f* = p × 192</text>
              <text class="pn__v" x="302" y="108" data-live="ftarget2">0</text>
            </g>
            <g class="pn pn--live">
              <rect x="432" y="26" width="118" height="104" rx="8"></rect>
              <text class="pn__t" x="444" y="52">实际帧</text>
              <text class="pn__f" x="444" y="72">round(smoothDamp)</text>
              <text class="pn__v" x="444" y="108" data-live="frame2">0</text>
            </g>
            <g class="pn">
              <rect x="574" y="26" width="100" height="104" rx="8"></rect>
              <text class="pn__t" x="586" y="52">段 · 格</text>
              <text class="pn__f" x="586" y="72">⌊f ÷ 10⌋ · k</text>
              <text class="pn__v" x="586" y="108" data-live="segcell">s00·k0</text>
            </g>
            <line class="arr" x1="126" y1="78" x2="139" y2="78"></line>
            <polygon class="arrh" points="139,73 148,78 139,83"></polygon>
            <line class="arr" x1="268" y1="78" x2="281" y2="78"></line>
            <polygon class="arrh" points="281,73 290,78 281,83"></polygon>
            <line class="arr" x1="410" y1="78" x2="423" y2="78"></line>
            <polygon class="arrh" points="423,73 432,78 423,83"></polygon>
            <line class="arr" x1="552" y1="78" x2="565" y2="78"></line>
            <polygon class="arrh" points="565,73 574,78 565,83"></polygon>
            <text class="note" x="6" y="156">
              f* → f 之间是 smoothDamp 追帧；几何（docTop、行程 L）只在 resize
              时测一次 —— 滚动回调零强制布局，只做算术。
            </text>
          </svg>
        </figure>

        <!-- 02 · 映射曲线 -->
        <figure class="anat">
          <figcaption>
            <b>02</b><span class="t">映射曲线 · 滚动到帧号</span><span class="en">LINEAR CLAMP</span>
          </figcaption>
          <svg viewBox="0 0 680 300" role="img" aria-label="进度与帧号的线性钳制映射曲线，红点为实时位置">
            {
              fTicks.map((f) => (
                <line class="gridl" x1={PX0} y1={PY0 - (f / 192) * PH} x2={PX0 + PW} y2={PY0 - (f / 192) * PH} />
              ))
            }
            {
              pTicks.map((t) => (
                <text class="tk" x={PX0 + t * PW} y="272" text-anchor="middle">
                  {t}
                </text>
              ))
            }
            {
              fTicks.map((f) => (
                <text class="tk" x="56" y={PY0 - (f / 192) * PH + 4} text-anchor="end">
                  {f}
                </text>
              ))
            }
            <line class="axis" x1={PX0} y1="42" x2={PX0} y2={PY0}></line>
            <line class="axis" x1={PX0} y1={PY0} x2={PX0 + PW} y2={PY0}></line>
            <line class="diag" x1={PX0} y1={PY0} x2={PX0 + PW} y2={PY0 - PH}></line>
            <text class="lbl" x="72" y="240">顶停 f0</text>
            <text class="lbl" x="608" y="64" text-anchor="end">到底停帧 f192 · wrap:false</text>
            <text class="lbl2" x="26" y="30">↑ f（帧）</text>
            <text class="lbl2" x="64" y="292">行程 3.2 屏 ÷ 192 帧 ≈ 每屏 60 帧</text>
            <text class="lbl2" x="616" y="292" text-anchor="end">p（进度）→</text>
            <line class="guide" data-live="gv" x1={PX0} y1={PY0} x2={PX0} y2={PY0}></line>
            <line class="guide" data-live="gh" x1={PX0} y1={PY0} x2={PX0} y2={PY0}></line>
            <circle class="dot" data-live="dot" cx={PX0} cy={PY0} r="6"></circle>
            <text class="rider" data-live="rp" x="72" y="222">p 0.00</text>
            <text class="rider" data-live="rf" x="72" y="86">f 0</text>
          </svg>
        </figure>

        <!-- 03 · 图集解剖 -->
        <figure class="anat">
          <figcaption>
            <b>03</b><span class="t">图集解剖 · 20 段 × 2×5 切格</span><span class="en">ATLAS</span>
          </figcaption>
          <svg viewBox="0 0 680 330" role="img" aria-label="20 段胶片条与当前段 2×5 切格，实时高亮当前格">
            {
              segs.map((i) => (
                <g class="chipw" data-chip={i}>
                  <rect x={sx(i)} y="18" width={SW} height="42" rx="3" />
                  <text class="chipT" x={sx(i) + SW / 2} y="43" text-anchor="middle">
                    {pad2(i)}
                  </text>
                </g>
              ))
            }
            <line class="guide" data-live="segarrow" x1={sx(0) + SW / 2} y1="64" x2={sx(0) + SW / 2} y2="104"></line>
            <text class="lbl2" x="30" y="100">↓ 当前段 · 按 2 列 × 5 行切格（k = f − 段×10）</text>
            {
              cells.map((k) => (
                <g class="cellw" data-cellw={k}>
                  <rect x={30 + (k % 2) * 136} y={112 + Math.floor(k / 2) * 42} width="132" height="38" rx="3" />
                  <text class="cellN" data-cell={k} x={30 + (k % 2) * 136 + 66} y={112 + Math.floor(k / 2) * 42 + 24} text-anchor="middle">
                    {k}
                  </text>
                </g>
              ))
            }
            <text class="fact fact--big" x="330" y="134">atlas-seg<tspan data-live="zseg">00</tspan>.webp</text>
            <text class="fact" x="330" y="162">每格 966×720 · 每段图集 1932×3600</text>
            <text class="fact" x="330" y="186">解码后位图 ≈ 28MB/段（w×h×4B）</text>
            <text class="fact" x="330" y="210">段内 = 仅移动裁切窗口；跨段 = 装载新段</text>
            <text class="fact" x="330" y="234">绘制 = drawImage 九参裁切，零缩放</text>
            <text class="fact" x="330" y="258">末段 seg19 只有 3 格（f190–192）</text>
            <text class="fact" x="330" y="282">20 段 WebP ≈ 11MB · 压缩态全量预热</text>
          </svg>
        </figure>

        <!-- 04 · 双层缓存 -->
        <figure class="anat">
          <figcaption>
            <b>04</b><span class="t">双层缓存 · 压缩常驻 + 解码按需</span><span class="en">TWO-LAYER CACHE</span>
          </figcaption>
          <svg viewBox="0 0 680 250" role="img" aria-label="两层缓存：压缩态全段常驻，解码态 LRU 只驻留相邻段">
            <text class="cap" x="26" y="22">① 压缩态 ArrayBuffer · 20 段全常驻 ≈ <tspan data-live="bmb">0</tspan> MB（WebP 字节）</text>
            {
              segs.map((i) => (
                <rect class="slotA" x={sx(i)} y="34" width={SW} height="30" rx="3" />
              ))
            }
            <text class="cap" x="26" y="94">② 解码态 ImageBitmap · LRU 只驻留当前段 ±1 · 合计 <tspan data-live="mmb">0</tspan> MB</text>
            {
              segs.map((i) => (
                <rect class="slotB" data-slot-b={i} x={sx(i)} y="106" width={SW} height="30" rx="3" />
              ))
            }
            <line class="guide" data-live="cachelink" x1={sx(0) + SW / 2} y1="66" x2={sx(0) + SW / 2} y2="104"></line>
            <text class="cnt-l" x="26" y="176">解码次数</text>
            <text class="cnt-v" x="26" y="204" data-live="decodes">0</text>
            <text class="cnt-l" x="226" y="176">驱逐次数</text>
            <text class="cnt-v" x="226" y="204" data-live="evictions">0</text>
            <text class="cnt-l" x="426" y="176">驻留段数</text>
            <text class="cnt-v" x="426" y="204" data-live="rcount">0</text>
            <text class="note" x="26" y="238">
              远段 close() 真释放位图；跨段只触发一次解码（几十 ms），运行期零网络依赖。
            </text>
          </svg>
        </figure>

        <!-- 05 · 帧缓动 -->
        <figure class="anat">
          <figcaption>
            <b>05</b><span class="t">帧缓动 · 硬切 vs smoothDamp</span><span class="en">SMOOTHDAMP</span>
          </figcaption>
          <svg viewBox="0 0 680 240" role="img" aria-label="硬切台阶与 smoothDamp 平滑曲线对比，底部为实时追帧差距">
            <text class="plt" x="30" y="24">硬切 round(p×192)</text>
            <line class="axl" x1="30" y1="42" x2="30" y2="190"></line>
            <line class="axl" x1="30" y1="190" x2="314" y2="190"></line>
            <line class="ghost" x1="30" y1="184" x2="310" y2="54"></line>
            <path class="hard" d="M30 184 H70 V165 H110 V147 H150 V128 H190 V110 H230 V91 H270 V73 H310 V54"></path>
            <text class="plt" x="366" y="24">smoothDamp 追帧（无机械感）</text>
            <line class="axl" x1="366" y1="42" x2="366" y2="190"></line>
            <line class="axl" x1="366" y1="190" x2="650" y2="190"></line>
            <line class="ghost" x1="366" y1="184" x2="646" y2="54"></line>
            <path class="smooth" d="M366 184 C 436 180 476 168 516 130 S 606 68 646 54"></path>
            <text class="lbl2" x="650" y="208" text-anchor="end">曲线为示意 · Δ 为实时值</text>
            <text class="cnt-l" x="24" y="226">实时追踪</text>
            <rect class="gtrack" x="120" y="218" width="330" height="8" rx="4"></rect>
            <rect class="gfill" data-live="dbar" x="120" y="218" width="0" height="8" rx="4"></rect>
            <text class="cnt-v" data-live="dval" x="462" y="227">0.0 帧</text>
            <text class="dstat" data-live="dstat" x="656" y="227" text-anchor="end">已收敛</text>
          </svg>
        </figure>

        <footer class="specs" aria-label="技术规格">
          <span>时间轴 <b>线性钳制（wrap:false）</b></span>
          <span>映射 <b>f = round(p × 192) → smoothDamp</b></span>
          <span>分段 <b>20 段 × 10 格（2×5）</b></span>
          <span>单格 <b>966×720 · 零缩放</b></span>
          <span>抠图 <b>RVM resnet50 + despill</b></span>
          <span>体积 <b>20 × WebP ≈ 11MB</b></span>
          <span>位图 <b>LRU 2–3 段 ≈ 28MB/段</b></span>
        </footer>
      </div>
    </div>

    <p class="outro"><a href="/lab/">{t('scroll.backLab')}</a></p>
  </main>

  <script>
    /* ── iframe postMessage → 六张剖图的实时更新 ─────────────────────
       只在 rAF 里 flush（一帧至多一次 DOM 写），SVG 里全部节点出自
       模板（带 Astro cid），JS 只改属性 / 切类，动态类名命中 scoped 样式。 */
    const Q = (s) => document.querySelector(s);
    const el = {
      frame: Q('[data-live="frame"]'),
      frame2: Q('[data-live="frame2"]'),
      p: Q('[data-live="p"]'),
      p2: Q('[data-live="p2"]'),
      ftarget: Q('[data-live="ftarget"]'),
      ftarget2: Q('[data-live="ftarget2"]'),
      seg: Q('[data-live="seg"]'),
      cell: Q('[data-live="cell"]'),
      segcell: Q('[data-live="segcell"]'),
      scrollpx: Q('[data-live="scrollpx"]'),
      pbar: Q('[data-live="pbar"]'),
      dot: Q('[data-live="dot"]'),
      gv: Q('[data-live="gv"]'),
      gh: Q('[data-live="gh"]'),
      rp: Q('[data-live="rp"]'),
      rf: Q('[data-live="rf"]'),
      chips: [...document.querySelectorAll('[data-chip]')],
      segarrow: Q('[data-live="segarrow"]'),
      zseg: Q('[data-live="zseg"]'),
      cellsW: [...document.querySelectorAll('[data-cellw]')],
      cellsT: [...document.querySelectorAll('[data-cell]')],
      slotsB: [...document.querySelectorAll('[data-slot-b]')],
      cachelink: Q('[data-live="cachelink"]'),
      bmb: Q('[data-live="bmb"]'),
      mmb: Q('[data-live="mmb"]'),
      decodes: Q('[data-live="decodes"]'),
      evictions: Q('[data-live="evictions"]'),
      rcount: Q('[data-live="rcount"]'),
      dbar: Q('[data-live="dbar"]'),
      dval: Q('[data-live="dval"]'),
      dstat: Q('[data-live="dstat"]'),
      delta: Q('[data-live="delta"]'),
    };

    /* 与 SVG 几何保持同一组数（见上方常量注释） */
    const FX0 = 26, FW = 28, FG = 3.6;
    const PX0 = 64, PW = 552, PY0 = 252, PH = 204;
    const MAXF = 192;
    const chipCX = (i) => FX0 + i * (FW + FG) + FW / 2;
    const pad2 = (n) => String(n).padStart(2, '0');

    let rafPending = false;
    let pending = null;

    window.addEventListener('message', (e) => {
      if (e.data?.type !== 'scroll-demo') return;
      pending = e.data;
      if (!rafPending) {
        rafPending = true;
        requestAnimationFrame(flush);
      }
    });

    function flush() {
      rafPending = false;
      if (!pending) return;
      const d = pending;
      pending = null;

      const p = Math.max(0, Math.min(1, d.progress ?? 0));
      const f = Math.max(0, Math.min(MAXF, d.frame ?? 0));
      const seg = Math.min(19, Math.max(0, d.seg ?? Math.floor(f / 10)));
      const base = seg * 10;
      const target = d.target ?? f;
      const pos = d.pos ?? f;
      const delta = Math.abs(pos - target);
      const settled = delta < 0.05;
      const resident = Array.isArray(d.resident) ? d.resident : [];

      /* 00 实时透视 */
      el.frame.textContent = String(f);
      el.frame2.textContent = String(f);
      el.p.textContent = p.toFixed(3);
      el.p2.textContent = p.toFixed(3);
      el.ftarget.textContent = String(Math.round(target));
      el.ftarget2.textContent = String(Math.round(target));
      el.seg.textContent = pad2(seg);
      el.cell.textContent = String(f - base);
      el.segcell.textContent = `s${pad2(seg)}·k${f - base}`;
      el.scrollpx.textContent = String(Math.round(d.scrollY ?? 0));
      el.pbar.style.width = `${(p * 100).toFixed(1)}%`;
      el.delta.textContent = delta.toFixed(1);

      /* 02 映射曲线游标 */
      const x = PX0 + p * PW;
      const y = PY0 - (f / MAXF) * PH;
      el.dot.setAttribute('cx', x.toFixed(1));
      el.dot.setAttribute('cy', y.toFixed(1));
      el.gv.setAttribute('x1', x.toFixed(1));
      el.gv.setAttribute('y1', y.toFixed(1));
      el.gv.setAttribute('x2', x.toFixed(1));
      el.gv.setAttribute('y2', PY0);
      el.gh.setAttribute('x1', PX0);
      el.gh.setAttribute('y1', y.toFixed(1));
      el.gh.setAttribute('x2', x.toFixed(1));
      el.gh.setAttribute('y2', y.toFixed(1));
      el.rp.setAttribute('x', Math.min(x + 8, 540).toFixed(1));
      el.rp.textContent = `p ${p.toFixed(2)}`;
      el.rf.setAttribute('y', Math.max(y - 10, 58).toFixed(1));
      el.rf.textContent = `f ${f}`;

      /* 03 图集解剖 */
      for (let i = 0; i < el.chips.length; i++) {
        el.chips[i].classList.toggle('on', i === seg);
        el.chips[i].classList.toggle('resident', resident.includes(i));
      }
      el.segarrow.setAttribute('x1', chipCX(seg).toFixed(1));
      el.segarrow.setAttribute('x2', chipCX(seg).toFixed(1));
      el.zseg.textContent = pad2(seg);
      for (let k = 0; k < el.cellsT.length; k++) {
        const n = base + k;
        el.cellsT[k].textContent = n <= MAXF ? String(n) : '·';
        el.cellsW[k].classList.toggle('on', k === f - base && n <= MAXF);
      }

      /* 04 双层缓存 */
      for (let i = 0; i < el.slotsB.length; i++) {
        el.slotsB[i].classList.toggle('on', i === seg);
        el.slotsB[i].classList.toggle('resident', resident.includes(i));
      }
      el.cachelink.setAttribute('x1', chipCX(seg).toFixed(1));
      el.cachelink.setAttribute('x2', chipCX(seg).toFixed(1));
      el.bmb.textContent = (d.buffersMB ?? 0).toFixed(1);
      el.mmb.textContent = (d.bitmapsMB ?? 0).toFixed(0);
      el.decodes.textContent = String(d.decodes ?? 0);
      el.evictions.textContent = String(d.evictions ?? 0);
      el.rcount.textContent = String(resident.length);

      /* 05 帧缓动 Δ */
      el.dbar.style.width = `${Math.min(100, (delta / 6) * 100).toFixed(1)}%`;
      el.dbar.classList.toggle('settled', settled);
      el.dval.textContent = `${delta.toFixed(1)} 帧`;
      el.dstat.textContent = settled ? '已收敛' : '追帧中';
      el.dstat.classList.toggle('settled', settled);
    }
  </script>
