---
// 实验室 · 滚动帧随动（/lab/scroll/）——独立演示页
//
// 舞台本体已抽成 src/components/ScrollStage.astro（与首页融合版共用），
// 本页只是给它套上实验室的页头与说明面板。首页融合方式见 index.astro。
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ScrollStage from '../../components/ScrollStage.astro';
---

<Base title="Daidai档案馆">
  <!-- 页头行（2026-09-13 第二轮）：本页是历史演示页、不属四板块导航，
       但仍要出这条行 —— 昼夜章与公告现在由 PageHead 承载（不再由 Base 壳层
       fixed 渲染），漏挂本页会没有主题切换入口。 -->
  <PageHead no="LAB-01" back={{ label: '← 返回实验室', href: '/lab/' }} />

  <header class="page-head">
    <h1>SCROLL / 滚动帧随动</h1>
    <span class="sub">LAB-01 · 193 FRAMES · 24FPS · RVM MATTING</span>
  </header>

  <ScrollStage />

  <section class="outro">
    <div class="panel">
      <div class="panel-head">
        <h2>实现要点</h2>
        <span class="badge badge--win">BUILD PASS</span>
      </div>
      <div class="readout">
        <span>时间轴拓扑 <b>线性钳制（wrap:false）</b></span>
        <span>统一窗口 <b>966×720 · 零缩放</b></span>
        <span>分段 <b>20 段 × 10 格（2×5）</b></span>
        <span>抠图 <b>RVM resnet50 + despill</b></span>
        <span>体积 <b>20 × WebP ≈ 11MB 按需加载</b></span>
      </div>
    </div>
    <p class="backline"><a href="/">← 返回首页（已融合此交互）</a></p>
  </section>

  <script>
    import '../../lib/scroll-driver.js';
  </script>
</Base>

<style>
  .outro {
    padding: 40px 32px 48px;
    max-width: 1080px;
    margin: 0 auto;
  }

  .backline {
    margin: 18px 4px 0;
    font-size: 13px;
  }

  .backline a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
</style>
