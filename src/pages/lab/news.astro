---
// AI 新闻时间线 · 中文页（LAB-NEWS 01 + 06，2026-09-15）
//
// 06 交付：按 anchor()=publishedAt??fetchedAt 分组（年→日，倒序），最新年份
// 服务端渲染为活的 .news-list，其余年份塞进 inert <template data-news-year>
// （D24 零请求切换 / D25 首屏只渲染最新年份）。中文页展示「中文标题+中文摘要」，
// **存在第二种语言时**才追加英文原文对照层；外链属性手写 target/rel（D26/D27）；
// 译文纯文本渲染、不用 html 注入（D28，防 XSS）；未翻译标只打在「没有中文可读」
// 的条目上（2026-09-15 源换成单语 RSS 后的门控，见 frontmatter「语言门控」）。
//
// 2026-09-15 版式改版（横向轨道 → 纵向时间线）：分组粒度由「月」改为「天」
// （抓取窗口 72h、冷启动实测跨度 23.3h，按月分组恒为 1 组、标题没有信息量）；
// 渲染层次变为 .news-list > .news-day > (h2 + .news-day__items)。
// 版式两套形态（>900px 中央轴左右错位 / ≤900px 左轴单栏）**全部由 CSS 媒体查询决定**，
// 本页与英文页都不含任何版式分支 —— 页面只负责「一条一天的顺序 + 分组结构」。
//
// 编号语义见规格 D3：本页刻意不带任何板块编号。健壮性基线（D29）：数据文件
// 被误删 / items 缺失 / updated 为 null·缺失·非法 / 锚点非法，都须构建成功——
// 缺失即回落到空骨架，解析不出的条目直接跳过而非渲染 Invalid Date。
import Base from '../../layouts/Base.astro';
import { useTranslations, interpolate } from '../../i18n/utils';
import PageHead from '../../components/PageHead.astro';
import LabTabs from '../../components/LabTabs.astro';
import '../../styles/sheet.css';
import '../../styles/archive-chrome.css';
import '../../styles/lab-news.css';

const t = useTranslations('zh');

// 数据由离线管线生产、构建期消费（字段契约见 scripts/ai-news/SCHEMA.md）。
// 用 glob 引入而非顶层 import：数据文件被误删时 glob 仅返回空映射，不让整站
// 构建中断；归档按 *.json glob（不写死月份文件名，归档自动生长）。
// 注意：本页在 src/pages/lab/ 下（比 en 版少一层），glob 须是 ../../data/…
// （en 版在 src/pages/en/lab/ 下才是 ../../../data/…）。沿用 ticket 01 的
// 防御性 glob（缺失即回落空骨架、不让整站构建中断），只修正目录深度。
const curGlob = import.meta.glob('../../data/ai-news/current.json', {
  eager: true,
  import: 'default',
});
const curRaw = curGlob['../../data/ai-news/current.json'] as
  | { updated?: string | null; items?: unknown[] }
  | undefined;

const arcGlob = import.meta.glob('../../data/ai-news/archive/*.json', {
  eager: true,
  import: 'default',
});

// ── 数据读取：永不假设形状（规格 D29 兜底）──
function asItems(bag: unknown): any[] {
  const arr = bag && typeof bag === 'object' && Array.isArray((bag as any).items)
    ? (bag as any).items
    : [];
  return arr.filter((it: any) => it && typeof it === 'object' && typeof it.url === 'string');
}

// anchor = publishedAt ?? fetchedAt；任一不可解析都回退，都崩则跳过该条
function anchorOf(it: any): Date | null {
  const tryParse = (s: any) => {
    if (typeof s !== 'string') return null;
    const d = new Date(s);
    return Number.isNaN(d.getTime()) ? null : d;
  };
  return tryParse(it?.publishedAt) ?? tryParse(it?.fetchedAt);
}

// ── 语言门控（2026-09-15，源改成内容方自营 RSS 后新增）──
// ⚠️ 这道门控是**必需**的，不是优化：RSS 源是**单语**的，`shape.mjs` 把
// `title.en` 与 `title.zh` 写成同一个值（两个语言槽都放原文）。于是
//   · 无条件渲染「英文原文对照」层 → 同一句标题在同一张卡里印两遍；
//   · 无条件打「未翻译」标 → 26 条中文源全被打标，而它们本来就是中文，不是「翻译缺位」。
// 判据拆成两条，各自对应一个真实的渲染问题：
//   ① 对照层：只有 en 与 zh **确实不同**时才说明存在第二种语言；
//   ② 未翻译标：只有「本条没有中文可读」时才谈得上未翻译，判据是 `lang === 'zh'`。
// 用「没有中文可读」而不是「lang === 'en'」判标：前者对缺 lang 的旧数据也成立。
// ⛔ 2026-09-15 站长裁定**不接入任何 LLM**，`translated` 字段已从 schema 整条删除，
//    判据不得再引用它（历史数据里若残留该字段，一律忽略）。
const hasZhBody = (it: any): boolean => it?.lang === 'zh';
const pairDiffers = (a: unknown, b: unknown): boolean =>
  Boolean(a) && String(a) !== String(b);

const allRaw = [...asItems(curRaw), ...Object.values(arcGlob).flatMap(asItems)];

// 去重（同一文章不同追踪参数已规范化；保险起见按 id 去重）
const seen = new Set<string>();
const prepared: { it: any; d: Date }[] = [];
for (const it of allRaw) {
  if (typeof it.id === 'string') {
    if (seen.has(it.id)) continue;
    seen.add(it.id);
  }
  const d = anchorOf(it);
  if (!d) continue; // 两个时间都非法 → 跳过，不渲染 Invalid Date
  prepared.push({ it, d });
}

// ── 分组（年降序 → 日降序）── 2026-09-15 由「月」改为「天」（版式改版同期）
//
// ⚠️ 时区口径：条目时间**按站点读者时区 Asia/Shanghai 显示与切日**，不按 UTC。
// 原实现用 timeZone:'UTC' —— 那会把一条 17:47(+08:00) 发布的国内新闻显示成
// 09:47，并且跨日边界（+08:00 的 23:00 之后发布）会被切到第二天，
// 「按日期分组」直接错一天。分组键与显示格式必须走同一个时区，否则会互相打架。
const TZ = 'Asia/Shanghai';

// en-CA 的短日期格式恰好是 ISO 形状 → 用它取「时区内的日键」，不必手算偏移
const dtfDayKey = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: TZ,
});
const dtfDay = new Intl.DateTimeFormat('zh-CN', {
  month: 'long',
  day: 'numeric',
  timeZone: TZ,
});
const dtfWeekday = new Intl.DateTimeFormat('zh-CN', {
  weekday: 'short',
  timeZone: TZ,
});
// 日期已在分组标题里给出，卡片上只留「时:分」
const dtfTime = new Intl.DateTimeFormat('zh-CN', {
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
  timeZone: TZ,
});

const byYear = new Map<number, Map<string, { it: any; d: Date }[]>>();
for (const p of prepared) {
  const dayKey = dtfDayKey.format(p.d); // "2026-09-15"，已是 Asia/Shanghai 的日
  const year = Number(dayKey.slice(0, 4));
  if (!byYear.has(year)) byYear.set(year, new Map());
  const dmap = byYear.get(year)!;
  if (!dmap.has(dayKey)) dmap.set(dayKey, []);
  dmap.get(dayKey)!.push(p);
}

const years = [...byYear.entries()]
  .sort((a, b) => b[0] - a[0])
  .map(([year, dmap]) => ({
    year,
    days: [...dmap.entries()]
      .sort((a, b) => b[0].localeCompare(a[0]))
      .map(([dayKey, ps]) => {
        // 取当天正午（UTC）作代表时刻：任何时区下都落在同一天，格式化不会漂到邻日
        const [yy, mm, dd] = dayKey.split('-').map(Number);
        const rep = new Date(Date.UTC(yy, mm - 1, dd, 12));
        return {
          dayKey,
          label: dtfDay.format(rep),
          weekday: dtfWeekday.format(rep),
          items: ps.map(({ it, d: at }) => ({
            it,
            time: dtfTime.format(at),
            // 两个门控在 frontmatter 里算定（见上方「语言门控」），模板只负责按结果渲染
            showEn: pairDiffers(it.title?.en, it.title?.zh),
            showFlag: !hasZhBody(it),
            // 读屏名补上日期：卡片上只剩时分，长列表里「09:47」本身不足以定位
            aria: interpolate(t('news.itemAria'), {
              title: it.title?.zh ?? '',
              source: it.source ?? '',
              time: `${dtfDay.format(rep)} ${dtfTime.format(at)}`,
            }),
          })),
        };
      }),
  }));

const newestYear = years.length ? years[0].year : null;
const hasData = years.length > 0;

// 最后更新行：有效时间戳用 Intl 按中文 locale 格式化；
// null / 缺失 / 非法（new Date 得到 NaN）→ 尚未抓取。
const updated = (curRaw as any)?.updated ?? null;
let updatedLine: string;
if (updated) {
  const du = new Date(updated);
  if (!Number.isNaN(du.getTime())) {
    const time = new Intl.DateTimeFormat('zh-CN', {
      dateStyle: 'medium',
      timeStyle: 'short',
      timeZone: TZ,
    }).format(du);
    updatedLine = interpolate(t('news.updated'), { time });
  } else {
    updatedLine = t('news.neverFetched');
  }
} else {
  updatedLine = t('news.neverFetched');
}
---

<Base
  title={`${t('section.news.title')} · ${t('site.title')}`}
  description={t('section.news.desc')}
>
  <main class="sheet" id="main">
    <PageHead back={{ label: t('head.backLab'), href: '/' }} />

    <LabTabs locale="zh" active="news" />

    {/* 2026-09-15 晚 daidai 裁定：hero 大标题整块删除（AI NEWS 描边 + h1 +
        副标题），与 /lab/ 实验页同步——tab 条下直接进时间线。页面标题仍在
        <title>（section.news.title=AI 新闻）。⛔ 不要把 hero 加回来。 */}

    <section class="news">
      {
        hasData && years.length > 1 && (
          <div class="news-yearnav" role="group" aria-labelledby="news-yearnav-label">
            <span class="news-yearnav__label" id="news-yearnav-label">
              {t('news.yearNav')}
            </span>
            <div class="news-yearnav__btns">
              {years.map((y) => (
                <button
                  type="button"
                  class="news-yearbtn"
                  data-year={y.year}
                  aria-pressed={String(y.year === newestYear)}
                >
                  {interpolate(t('news.yearLink'), { year: y.year })}
                </button>
              ))}
            </div>
          </div>
        )
      }

      {/* 纵向时间线：整块按 hasData 门控。空态下不渲染 —— 否则会留下一条
          孤零零的中轴线与一块空白，而「时间线」又无内容可读。
          层次：.news-list（一年）> .news-day（一天）> h2 + .news-day__items（条目）。
          版式（中央轴交错 / 左轴单栏）全在 lab-news.css 的两个媒体查询里，
          这里不出现任何版式判断；刻度点与连接线是 .news-item 的伪元素。 */}
      {hasData && (
        <div class="news-rail">
          {
            years.map((y) => {
              const live = y.year === newestYear;
              const list = (
                <ol
                  class="news-list"
                  role="list"
                  data-news-year={y.year}
                  aria-label={t('news.timelineAria')}
                >
                  {y.days.map((p) => (
                    <li class="news-day">
                      <h2 class="news-day__title">
                        <time datetime={p.dayKey}>
                          {p.label} · {p.weekday}
                        </time>
                      </h2>
                      <ol
                        class="news-day__items"
                        role="list"
                        aria-label={interpolate(t('news.periodAria'), {
                          period: p.label,
                        })}
                      >
                        {p.items.map(({ it, time, aria, showEn, showFlag }) => (
                          <li class="news-item">
                            <a
                              class="news-item__link"
                              href={it.url}
                              target="_blank"
                              rel="nofollow noopener noreferrer"
                              aria-label={aria}
                            >
                              <span class="news-item__time" aria-hidden="true">{time}</span>
                              <span class="news-item__title">{it.title?.zh}</span>
                              {it.summary?.zh ? (
                                <p class="news-item__summary" aria-hidden="true">
                                  {it.summary.zh}
                                </p>
                              ) : null}
                              {/* 对照层按 showEn 门控：单语源的 en 字段是 zh 的副本，
                                  无条件渲染会把同一句标题印两遍（见 frontmatter 语言门控）。 */}
                              {showEn ? (
                                <span class="news-item__en" aria-hidden="true">
                                  <span class="news-item__en-title">{it.title?.en}</span>
                                  {it.summary?.en ? (
                                    <span class="news-item__en-summary">{it.summary.en}</span>
                                  ) : null}
                                </span>
                              ) : null}
                              {/* 来源与「未翻译」标同处卡底一行：来源贴左、标贴右。
                                  margin-top:auto 让它贴住卡底（见 CSS）。 */}
                              <span class="news-item__meta">
                                <span class="news-item__source">{it.source}</span>
                                {showFlag ? (
                                  <span class="news-item__flag">{t('news.untranslated')}</span>
                                ) : null}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ol>
                    </li>
                  ))}
                </ol>
              );
              return live ? list : <template data-news-year={y.year}>{list}</template>;
            })
          }
        </div>
      )}

      {
        !hasData && (
          <div class="news-empty" aria-label={t('section.news.title')}>
            <strong>{t('news.empty')}</strong>
            <small>{t('news.emptyNote')}</small>
          </div>
        )
      }

      <p class="news-updated">{updatedLine}</p>
      {/* 摘录声明：合理使用的「指明出处」要件，句在页尾但每页恒显 */}
      <p class="news-disclaimer">{t('news.disclaimer')}</p>
    </section>

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<script>
  import { mountNewsTimeline } from '../../lib/ai-news-timeline.js';
  const root = document.querySelector('.news');
  if (root) mountNewsTimeline({ root });
</script>
