---
// 作品详情页（2026-09-12 建）：/works/01/ … /works/07/。
// 作品集列表页（works.astro）卡面只留「编号 + 标题」，描述 / 标签 /
// 状态 / 年份全部收进本页——用户裁定「点击进去才是详情」。
// 数据源同列表页 = profile.json 的 works 节；slug 用条目编号（01…07）。
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/utils';
import PageHead from '../../components/PageHead.astro';
import profile from '../../data/profile.json';
import '../../styles/sheet.css';
import '../../styles/archive-chrome.css';
import '../../styles/work-detail.css';

const works = profile.works.items;

export function getStaticPaths() {
  // 注意：getStaticPaths 在预渲染 chunk 里被独立求值，闭包引用不到
  // 模块顶层 const（实测报 "works is not defined"），数据必须在这里重新取。
  return profile.works.items.map((w, idx) => ({
    params: { slug: w.no },
    props: { w, idx },
  }));
}

const { w, idx } = Astro.props;
const prev = works[(idx - 1 + works.length) % works.length];
const next = works[(idx + 1) % works.length];
const t = useTranslations('zh');

---
<Base title={`${w.title} · ${t('section.works.title')} · ${t('site.title')}`} description={w.desc}>
  <main class="sheet" id="main">
    <PageHead
      no="NO.02"
      chips={[{ label: w.no, variant: 'red' }]}
      back={{ label: t('head.backWorks'), href: '/works/' }}
    />

    <section class="hero">
      <p class="en" aria-hidden="true">{w.en}</p>
      <h1>{w.title}</h1>
      <div class="meta">
        <span class="status" data-tone={w.status === '上线' ? 'red' : 'ink'}>{w.status}</span>
        <span>{w.year}</span>
      </div>
    </section>

    {w.img && (
      <section class="preview">
        <img src={w.img} alt={w.title} loading="lazy" decoding="async" />
      </section>
    )}

    <section class="detail">
      <p class="desc">{w.desc}</p>
      <ul class="chips" role="list">
        {w.tags.map((t) => <li>{t}</li>)}
      </ul>
      {w.href ? (
        <a class="go" href={w.href} rel={w.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
          {w.href === '/' ? t('work.gotoHome') : w.href.includes('github.com') ? t('work.gotoGithub') : t('work.gotoProject')}
        </a>
      ) : (
        <span class="go go--none">{t('work.notArchived')}</span>
      )}
    </section>

    <nav class="pn" aria-label={t('work.pnAria')}>
      <a class="pn-link" href={`/works/${prev.no}/`}><small>{t('work.prev')}</small>{prev.title}</a>
      <a class="pn-link pn-link--r" href={`/works/${next.no}/`}><small>{t('work.next')}</small>{next.title}</a>
    </nav>

    <!-- 收尾导航（2026-09-13 第三轮，用户裁定）：只在 ≤640px 显示。理由同文章页
         的 .postback —— 手机档页头隐藏 .back 后，本页失去唯一的「回作品集」站内
         路径（上面的 .pn 只给兄弟条目，不含列表）。桌面档不显示：页头 .head 是
         sticky 的，返回链全程可见，正文再放一条就是重复入口。两者严格互斥。 -->
    <a class="backhome" href="/works/">{t('head.backWorks')}</a>

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<style>
  /* 版式已抽到 src/styles/work-detail.css（i18n 时为英文版共享）。
     本页如需页面专有样式，写在这里。 */
</style>
