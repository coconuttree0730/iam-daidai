---
// 作品集页（2026-09-14 改版：横向卡牌堆叠展开）。
// 效果：每组居中→卡片依次堆叠→整体左移→下一组进入。
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import profile from '../data/profile.json';

const cats = profile.works.cats;
const works = profile.works.items;
const byCat = (id) => works.filter((w) => w.cat === id);
const pad2 = (n) => String(n).padStart(2, '0');

const sets = cats.filter(c => c.id !== 'inbox').map(cat => {
  const items = byCat(cat.id);
  const cards = [
    ...items.reverse().map(w => ({
      type: 'work', no: w.no, title: w.title, en: w.en,
      img: w.img, cover: w.cover, href: `/works/${w.no}/`,
    })),
    ...(cat.img ? [{
      type: 'cover', letter: cat.letter, name: cat.name, en: cat.en,
      img: cat.img, imgAlt: cat.imgAlt, count: items.length,
    }] : []),
  ];
  return { cat, cards };
});
---

<Base title="作品集 · Daidai档案馆" description="作品集板块 · 精选项目档案" dock={false}>
  <main class="sheet">
    <PageHead no="NO.02" back={{ label: '← 返回档案馆', href: '/' }} />
    <h1 class="sr-only">作品集</h1>

    <section class="stack-viewport" data-stack-viewport tabindex="-1">
      <div class="stack-rail" data-stack-rail>
        {sets.flatMap((set, setIdx) => {
          const items: any[] = [];
          items.push(
            <div class="card-set" data-set={set.cat.id}>
              {set.cards.map((card, cardIdx) => {
                const isCover = card.type === 'cover';
                return (
                  <div
                    class={`stack-card ${isCover ? 'is-cover' : ''}`}
                    data-card={cardIdx}
                    style={`--i: ${cardIdx}; --total: ${set.cards.length}`}
                  >
                    <div class="card-inner">
                      {card.type === 'work' ? (
                        <a class="card-link" href={card.href}>
                          {card.img ? (
                            <img class="card-img" src={card.img} alt={card.title} loading="lazy" decoding="async" />
                          ) : (
                            <div class="card-placeholder" data-cover={card.cover}></div>
                          )}
                          <div class="card-scrim"></div>
                          <div class="card-info">
                            <span class="card-no">{card.no}</span>
                            <span class="card-title">{card.title}</span>
                            <span class="card-en">{card.en}</span>
                          </div>
                        </a>
                      ) : (
                        <>
                          <img class="card-img" src={card.img} alt={card.imgAlt} loading="lazy" decoding="async" />
                          <div class="card-scrim"></div>
                          <div class="card-info">
                            <span class="card-letter">{card.letter}</span>
                            <span class="card-title">{card.name}</span>
                            <span class="card-en">{card.en}</span>
                            <span class="card-count">{card.count} 件</span>
                          </div>
                        </>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          );
          if (setIdx < sets.length - 1) {
            items.push(<div class="set-gap" aria-hidden="true"></div>);
          }
          return items;
        })}
        <div class="end-set">
          <a class="endcard" href="/#basic">
            <span class="endcard-face">
              <span class="end-zh" aria-hidden="true">完</span>
              <span class="end-line">有想一起做的项目？</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <footer class="dock">
      <div class="ruler" data-ruler>
        <span class="ticks">{Array.from({ length: 29 }).map(() => (<i></i>))}</span>
        <span class="frame" data-frame></span>
      </div>
    </footer>
  </main>
</Base>

<script>
  import { createWorksRail } from '../lib/works-rail.js';

  const viewport = document.querySelector('[data-stack-viewport]');
  const rail = document.querySelector('[data-stack-rail]');
  const rulerEl = document.querySelector('[data-ruler]');
  const frameEl = document.querySelector('[data-frame]');
  const total = Number(rail?.dataset.total ?? '0');

  const railAPI = viewport && rail
    ? createWorksRail({
        viewport, rail, frameEl, rulerEl, total,
        onRender: renderCascade,
      })
    : null;

  function clamp(v, a, b) { return Math.min(Math.max(v, a), b); }

  /**
   * 横向卡牌堆叠展开
   * 
   * 每组流程：
   * 1. 居中 + 卡片堆叠
   * 2. 堆叠完成后停留
   * 3. 继续滑动时，当前组左移，下一组从右进入
   */
  function renderCascade(pos, max) {
    if (!max) return;
    const progress = pos / max; // 0→1

    const viewportWidth = viewport.clientWidth;
    const cardSets = document.querySelectorAll('.card-set');
    const setCount = cardSets.length;
    if (!setCount) return;

    // 获取尺寸
    const firstSet = cardSets[0];
    const setGap = document.querySelector('.set-gap');
    const cardSetWidth = firstSet.offsetWidth;
    const setGapWidth = setGap ? setGap.offsetWidth : 100;
    const paddingLeft = parseFloat(getComputedStyle(rail).paddingLeft) || 80;

    // ── 计算每组的居中位置 ──
    const setCenters = [];
    for (let i = 0; i < setCount; i++) {
      const setLeft = paddingLeft + i * (cardSetWidth + setGapWidth);
      const centerOffset = (viewportWidth - cardSetWidth) / 2;
      setCenters.push(setLeft - centerOffset);
    }

    // ── 计算轨道位置 ──
    const setSegment = 1 / setCount;
    const activeIdx = Math.min(Math.floor(progress * setCount), setCount - 1);
    const segProgress = (progress * setCount) % 1;

    let railPos;
    if (activeIdx < setCount - 1 && segProgress > 0.7) {
      // 过渡阶段：从当前组中心移动到下一组中心
      const transitionProgress = (segProgress - 0.7) / 0.3;
      const eased = transitionProgress * transitionProgress;
      railPos = setCenters[activeIdx] + (setCenters[activeIdx + 1] - setCenters[activeIdx]) * eased;
    } else if (activeIdx === setCount - 1) {
      // 最后一组：先居中，然后往左移露出"完"
      const endSet = document.querySelector('.end-set');
      const endSetLeft = endSet ? endSet.offsetLeft : 0;
      const endSetCenter = endSetLeft - (viewportWidth - (endSet?.offsetWidth || 200)) / 2;
      
      if (segProgress < 0.6) {
        // 停留在最后一组居中
        railPos = setCenters[activeIdx];
      } else {
        // 过渡到"完"卡片居中
        const transitionProgress = (segProgress - 0.6) / 0.4;
        const eased = transitionProgress * transitionProgress * (3 - 2 * transitionProgress);
        railPos = setCenters[activeIdx] + (endSetCenter - setCenters[activeIdx]) * eased;
      }
    } else {
      railPos = setCenters[activeIdx];
    }

    // ── 移动轨道 ──
    rail.style.transform = `translate3d(${-railPos}px,0,0)`;

    // ── 动画卡片 ──
    cardSets.forEach((set, setIdx) => {
      const cards = set.querySelectorAll('.stack-card');
      const cardCount = cards.length;
      if (!cardCount) return;

      // 这组的进度
      const segStart = setIdx / setCount;
      const segEnd = (setIdx + 1) / setCount;
      const sp = clamp((progress - segStart) / (segEnd - segStart), 0, 1);

      cards.forEach((card, i) => {
        // 第一组的第一张卡：立即显示
        const isImmediate = setIdx === 0 && i === 0;

        let reveal;
        if (isImmediate) {
          reveal = 1;
        } else {
          const appearAt = i * 0.18;
          reveal = clamp((sp - appearAt) / 0.35, 0, 1);
        }

        const eased = 1 - Math.pow(1 - reveal, 3);

        // 目标位置（移动端减小偏移保持居中）
        const isMobile = viewportWidth < 640;
        const cardGap = isMobile ? 4 : 10;
        const targetX = i * cardGap;
        const startX = isMobile ? 40 : 80;
        const x = startX + (targetX - startX) * eased;
        const y = i * -2 * eased;

        // 缩放
        const shrinkRate = 0.05;
        const targetScale = 1 - (cardCount - 1 - i) * shrinkRate;
        const scale = 1 - (1 - targetScale) * eased;

        card.style.transform = `translateX(${x}%) translateY(${y}px) scale(${scale})`;
        card.style.opacity = String(reveal > 0 ? 1 : 0);
        card.style.zIndex = String(i + 1);
      });
    });
  }
</script>

<style>
  .sheet {
    height: 100dvh; display: flex; flex-direction: column;
    background: var(--c-paper); color: var(--c-ink);
    font-family: "Noto Sans CJK SC", "Source Han Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
    overflow: hidden;
  }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; }

  .stack-viewport { flex: 1; min-height: 0; display: flex; align-items: center; overflow: hidden; cursor: grab; touch-action: pan-y; outline: none; }
  .stack-viewport:active { cursor: grabbing; }
  .stack-rail { display: flex; align-items: center; padding-inline: clamp(20px, 8vw, 110px); will-change: transform; }

  .card-set {
    position: relative; flex: none;
    width: clamp(760px, 45vw, 920px);
    height: clamp(440px, 62vh, 560px);
  }

  .set-gap { flex: none; width: clamp(100px, 14vw, 180px); height: 100%; }

  .stack-card {
    position: absolute; inset: 0;
    border-radius: 14px; overflow: hidden;
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    transform-origin: center center;
    will-change: transform, opacity;
    opacity: 0;
  }

  .card-inner {
    width: 100%; height: 100%; border-radius: 14px; overflow: hidden;
    position: relative;
  }

  .card-link { display: block; width: 100%; height: 100%; text-decoration: none; color: inherit; outline: none; position: relative; }
  .card-link:focus-visible { outline: 2px solid var(--c-red); outline-offset: 3px; }

  .card-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .card-placeholder { position: absolute; inset: 0; background: var(--c-card); }
  .card-placeholder[data-cover="grid"] { background-image: linear-gradient(45deg, rgba(var(--c-ink-rgb), 0.05) 25%, transparent 25%, transparent 75%, rgba(var(--c-ink-rgb), 0.05) 75%), linear-gradient(45deg, rgba(var(--c-ink-rgb), 0.05) 25%, transparent 25%, transparent 75%, rgba(var(--c-ink-rgb), 0.05) 75%); background-size: 26px 26px; background-position: 0 0, 13px 13px; }
  .card-placeholder[data-cover="stripes"] { background-image: repeating-linear-gradient(45deg, rgba(var(--c-ink-rgb), 0.055) 0 2px, transparent 2px 12px); }
  .card-placeholder[data-cover="rings"] { background-image: repeating-radial-gradient(circle at 72% 28%, rgba(var(--c-ink-rgb), 0.07) 0 1.5px, transparent 1.5px 15px); }
  .card-placeholder[data-cover="dots"] { background-image: radial-gradient(rgba(var(--c-ink-rgb), 0.10) 1.2px, transparent 1.3px); background-size: 17px 17px; }
  .card-placeholder[data-cover="bars"] { background-image: repeating-linear-gradient(90deg, rgba(var(--c-ink-rgb), 0.09) 0 2px, transparent 2px 6px, rgba(var(--c-ink-rgb), 0.09) 6px 7px, transparent 7px 14px); }
  .card-placeholder[data-cover="cross"] { background-image: repeating-linear-gradient(0deg, rgba(var(--c-ink-rgb), 0.055) 0 1px, transparent 1px 20px), repeating-linear-gradient(90deg, rgba(var(--c-ink-rgb), 0.055) 0 1px, transparent 1px 20px); }

  .card-scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.08) 40%, transparent 70%); pointer-events: none; }

  .card-info { position: absolute; bottom: 0; left: 0; right: 0; padding: 20px; display: flex; flex-direction: column; gap: 4px; z-index: 1; }
  .card-no { font-family: "Archivo Black", sans-serif; font-size: 12px; color: var(--c-red); letter-spacing: 0.12em; }
  .card-letter { font-family: "Archivo Black", sans-serif; font-size: 14px; color: var(--c-red); letter-spacing: 0.1em; margin-bottom: 4px; }
  .card-title { font-size: 22px; font-weight: 900; line-height: 1.2; color: #fff; }
  .card-en { font-family: "Anton", Impact, sans-serif; font-size: 11px; letter-spacing: 0.2em; color: rgba(255,255,255,0.5); user-select: none; }
  .card-count { font-size: 11px; letter-spacing: 0.12em; color: rgba(255,255,255,0.45); margin-top: 2px; }

  .end-set { flex: none; display: flex; align-items: center; padding-left: clamp(40px, 6vw, 80px); }
  .endcard { display: block; text-decoration: none; color: inherit; outline: none; }
  .endcard:focus-visible .endcard-face { outline: 2px solid var(--c-red); outline-offset: 3px; }
  .endcard-face { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; width: clamp(180px, 20vw, 230px); height: clamp(260px, 40vh, 340px); border: 1.5px dashed rgba(var(--c-ink-rgb), 0.35); border-radius: 10px; text-align: center; rotate: 0.5deg; transition: rotate 0.25s ease, transform 0.25s ease; }
  .endcard:hover .endcard-face { rotate: 0deg; transform: translateY(-6px); }
  .end-zh { font-size: 48px; font-weight: 900; line-height: 1; color: var(--c-red); border: 2.5px solid var(--c-red); border-radius: 8px; padding: 9px 14px; rotate: -5deg; letter-spacing: 0.1em; }
  .end-line { font-size: 12.5px; color: var(--c-muted); }

  .dock { 
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    display: flex; align-items: center; justify-content: center;
    padding: 12px 20px;
    background: var(--c-paper);
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }
  .ruler { position: relative; height: 18px; }
  .ticks { display: flex; gap: 4px; height: 100%; align-items: flex-start; }
  .ticks i { width: 1px; height: 12px; background: rgba(var(--c-ink-rgb), 0.35); }
  .frame { position: absolute; top: 0; left: 0; width: 22px; height: 16px; border: 1.5px solid var(--c-red); background: var(--c-red); will-change: transform; }
  .count b { color: var(--c-ink); font-weight: 900; }

  @media (max-width: 640px) {
    .card-set { width: min(320px, 78vw); height: clamp(320px, 50vh, 400px); }
    .card-title { font-size: 18px; }
    .card-info { padding: 14px; }
    .card-no, .card-letter { font-size: 11px; }
    .card-en { font-size: 10px; }
    .ticks i { height: 10px; }
    .endcard-face { width: 140px; height: 200px; }
    .end-zh { font-size: 36px; padding: 6px 10px; }
    .end-line { font-size: 11px; }
    .dock { padding: 8px 16px; bottom: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .stack-card { transition: none !important; } }
</style>
