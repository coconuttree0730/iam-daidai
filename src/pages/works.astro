---
// 作品集页（2026-09-14 改版：横向卡牌堆叠展开）。
// 效果：每组居中→卡片依次堆叠→整体左移→下一组进入。
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/utils';
import PageHead from '../components/PageHead.astro';
import profile from '../data/profile.json';
import '../styles/works-rail.css';

const cats = profile.works.cats;
const works = profile.works.items;
const byCat = (id) => works.filter((w) => w.cat === id);
const pad2 = (n) => String(n).padStart(2, '0');

const sets = cats.filter(c => c.id !== 'inbox').map(cat => {
  const items = byCat(cat.id);
  const cards = [
    ...items.reverse().map(w => ({
      type: 'work', no: w.no, title: w.title, en: w.en,
      img: w.img, cover: w.cover, href: `/works/${w.no}/`,
    })),
    ...(cat.img ? [{
      type: 'cover', letter: cat.letter, name: cat.name, en: cat.en,
      img: cat.img, imgAlt: cat.imgAlt, count: items.length,
    }] : []),
  ];
  return { cat, cards };
});
const t = useTranslations('zh');

---

<Base title={`${t('section.works.title')} · ${t('site.title')}`} description="作品集板块 · 精选项目档案" dock={false}>
  <main class="sheet" id="main">
    <PageHead no="NO.02" back={{ label: t('head.backHome'), href: '/' }} />
    <h1 class="sr-only">作品集</h1>

    <section class="stack-viewport" data-stack-viewport tabindex="-1">
      <div class="stack-rail" data-stack-rail>
        {sets.flatMap((set, setIdx) => {
          const items: any[] = [];
          items.push(
            <div class="card-set" data-set={set.cat.id}>
              {set.cards.map((card, cardIdx) => {
                const isCover = card.type === 'cover';
                return (
                  <div
                    class={`stack-card ${isCover ? 'is-cover' : ''}`}
                    data-card={cardIdx}
                    style={`--i: ${cardIdx}; --total: ${set.cards.length}`}
                  >
                    <div class="card-inner">
                      {card.type === 'work' ? (
                        <a class="card-link" href={card.href}>
                          {card.img ? (
                            <img class="card-img" src={card.img} alt={card.title} loading="lazy" decoding="async" />
                          ) : (
                            <div class="card-placeholder" data-cover={card.cover}></div>
                          )}
                          <div class="card-scrim"></div>
                          <div class="card-info">
                            <span class="card-no">{card.no}</span>
                            <span class="card-title">{card.title}</span>
                            <span class="card-en">{card.en}</span>
                          </div>
                        </a>
                      ) : (
                        <>
                          <img class="card-img" src={card.img} alt={card.imgAlt} loading="lazy" decoding="async" />
                          <div class="card-scrim"></div>
                          <div class="card-info">
                            <span class="card-letter">{card.letter}</span>
                            <span class="card-title">{card.name}</span>
                            <span class="card-en">{card.en}</span>
                            <span class="card-count">{card.count} 件</span>
                          </div>
                        </>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          );
          if (setIdx < sets.length - 1) {
            items.push(<div class="set-gap" aria-hidden="true"></div>);
          }
          return items;
        })}
        <div class="end-set">
          <a class="endcard" href="/#basic">
            <span class="endcard-face">
              <span class="end-zh" aria-hidden="true">{t('works.end')}</span>
              <span class="end-line">{t('works.endCta')}</span>
            </span>
          </a>
        </div>
      </div>
      <div class="scroll-hint" data-scroll-hint aria-hidden="true">
        <span class="scroll-hint__text">{t('works.scrollHint')}</span>
        <span class="scroll-hint__line"></span>
      </div>
    </section>

    <footer class="rail-dock">
      <div class="ruler" data-ruler>
        <span class="ticks">{Array.from({ length: 29 }).map(() => (<i></i>))}</span>
        <span class="frame" data-frame></span>
      </div>
    </footer>
  </main>
</Base>

<script>
  /* 交互逻辑已抽到 src/lib/works-view.js（2026-09-14 i18n 时为英文版
     /en/works/ 共享，避免动画算法出现两个必须手工同步的副本）。
     本页只负责给 DOM 钩子：[data-stack-viewport] / [data-stack-rail] /
     [data-ruler] / [data-frame] / .card-set / .end-set，见上方模板。 */
  import { mountWorksRail } from '../lib/works-view.js';
  mountWorksRail();
</script>

<style>
  /* 版式已抽到 src/styles/works-rail.css（i18n 时为英文版 /en/works/ 共享）。
     本页如需页面专有样式，写在这里。 */
</style>
