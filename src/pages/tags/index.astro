---
// 标签索引页（2026-09-12）：/tags/ —— 全部标签 + 文章计数，行式档案风。
// 计数按已发布文章统计（draft 在生产构建被过滤）；排序：文章数降序，同数按名称。
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/utils';
import PageHead from '../../components/PageHead.astro';
import { getSortedPosts } from '../../data/posts';
import '../../styles/sheet.css';
import '../../styles/archive-chrome.css';
import '../../styles/tags-index.css';

const posts = await getSortedPosts();

const counts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags) {
    counts.set(t, (counts.get(t) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
const t = useTranslations('zh');

---

<Base title={`${t('section.tags.title')} · ${t('site.title')}`} description={t('section.tags.desc')}>
  <main class="sheet" id="main">
    <PageHead
      no="NO.03"
      chips={[
        // 「INDEX」自指 chip 与「博客」chip 同批删除（2026-09-14 用户裁定）：
        // 页头编号 NO.03 + 高亮状态已足以标识当前页，自指链接是冗余。
        // 「RSS」chip 亦移除（2026-09-14）：Base <head> 已有 autodiscovery。
        { label: '全部分类', href: '/categories/' },
      ]}
      back={{ label: t('head.backBlog'), href: '/blog/' }}
    />

    {/* 页头（2026-09-12 晚参考 temp/标签索引.jpeg 重构）：左侧插画 =
        从参考图洪泛抠出的 Q版人物+文件柜（文字已擦除，透明底），
        TAGS/标签索引 是真实文字代码渲染（换主题自适应），不再烘在图里 */}
    <section class="hero">
      <img
        class="hero__art"
        src="/motion/tags-cabinet-chibi.webp"
        alt=""
        width="723"
        height="680"
        loading="eager"
        decoding="async"
      />
      <div class="hero__text">
        <p class="en" aria-hidden="true">TAGS</p>
        <h1>{t('section.tags.title')}</h1>
      </div>
    </section>

    {
      tags.length === 0 ? (
        <section class="stamp" aria-label={t('empty.noTags')}>
          <strong>{t('empty.noTags')}</strong>
          <small>{t('empty.noTagsNote')}</small>
        </section>
      ) : (
        <section class="list-section" aria-label={t('tags.list')}>
          <ul class="list" role="list">
            {tags.map(([name, count], i) => (
              <li>
                <a class="row" href={`/tags/${name}/`}>
                  <span class="lead">
                    <span class="no" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="count">{count} 篇</span>
                  </span>
                  <span class="body">
                    <span class="name">#{name}</span>
                  </span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- 收尾导航（手机档专用，2026-09-13 第八轮）：本页在 ≤640px 一度是**唯一
         断链的页面**——页头 .back（← 返回博客）在本轮被隐藏，而同一目的地的那枚
         「博客」chip 又已在更早因"与返回链重复"删除：两条决策各自合理，叠加后
         手机档就没有通往 /blog/ 的站内路径了（只剩 站名 → 首页 → 03 卡 三跳）。
         这里把那一环补回来。桌面档不显示（页头 .head 是 sticky，返回链全程可见），
         两条入口严格互斥——与文章页 .postback 同一套机制与命名。 -->
    <a class="postback" href="/blog/">{t('head.backBlog')}</a>

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<style>
  /* 版式已抽到 src/styles/tags-index.css（i18n 时为英文版共享）。
     本页如需页面专有样式，写在这里。 */
</style>
