---
// 单标签文章列表页（2026-09-12）：/tags/<tag>/ —— 复用 PostCard 行式条目。
// 文章按发布时间倒序，编号 01 起每页独立；空标签不生成页面（无文章即无路由）。
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/utils';
import PageHead from '../../components/PageHead.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts } from '../../data/posts';
import '../../styles/sheet.css';
import '../../styles/archive-chrome.css';
import '../../styles/tag-detail.css';

export async function getStaticPaths() {
  const posts = await getSortedPosts();

  const byTag = new Map<string, typeof posts>();
  for (const p of posts) {
    for (const t of p.data.tags) {
      if (!byTag.has(t)) byTag.set(t, []);
      byTag.get(t).push(p);
    }
  }

  return [...byTag.entries()].map(([tag, tagPosts]) => ({
    params: { tag },
    props: { tag, posts: tagPosts },
  }));
}

const { tag, posts } = Astro.props;
const t = useTranslations('zh');

---

<Base title={`#${tag} · Daidai档案馆`} description={`标签「${tag}」下的全部文章`}>
  <main class="sheet" id="main">
    <PageHead
      no="NO.03"
      chips={[
        { label: `${posts.length} 篇`, variant: 'red' },
        { label: '全部分类', href: '/categories/' },
        { label: '全部标签', href: '/tags/' },
        { label: '博客', href: '/blog/' },
      ]}
      back={{ label: t('head.backTags'), href: '/tags/' }}
    />

    <section class="hero">
      <p class="en" aria-hidden="true">TAG</p>
      <h1>#{tag}</h1>
    </section>

    <section class="list-section" aria-label={`标签 ${tag} 的文章列表`}>
      <ul class="list" role="list">
        {posts.map((p) => (
          <li>
            <PostCard post={p} />
          </li>
        ))}
      </ul>
    </section>

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<style>
  /* 版式已抽到 src/styles/tag-detail.css（i18n 时为英文版共享）。
     本页如需页面专有样式，写在这里。 */
</style>
