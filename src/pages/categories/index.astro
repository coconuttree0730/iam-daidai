---
/*
  分类索引页（2026-09-14 建）：/categories/ —— 领域分类 + 文章计数。
  ────────────────────────────────────────────────────────────────────────
  与 /tags/ 的关键差异（刻意的，两者不是同一件事）：

  · **排序 = 清单顺序，不是文章数**。标签页按「多少篇」降序排（标签是热度的
    自然表达）；分类页按 CATEGORIES 数组顺序（分类是目录，不该因为某类文章
    多了就往上跳）。
  · **登记了但暂无文章的分类照样列出**（0 篇）。这是「骨架先立、内容后填」的
    落点——分类是承诺，空目录也要可见，否则读者不知道这个站有哪几个方向。
  · **未登记的分类（frontmatter 写了但不在清单里）排在末尾**，不报错但在页面上
    可见。比硬 enum 断路更宽容，也比静默吞掉更容易发现。

  版式复用 tags-index.css（行式档案风与标签页逐像素同构——它们本来就是
  「同一张目录的两种切法」，视觉应该一致）。页头插画沿用文件柜那张。
*/
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getSortedPosts } from '../../data/posts';
import { CATEGORIES, categoryOrder, findCategory } from '../../data/categories';
import '../../styles/sheet.css';
import '../../styles/archive-chrome.css';
import '../../styles/tags-index.css';

const posts = await getSortedPosts();

/* 按 category 计数（只统计已发布文章；draft 在生产构建已被 getSortedPosts 过滤） */
const counts = new Map<string, number>();
for (const p of posts) {
  const c = p.data.category;
  if (!c) continue;
  counts.set(c, (counts.get(c) ?? 0) + 1);
}

/* 清单里登记的分类（含 0 篇）+ 未登记但实际出现的分类，合并且按清单序排 */
const registered = CATEGORIES.map((c) => ({
  name: c.name,
  en: c.en,
  desc: c.desc,
  count: counts.get(c.name) ?? 0,
}));
const unregistered = [...counts.keys()]
  .filter((name) => !findCategory(name))
  .sort((a, b) => a.localeCompare(b))
  .map((name) => ({
    name,
    en: '',
    desc: '未登记分类 · 请在 src/data/categories.ts 补充说明',
    count: counts.get(name) ?? 0,
  }));

const rows = [...registered, ...unregistered].sort(
  (a, b) => categoryOrder(a.name) - categoryOrder(b.name) ||
    a.name.localeCompare(b.name),
);

const totalCategorized = [...counts.values()].reduce((a, b) => a + b, 0);
---

<Base title="分类索引 · Daidai档案馆" description="博客板块 · 按领域归档">
  <main class="sheet" id="main">
    <PageHead
      no="NO.03"
      chips={[
        { label: '索引', variant: 'red' },
        { label: '全部标签', href: '/tags/' },
      ]}
      back={{ label: '← 返回博客', href: '/blog/' }}
    />

    <section class="hero">
      <img
        class="hero__art"
        src="/motion/tags-cabinet-chibi.webp"
        alt=""
        width="723"
        height="680"
        loading="eager"
        decoding="async"
      />
      <div class="hero__text">
        <p class="en" aria-hidden="true">CATEGORIES</p>
        <h1>分类索引</h1>
      </div>
    </section>

    {
      rows.length === 0 ? (
        <section class="stamp" aria-label="暂无分类">
          <strong>暂无分类</strong>
          <small>NO CATEGORIES · 建站方向确定后在此登记</small>
        </section>
      ) : (
        <section class="list-section" aria-label="分类列表">
          <ul class="list" role="list">
            {rows.map((c, i) => (
              <li>
                <a class="row" href={`/categories/${c.name}/`}>
                  <span class="lead">
                    <span class="no" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="count">{c.count} 篇</span>
                  </span>
                  <span class="body">
                    <span class="name">{c.name}</span>
                    {c.desc && <span class="desc">{c.desc}</span>}
                  </span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="lede">
            已归类 {totalCategorized} / {posts.length} 篇 ·
            分类是「领域」，标签是「关键词」——两套并行的检索入口
          </p>
        </section>
      )
    }

    <!-- 收尾导航（手机档专用）：与 /tags/ 同一机制。页头 .back 在 ≤640px 隐藏，
         这里补回通往 /blog/ 的站内路径。桌面档页头 sticky、返回链全程可见，
         两条入口严格互斥。 -->
    <a class="postback" href="/blog/">← 返回博客</a>

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<style>
  /* 版式复用 src/styles/tags-index.css。这里只补分类页特有的两处：
     .desc（分类说明）与 .lede（底部统计行）——不往共享表里塞，
     它们只有分类页用，进共享表等于给标签页增加无用规则。 */
  .body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .desc {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--c-muted);
  }
  .lede {
    margin: 18px 2px 0;
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.7;
    color: var(--c-muted);
  }
</style>
