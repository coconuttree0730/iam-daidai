---
// 博客列表页（2026-09-12 建）：档案风骨架沿用占位版（NO.03 编号头 + NOTES 描边大字 + 页脚条码）。
// 内容管线参照 Astro-theme-Cactus-zh_CN 的 PostPreview 模式（行式条目、构建期渲染、零客户端 JS）。
// 2026-09-12 定稿样式 A（档案风 + 两处微调：描述 <q> 斜体引号、日期用 Cactus 字型），
// 已按预约定移除样式 B 区块与对比标注。
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getAllPosts, collectionDateSort } from '../data/posts';

const posts = (await getAllPosts()).sort(collectionDateSort);
---
<Base title="Daidai档案馆" description="博客板块 · 文章归档">
  <main class="sheet">
    <header class="head">
      <span class="tag">NO.03</span>
      <span class="tag tag--red">密级 公开</span>
      <a class="back" href="/">← 返回档案馆</a>
    </header>

    <section class:list={['hero', { 'hero--compact': posts.length > 0 }]}>
      <p class="en" aria-hidden="true">NOTES</p>
      <h1>博客</h1>
    </section>

    {
      posts.length === 0 ? (
        <section class="stamp" aria-label="档案整理中">
          <strong>档案整理中</strong>
          <small>ARCHIVING · 该板块即将开放</small>
        </section>
      ) : (
        <section class="list-section" aria-label="文章列表">
          <ul class="list list--archive" role="list">
            {posts.map((p, i) => (
              <li>
                <PostCard post={p} no={String(i + 1).padStart(2, '0')} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<style>
  .sheet {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #eeedeb;
    color: #131211;
    font-family: "Noto Sans CJK SC", "Source Han Sans SC", "PingFang SC",
      "Microsoft YaHei", sans-serif;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 22px clamp(20px, 4vw, 48px);
    border-bottom: 1px solid rgba(19, 18, 17, 0.16);
  }
  .tag {
    font-family: "Archivo Black", "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border: 1px solid #131211;
    border-radius: 4px;
  }
  .tag--red {
    border-color: #cf0a1a;
    color: #cf0a1a;
  }
  .back {
    margin-left: auto;
    font-size: 13px;
    color: #131211;
    text-decoration: none;
    border-bottom: 1px solid rgba(19, 18, 17, 0.4);
    padding-bottom: 2px;
  }
  .back:hover { color: #cf0a1a; border-color: #cf0a1a; }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 48px 20px;
    text-align: center;
  }
  /* 有文章时收窄 hero 占比，让列表成为主体 */
  .hero--compact {
    flex: 0 0 auto;
    padding: 42px 20px 12px;
  }
  .hero .en {
    margin: 0;
    font-family: "Anton", Impact, sans-serif;
    font-size: clamp(28px, 6vw, 72px);
    line-height: 1;
    letter-spacing: 0.04em;
    color: transparent;
    -webkit-text-stroke: 1.2px #c3c1be;
    user-select: none;
  }
  .hero h1 {
    margin: 0;
    font-weight: 900;
    font-size: clamp(34px, 7vw, 84px);
    line-height: 1;
    letter-spacing: 0.02em;
  }

  /* ── 文章列表区 ── */
  .list-section {
    flex: 1;
    padding: 26px clamp(20px, 4vw, 48px) 6px;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list--archive {
    border-bottom: 1px solid rgba(19, 18, 17, 0.16);
  }

  .stamp {
    align-self: center;
    margin-bottom: 40px;
    padding: 14px 26px;
    border: 2px solid #cf0a1a;
    border-radius: 6px;
    color: #cf0a1a;
    text-align: center;
    transform: rotate(-2.5deg);
  }
  .stamp strong {
    display: block;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.22em;
  }
  .stamp small {
    display: block;
    margin-top: 6px;
    font-size: 11px;
    letter-spacing: 0.14em;
  }

  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 clamp(20px, 4vw, 48px) 26px;
  }
  .foot .dash {
    width: 34px;
    height: 5px;
    background: #cf0a1a;
  }
  .foot .barcode {
    height: 14px;
    width: 64px;
    background-image: repeating-linear-gradient(
      90deg,
      #131211 0 1px,
      transparent 1px 2.4px,
      #131211 2.4px 4.4px,
      transparent 4.4px 5.4px,
      #131211 5.4px 6.4px,
      transparent 6.4px 8.4px
    );
  }
</style>
