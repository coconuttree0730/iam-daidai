---
// 游乐园板块（/lab/）：2026-09-13 第八轮从「档案整理中」占位页改建为**条目卡片墙**；
// 2026-09-15 用户四度裁定板块导航名：「实验室」→「游乐场」→「工坊」→「游乐园」
// （en 同步 Lab→Playground→Workshop→Playground）。同日晚追加裁定：实验 tab 页的
// hero h1 与页面 <title> 用「实验室」（section.lab.title，en=Lab），与导航名
// （nav.lab=游乐园/Playground）**刻意分离**。
// 显示名与路由解耦——URL /lab/、`src/pages/lab/` 目录、条目编号 LAB-0x 全程不动，
// 改名只动文案层（i18n 字典 + profile.json 四卡 + hero 描边大字）。
//
// 定位：把做过的东西拆开讲——每个条目都带可交互的原始演示，卡片是它的封面与
// 内容提要。条目数据在 src/data/lab.json（构建时静态 import，运行时零 fetch），
// 加一个新实验/教材只需往 entries 追加对象，本文件不用动。
//
// 弹性布局：网格用 auto-fit + minmax(min(100%, 320px), 1fr)，窄屏自然退化为
// 单列；卡片本体是 flex-wrap，封面与文字各有 flex-basis，容器一窄就自动堆叠
// ——不需要为「单列 / 双列 / 并排」分别写断点。
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/utils';
import PageHead from '../components/PageHead.astro';
import LabTabs from '../components/LabTabs.astro';
import lab from '../data/lab.json';
import '../styles/sheet.css';
import '../styles/archive-chrome.css';
import '../styles/lab-news.css';

const entries = lab.entries;
const pad2 = (n: number) => String(n).padStart(2, '0');
const t = useTranslations('zh');

---
<Base
  title={`${t('section.lab.title')} · ${t('site.title')}`}
  description={t('section.lab.desc')}
>
  <main class="sheet" id="main">
    <PageHead no="NO.04" back={{ label: t('head.backHome'), href: '/' }} />

    <LabTabs locale="zh" active="experiments" />

    {/* 2026-09-15 晚 daidai 裁定：hero 大标题整块删除（描边 PLAYGROUND + h1 +
        副标题）——tab 条下直接进卡片墙，页面更紧凑，也顺应移动端横滑改造。
        板块名仍在 <title>（section.lab.title=实验室）与导航（游乐园）里。
        ⛔ 不要"为了对称"把 hero 加回来。 */}

    <section class="entries" aria-label={t('lab.heroTitle')}>
      <header class="sec-head">
        <h2 class="sec-title">{t('lab.heroTitle')}</h2>
        <span class="sec-count">{t('lab.building')} · {pad2(entries.length)}</span>
      </header>

      <ul class="grid" role="list">
        {
          entries.map((e) => (
            <li>
              {/* 整张卡片是一个链接：不嵌套可交互元素，读屏只报一个链接，
                  accessible name 由 aria-label 收短（否则会把提要正文全念一遍）。 */}
              <a class="card" href={e.href} aria-label={`${e.no} · ${e.title}（${e.kind}）`}>
                <span class="card__media">
                  <img
                    src={e.poster}
                    alt=""
                    width={e.posterW}
                    height={e.posterH}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card__no" aria-hidden="true">{e.no}</span>
                </span>

                <span class="card__body">
                  <span class="card__kind">{e.kind}</span>
                  <h2 class="card__title">{e.title}</h2>
                  <span class="card__en" aria-hidden="true">{e.en}</span>
                  <p class="card__desc">{e.desc}</p>
                  <span class="card__meta">
                    {e.meta.map((m) => (
                      <span class="card__chip">{m}</span>
                    ))}
                  </span>
                  <span class="card__cta">
                    {e.cta}
                    <span class="card__go" aria-hidden="true">
                      →
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="stamp" aria-label={t('lab.building')}>
      <strong>{t('lab.building')}</strong>
      <small>{t('lab.buildingNote')}</small>
    </section>

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<style>
  /* ── 页头横幅已删除（2026-09-15 晚 daidai 裁定，见模板内注释）────────────
     原 .hero / .hero .en（描边大字）/ .hero h1 / .hero__note 四条规则随之移除；
     tab 条（.lab-tabs，公共样式在 lab-news.css）的 margin-bottom 承担它与
     本内容区的间距。 */

  /* ── 条目区 ──────────────────────────────────────────────────────────
     flex:1 把页脚推到视口底（.sheet 是 column flex，min-height 100vh）。 */
  .entries {
    flex: 1;
    padding: 0 clamp(20px, 4vw, 48px);
  }
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    /* 内容列上限 960px（居中）：auto-fit 会把空轨道折叠掉，只有一条目时那张
       卡片会撑满整个视口——1440px 屏上封面宽约 620px，比首页 hero 的人物
       （--stage-width 386px）还大，喧宾夺主。这条上限同时约束下面的网格，
       保证卡片比例稳定。/lab/scroll/ 的 .outro 用 1080px 居中，同一套做法。 */
    width: 100%;
    max-width: 960px;
    margin-inline: auto;
    padding-bottom: 10px;
    margin-bottom: clamp(16px, 2.2vw, 24px);
    border-bottom: 1px solid rgba(var(--c-ink-rgb), 0.16);
  }
  .sec-title {
    margin: 0;
    font-family: 'Archivo Black', 'Helvetica Neue', Arial, sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
  }
  .sec-count {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }

  /* auto-fit（而非 auto-fill）：空轨道会被折叠，所以只有一条目时那张卡片
     会撑满整行——加第二条起自动变双列，不需要改任何规则。
     min(100%, 320px) 保证极窄视口下 minmax 的上界不超过容器宽（不横向溢出）。 */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(16px, 2.4vw, 26px);
    /* 与 .sec-head 同一条内容轴（上限见上）。margin-inline:auto 写在 margin:0
       之后——长手属性后置才生效，否则会被 margin:0 抹掉。 */
    max-width: 960px;
    margin: 0;
    margin-inline: auto;
    padding: 0;
    list-style: none;
  }

  /* ── 卡片 ────────────────────────────────────────────────────────────
     flex-wrap + 两侧 flex-basis：容器够宽就封面与文字并排，一窄就自动堆叠，
     不用写断点。align-items:center 让文字块在封面较高时垂直居中。 */
  .card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(14px, 2vw, 26px);
    padding: clamp(12px, 1.6vw, 20px);
    border: 1px solid rgba(var(--c-ink-rgb), 0.16);
    border-radius: 6px;
    background: var(--c-card);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.18s ease;
  }
  .card:hover {
    border-color: var(--c-red);
  }
  .card:focus-visible {
    outline: 2px solid var(--c-red);
    outline-offset: 2px;
  }
  .card:hover .card__title {
    text-decoration: underline;
    text-decoration-color: var(--c-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .card:hover .card__cta {
    color: var(--c-red);
  }
  .card:hover .card__go {
    transform: translateX(4px);
  }

  .card__media {
    position: relative;
    flex: 1 1 300px;
    min-width: 0;
    /* 主题不变量纸底（--c-band）：封面是 RVM 抠出的透明人物（深发深衣），
       深色主题下若跟着翻成深底会糊成一团剪影。与 /tags/ 页头纸带同一裁定：
       这条纸带两种主题都保住浅纸底，不消费会翻转的 --c-ink/--c-ghost。 */
    background: var(--c-band);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    overflow: hidden;
  }
  .card__media img {
    display: block;
    /* 不设 height：由 width/height 属性给出的固有比例决定高度——无裁切、
       无信箱边，且因为属性齐备不会产生布局位移。 */
    width: 100%;
    height: auto;
  }
  .card__no {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 3px 8px;
    border: 1px solid var(--c-red);
    border-radius: 3px;
    background: var(--c-band);
    font-family: 'Archivo Black', 'Helvetica Neue', Arial, sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--c-red);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    flex: 1 1 340px;
    min-width: 0;
  }
  .card__kind {
    padding: 3px 8px;
    border: 1px solid var(--c-red);
    border-radius: 3px;
    font-family: 'Archivo Black', 'Helvetica Neue', Arial, sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--c-red);
  }
  .card__title {
    margin: 0;
    font-size: clamp(21px, 2.4vw, 28px);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }
  .card__en {
    font-family: 'Anton', Impact, sans-serif;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: transparent;
    -webkit-text-stroke: 0.8px var(--c-ghost);
    user-select: none;
  }
  .card__desc {
    margin: 2px 0 0;
    /* 用 em 而非 ch：ch 以「0」字宽为准（约 0.5em），对中文会把行宽压到
       二十来字一行，读起来很碎。34em ≈ 34 个中文字，接近正文的舒适行宽。 */
    max-width: 34em;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--c-ink-2);
  }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }
  .card__chip {
    padding: 3px 8px;
    border: 1px solid rgba(var(--c-ink-rgb), 0.18);
    border-radius: 3px;
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }
  .card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--c-ink);
    transition: color 0.18s ease;
  }
  .card__go {
    transition: transform 0.18s ease;
  }

  .stamp {
    align-self: center;
    margin: clamp(28px, 4vw, 44px) auto 40px;
    padding: 14px 26px;
    border: 2px solid var(--c-red);
    border-radius: 6px;
    color: var(--c-red);
    text-align: center;
    transform: rotate(-2.5deg);
  }
  .stamp strong {
    display: block;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.22em;
  }
  .stamp small {
    display: block;
    margin-top: 6px;
    font-size: 11px;
    letter-spacing: 0.14em;
  }

  /* 手机档：内缩收到 20px，卡片内距与间距收紧；卡片内部封面与文字各占整行
     （flex:1 1 100%），保证封面在上、提要在下的阅读顺序。 */
  @media (max-width: 640px) {
    .entries {
      padding: 0 20px;
    }
    .card {
      gap: 14px;
      padding: 12px;
    }
    .card__media,
    .card__body {
      flex: 1 1 100%;
    }
    .card__desc {
      font-size: 14px;
    }

    /* ── 卡片墙 → 横向滑轨（2026-09-15 daidai 裁定）─────────────────────
       纵向单列在条目变多后把页面拉得过长，手机档改为单行横滑 + scroll-snap；
       桌面（>640px）不受影响，仍是 auto-fit 网格。
       margin-inline:-20px 突破 .entries 的内缩做全宽滑轨：首卡左缘仍对齐正文
       20px 线（padding-inline 承担），右侧下一张卡自然 peek 到视口边缘；
       scroll-padding-inline 与 padding 同值，snap 落点 = 视口 20px 线。 */
    .grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 20px;
      gap: 14px;
      margin-inline: -20px;
      padding: 4px 20px 12px;
      /* 焦点 outline 会画进 padding 区，这里已留缓冲；滚动条藏掉——
         键盘 focus 会自动 scrollIntoView，触屏本身无滚动条。 */
      scrollbar-width: none;
    }
    .grid::-webkit-scrollbar {
      display: none;
    }
    .grid > li {
      flex: 0 0 min(82%, 340px);
      scroll-snap-align: start;
    }
    /* 等高：滑轨把 li 拉成一排等高，卡片填满各自 li 才不会高矮不齐。 */
    .grid > li .card {
      height: 100%;
    }
    /* 封面统一高度：四张 poster 比例不一（600×448 横 / 480×575 竖），纵滑时代
       高度随比例走，横滑等高排里会高矮不齐。contain 不裁内容，透明区透出
       .card__media 的 --c-band 纸底，呈相册留白感。 */
    .card__media img {
      height: 250px;
      object-fit: contain;
    }
  }
</style>
