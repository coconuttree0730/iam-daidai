---
// 404 档案页（2026-09-12）：拼错地址时的全站兜底。
// 档案馆风「查无此档」印章空态 + 双返回入口（首页 / 博客）；
// noindex 挡索引，防软 404 被收录。Cloudflare Pages 按约定文件名自动挂接。
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/utils';
import PageHead from '../components/PageHead.astro';
import '../styles/sheet.css';
import '../styles/archive-chrome.css';
import '../styles/notfound.css';
const t = useTranslations('zh');

---

<Base title="查无此档 · Daidai档案馆" description="请求的档案不存在" noindex>
  <main class="sheet" id="main">
    <PageHead
      no="NO.404"
      chips={[
        { label: '查无此档', variant: 'red' },
        { label: '首页', href: '/' },
        { label: '博客', href: '/blog/' },
      ]}
      back={{ label: t('head.backHome'), href: '/' }}
    />

    <section class="hero">
      <p class="en" aria-hidden="true">404</p>
      <h1>这份档案不在馆内</h1>
      <p class="hint">地址可能已归档迁移，或从未登记过。</p>
    </section>

    <section class="stamp" aria-label="查无此档">
      <strong>查无此档</strong>
      <small>NOT FOUND · 404</small>
    </section>

    <nav class="exits" aria-label="返回入口">
      <a class="exit" href="/">← 回首页</a>
      <a class="exit" href="/blog/">去博客 →</a>
    </nav>

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<style>
  /* 版式已抽到 src/styles/notfound.css（i18n 时为英文版共享）。
     本页如需页面专有样式，写在这里。 */
</style>
