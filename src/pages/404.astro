---
// 404 档案页（2026-09-12）：拼错地址时的全站兜底。
// 档案馆风「查无此档」印章空态 + 双返回入口（首页 / 博客）；
// noindex 挡索引，防软 404 被收录。Cloudflare Pages 按约定文件名自动挂接。
import Base from '../layouts/Base.astro';
---

<Base title="查无此档 · Daidai档案馆" description="请求的档案不存在" noindex>
  <main class="sheet">
    <header class="head">
      <span class="tag">NO.404</span>
      <span class="tag tag--red">查无此档</span>
      <a class="tag tag--link" href="/">首页</a>
      <a class="tag tag--link" href="/blog/">博客</a>
      <a class="back" href="/">← 返回档案馆</a>
    </header>

    <section class="hero">
      <p class="en" aria-hidden="true">404</p>
      <h1>这份档案不在馆内</h1>
      <p class="hint">地址可能已归档迁移，或从未登记过。</p>
    </section>

    <section class="stamp" aria-label="查无此档">
      <strong>查无此档</strong>
      <small>NOT FOUND · 404</small>
    </section>

    <nav class="exits" aria-label="返回入口">
      <a class="exit" href="/">← 回首页</a>
      <a class="exit" href="/blog/">去博客 →</a>
    </nav>

    <footer class="foot" aria-hidden="true">
      <span class="dash"></span>
      <span class="barcode"></span>
    </footer>
  </main>
</Base>

<style>
  .sheet {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--c-paper);
    color: var(--c-ink);
    font-family: 'Noto Sans CJK SC', 'Source Han Sans SC', 'PingFang SC',
      'Microsoft YaHei', sans-serif;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 22px clamp(20px, 4vw, 48px);
    border-bottom: 1px solid rgba(var(--c-ink-rgb), 0.16);
  }
  .tag {
    font-family: 'Archivo Black', 'Helvetica Neue', Arial, sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border: 1px solid var(--c-ink);
    border-radius: 4px;
  }
  .tag--red {
    border-color: var(--c-red);
    color: var(--c-red);
  }
  .tag--link {
    color: var(--c-muted);
    border-color: rgba(var(--c-ink-rgb), 0.3);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .tag--link:hover {
    color: var(--c-red);
    border-color: var(--c-red);
  }
  .back {
    margin-left: auto;
    font-size: 13px;
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--c-ink-rgb), 0.4);
    padding-bottom: 2px;
  }
  .back:hover {
    color: var(--c-red);
    border-color: var(--c-red);
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 56px 20px 10px;
    text-align: center;
  }
  .hero .en {
    margin: 0;
    font-family: 'Anton', Impact, sans-serif;
    font-size: clamp(72px, 18vw, 200px);
    line-height: 1;
    letter-spacing: 0.04em;
    color: transparent;
    -webkit-text-stroke: 1.6px var(--c-ghost);
    user-select: none;
  }
  .hero h1 {
    margin: 0;
    font-weight: 900;
    font-size: clamp(22px, 4.5vw, 40px);
    line-height: 1.2;
  }
  .hero .hint {
    margin: 0;
    font-size: 13.5px;
    color: var(--c-muted);
  }

  .stamp {
    align-self: center;
    margin: 22px 0 6px;
    padding: 14px 30px;
    border: 2px solid var(--c-red);
    border-radius: 6px;
    color: var(--c-red);
    text-align: center;
    transform: rotate(-2.5deg);
  }
  .stamp strong {
    display: block;
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 0.22em;
  }
  .stamp small {
    display: block;
    margin-top: 6px;
    font-size: 11px;
    letter-spacing: 0.14em;
  }

  .exits {
    display: flex;
    justify-content: center;
    gap: 16px;
    padding: 26px 20px 60px;
  }
  .exit {
    padding: 10px 22px;
    border: 1.5px solid var(--c-ink);
    border-radius: 6px;
    font-weight: 800;
    font-size: 14px;
    color: var(--c-ink);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .exit:hover {
    color: var(--c-red);
    border-color: var(--c-red);
  }

  .foot {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 clamp(20px, 4vw, 48px) 26px;
  }
  .foot .dash {
    width: 34px;
    height: 5px;
    background: var(--c-red);
  }
  .foot .barcode {
    height: 14px;
    width: 64px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--c-ink) 0 1px,
      transparent 1px 2.4px,
      var(--c-ink) 2.4px 4.4px,
      transparent 4.4px 5.4px,
      var(--c-ink) 5.4px 6.4px,
      transparent 6.4px 8.4px
    );
  }
</style>
